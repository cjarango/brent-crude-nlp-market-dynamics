  pages={1-6},
  abstract={The daily price in the energy market reflects the point at which supply and demand meet; however, this point is subject to significant variations due to the high volatility of both demand and supply. Therefore, the objective of this paper is to analyze, from a bibliometric perspective, how artificial intelligence can assist in forecasting energy demand.},
  keywords={Supply and demand;Bibliometrics;Production;Medical services;Predictive models;Market research;Artificial intelligence;Forecasting;Sustainable development;Optimization;Energy;Artificial Intelligence;Deep Learning;Machine Learning;Neural Network;Energy Consumption;Energy Demand;Energy Production},
