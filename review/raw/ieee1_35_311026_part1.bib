  pages={206-218},
  abstract={Gasoline is the lifeblood of the national economy. The forecasting of gasoline prices is difficult because of frequent price fluctuations, its complex nature, diverse influencing factors, and low accuracy of prediction results. Previous studies mainly focus on forecasting gasoline prices in a single region by single time series analysis which ignores the daily price co-movement of different series from multiple regions. Because price co-movement may contain useful information for price forecasting, this paper proposes the Lasso-CNN ensemble model that combines statistical models and deep neural networks to forecast gasoline prices. In this model, the Least Absolute Shrinkage and Selection Operator (Lasso) screens and chooses the correlated time series to enhance the performance of forecasting and avoid overfitting, while Convolutional Neural Network (CNN) takes the selected multiple series as its input and then forecasts the gasoline prices in a certain region. Forecasting results of gasoline prices at the national level and regional levels by using the new method demonstrate that the new approach provides more accurate results for the predictions of gasoline prices than those results generated by alternative methods. Thus, the relevant series can enhance the performance of forecasting and help to gain better results.},
  keywords={Couplings;Social computing;Oils;Time series analysis;Neural networks;Predictive models;Linear programming;gasoline prices;forecasting;Lasso-CNN;multiple time series},
  doi={10.23919/JSC.2022.0012},
  ISSN={2688-5255},
  month={Sep.},}@INPROCEEDINGS{11447134,
  author={Li, Kunjian and Chen, Qichun},
  booktitle={2025 2nd International Seminar on Artificial Intelligence, Computer Technology and Control Engineering (ACTCE)}, 
  title={Ensemble Deep Learning for Small-Sample Time Series Forecasting}, 
  year={2025},
  volume={},
  number={},
  pages={388-394},
  abstract={This paper investigates the efficacy of ensemble deep learning architectures for time series forecasting in small-sample settings, with a focus on regional energy markets. Traditional forecasting methods often falter in scenarios with limited data availability and high volatility, underscoring the need for more robust and adaptive approaches. We propose and benchmark a series of hybrid models across multiple performance metrics. Our empirical analysis, using daily trading records from two regional emissions exchanges as a proxy for energy market behavior, demonstrates that attention-enhanced and residual-learning-based ensembles significantly outperform baseline models in both accuracy and directional reliability. These findings highlight the potential of ensemble architectures to improve prediction robustness in low-data, high-uncertainty forecasting environments.},
  keywords={Deep learning;Adaptation models;Accuracy;Attention mechanisms;Uncertainty;Biological system modeling;Time series analysis;Robustness;Ensemble learning;Forecasting;ensemble learning;time series forecasting;small-sample analysis;deep learning},
  doi={10.1109/ACTCE66599.2025.00079},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11704441,
  author={Chen, Z.-X. and Chien, C.-F.},
  booktitle={2026 IEEE 22nd International Conference on Automation Science and Engineering (CASE)}, 
  title={Two-Phase Rolling Copper Price Forecasting for Min–Max Regret Procurement Decision and An Empirical Study for PCB Smart Production}, 
  year={2026},
  volume={},
  number={},
  pages={986-991},
  abstract={The printed circuit board (PCB) industry is a fundamental pillar of the world economy, supplying essential technologies to numerous industries, such as consumer electronics, artificial intelligence (AI) infrastructure, and automotive. In general, copper-related raw materials account for approximately 30-40% of PCB manufacturing costs. However, the price of copper fluctuates due to demand-supply mismatches as well as international economic and political factors. This study develops a two-phase data-driven decision framework to predict weekly copper prices and support procurement decision-making. In the first phase, a Bi-LSTM-CNN-CBAM model generates the initial weekly price forecast, while a lightweight multilayer perceptron (Light MLP) performs residual correction to enhance forecasting accuracy. In the second phase, forecast residuals are converted into 81 price scenarios, derived from three possible price outcomes across a four-week decision horizon. A Min-Max Regret (MMR) criterion considers each possible price outcome generated from the forecasting scenarios to derive procurement strategies that minimize the maximum regret relative to ex-post optimal decisions. The proposed framework is validated through an empirical study in a world-leading PCB company. This study demonstrates that the two-phase framework provides a robust procurement decision to reduce supply chain risk under price volatility, thereby empowering digital transformation.},
  keywords={Pricing;Forecasting;Procurement;Modeling;Copper;Printing;Timing;Long short term memory;Manufacturing;Uncertainty;Copper price forecasting;Data-driven decision support;Raw material procurement;PCB smart production;Digital transformation},
  doi={10.1109/CASE69030.2026.11704441},
  ISSN={2161-8089},
  month={Aug},}@ARTICLE{10040670,
  author={Nasir, Jawaria and Aamir, Muhammad and Haq, Zahoor Ul and Khan, Shehzad and Amin, Muhammad Yusuf and Naeem, Muhammad},
  journal={IEEE Access}, 
  title={A New Approach for Forecasting Crude Oil Prices Based on Stochastic and Deterministic Influences of LMD Using ARIMA and LSTM Models}, 
  year={2023},
  volume={11},
  number={},
  pages={14322-14339},
  abstract={Crude oil is one of the non-renewable power sources and is the lifeblood of the contemporary industry. Every significant change in the price of crude oil (CO) will have an effect on how the global economy, including COVID-19, develops. This study developed a novel hybrid prediction technique that depends on local mean decomposition, Autoregressive Integrated Moving Average (ARIMA), and Long Short-term Memory (LSTM) models to increase crude oil price prediction accuracy. The original data is decomposed by local mean decomposition (LMD), and the decomposed components are reconstructed into stochastic and deterministic (SD) components by average mutual information to reduce the computation cost and enhance forecasting accuracy, predict each individual reconstructed component by ARIMA, and integrate the residuals with LSTM to capture the nonlinearity in residuals and help to find the final prediction result. The new hybrid model LMD-SD-ARIMA-LSTM has reduced the volatility and solved the issue of the overfitting problem of neural networks. The proposed hybrid technique is validated using publicly accessible data from the West Texas Intermediate (WTI), and forecast accuracy are compared using accuracy measures. The value of Mean Absolute Error (MAE) and Mean Absolute Percentage Error (MAPE) for ARIMA, LSTM, LMD-ARIMA, LMD-SD-ARIMA, LMD-ARIMA-LSTM, LMD-SD-ARIMA-LSTM, and Naïve are 1.00, 1.539, 5.289, 0.873, 0.359, 0.106, 4.014 and 2.165, 1.832, 9.165, 1.359, 1.139, 1.124 and 3.821 respectively. From these results, it is concluded that the proposed model LMD-SD-ARIMA-LSTM has minimum values for MAE and MAPE which assured the superiority of the proposed model in One-step ahead forecasting. Moreover, forecasting performance is also compared up to five steps ahead. The findings demonstrate that the suggested approach is a helpful tool for predicting CO prices both in the short and long term. Furthermore, the current study reduces labor costs by combing the stationary and non-stationary Product Functions (PFs) into stochastic and deterministic components with improved accuracy. Meanwhile, the traditional econometric model can strengthen the prediction behavior of CO prices after decomposition and reconstruction, and the new hybrid forecasting method has better performance in medium and long-term forecasting of the CO price. Moreover, accurate predictions can provide reasonable advice for relevant departments to make correct decisions.},
  keywords={Predictive models;Biological system modeling;Petroleum industry;Forecasting;Data models;Time series analysis;Stochastic processes;Pricing;ARIMA;LMD;LSTM;stochastic and deterministic influences;crude oil prices},
  doi={10.1109/ACCESS.2023.3243232},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11050153,
  author={Zhang, Zhouhe and Hua, Haochen and Chen, Xingying and Shao, Jia and Zheng, Jin and Wang, Bo and Gan, Lei and Yu, Kun},
  booktitle={2025 21st International Conference on the European Energy Market (EEM)}, 
  title={Spot Market Electricity Price Forecast via the Combination of Transformer and Ornstein-Uhlenbeck Process}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Spot market electricity price fluctuations can expose market participants to substantial financial risks if not accurately forecasted. Traditional statistical models (e.g., ARIMA) can capture linear trends but struggle with complex nonlinear relationships, while pure neural network models (e.g., Transformer) are insufficiently sensitive to random fluctuations. To address both persistent price trends and transient volatility, this paper combines Transformer with stochastic differential equations driven by Ornstein-Uhlenbeck process. Compared to ARIMA, the proposed model achieves an average MAE reduction of approximately 45 %, along with comparable improvements in RMSE and MAPE and a significant boost in $\mathbf{R}^{\mathbf{2}}$. Against a standalone Transformer, it also exhibits substantial performance gains across all key metrics.},
  keywords={Fluctuations;Electricity;Stochastic processes;Differential equations;Predictive models;Transformers;Market research;Mathematical models;Numerical models;Forecasting;Transformer;stochastic differential equations;electricity price forecast;spot market},
  doi={10.1109/EEM64765.2025.11050153},
  ISSN={2165-4093},
  month={May},}@INPROCEEDINGS{10408839,
  author={Kraisornnukhor, Pawit and Wongchaisuwat, Papis and Paoprasert, Naraphorn and Mungwattana, Anan},
  booktitle={2023 IEEE 11th Joint International Information Technology and Artificial Intelligence Conference (ITAIC)}, 
  title={Multi-Step Rubber Price Prediction Using Deep Learning Models with External Factors}, 
  year={2023},
  volume={11},
  number={},
  pages={1125-1129},
  abstract={The Thai rubber market plays a vital role in the nation's economy, holding a prominent position as one of the world's leading producers and exporters of natural rubber. It frequently faces challenges, including price volatility, driven by complex global supply and demand dynamics and numerous influencing factors. This study aimed to enhance multi-step price prediction models for ribbed smoked rubber sheets (RSS) through the application of advanced deep learning techniques. Various recurrent neural network architectures were examined, and the impact of incorporating external factors into the analysis was thoroughly assessed. The results demonstrated that multistep gated recurrent units coupled with top principal components of external features based on principal component analysis delivered superior performance, achieving an average RMSE of 3.54 and an average MAPE of 4.46% across 7-step predictions. A precise price estimation for key rubber products, including RSS, could enable informed decision-making for all stakeholders throughout the entire supply chain.},
  keywords={Deep learning;Biological system modeling;Time series analysis;Supply chains;Predictive models;Rubber;Stakeholders;Rubber price prediction;multivariate time series forecasting;recurrent neural networks;multi-step prediction;LSTM;GRU},
  doi={10.1109/ITAIC58329.2023.10408839},
  ISSN={2693-2865},
  month={Dec},}@INPROCEEDINGS{9459082,
  author={Zhang, Chengzhao and Pan, Heping},
  booktitle={2021 4th International Conference on Artificial Intelligence and Big Data (ICAIBD)}, 
  title={Multi Resolution Prediction Model Based on Wavelet Analysis and Neural Network}, 
  year={2021},
  volume={},
  number={},
  pages={299-303},
  abstract={At present, the securities market is mainly composed by the stock market. The accurate prediction of stock price means that investors can get high returns and the government can effectively supervise the market. The future trend of a country's stock market is constantly changing and influenced by many interference factors. The traditional prediction methods can not effectively solve the problem of accurate prediction of such nonlinear systems. The time series data of stock price formation are nonlinear and non-stationary, which are difficult to deal with by traditional models. Wavelet neural network has a good ability to approximate the nonlinear mapping. Therefore, a wavelet neural network prediction model is proposed to deal with non-stationary data. Wavelet transform divides time series into high-frequency and low-frequency sequences. According to the data characteristics of different sequences, a prediction model is established. The experimental results indicate the lower prediction error of the prediction model after comparing it with the improved neural network and GARCH method.},
  keywords={Wavelet transforms;Analytical models;Neural networks;Time series analysis;Predictive models;Wavelet analysis;Market research;stock market;supervise;wavelet neural network;prediction method},
  doi={10.1109/ICAIBD51990.2021.9459082},
  ISSN={},
  month={May},}@INPROCEEDINGS{11407766,
  author={Shameera, M. P. M. A. and Kesavan, S. and Arachchi, S. P. Kasthuri},
  booktitle={2025 International Conference on Advances in Technology and Computing (ICATC)}, 
  title={Integrating Sentiment Analysis & Historical Data for Predicting Crude Oil Prices}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Crude oil price forecasting remains a persistent challenge due to the volatility introduced by fast-moving geopolitical events and macroeconomic shocks. Currently available models mostly rely solely on time-series patterns or sentiment analysis. But these approaches do not capture the full complexity of short-term market dynamics. This research addresses this gap. Most times inaccurate forecasts can impact traders, risk managers, and policymakers globally. This study aims to develop a forecasting model that integrates domainspecific news sentiment with traditional market fundamentals to predict the next week’s crude oil price. We compiled a dataset of ~60,000 English oil-related news articles, cleaned and timestamped them, and derived weekly sentiment features using VADER, FinBERT, and a domain-adapted CrudeBERT. These were combined with market variables including production, inventories, imports/exports, benchmark WTI prices, the Weekly Economic Index, and Geopolitical Risk Indices. A range of models, including linear regressions, tree-based methods, neural networks, and SARIMAX, were evaluated, alongside an ensemble that fused the best-performing tree-based and neural approaches. Best results were given by the ensemble (Random Forest + XGBoost + LSTM) with CrudeBERT based sentiment, which achieves the best accuracy: MAE ≈ 1.19 USD, RMSE ≈ 1.48 USD, MAPE ≈ 1.57%, and R2 ≈ 0.935. These results substantially outperform models that exclude sentiment or rely on generic sentiment features. The findings shows that combining domain specific news sentiment with economic and market fundamentals significantly enhances short-term crude oil price prediction. The novelty of this work lies in its unified framework that combines large-scale sentiment analysis from news articles with traditional oil market variables and geopolitical risk indices providing new evidence that such integration delivers materially improved forecasting accuracy.},
  keywords={Sentiment analysis;Analytical models;Accuracy;Oils;Biological system modeling;Neural networks;Production;Predictive models;Forecasting;Random forests;crude oil price forecasting;CrudeBERT;ensemble learning;sentiment analysis;time-series modelling},
  doi={10.1109/ICATC68823.2025.11407766},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11491419,
