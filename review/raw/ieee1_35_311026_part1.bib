  booktitle={2023 13th International Conference on Cloud Computing, Data Science & Engineering (Confluence)}, 
  title={Price Prediction of Bitcoin using Social Media Activities and Past Trends}, 
  year={2023},
  volume={},
  number={},
  pages={516-521},
  abstract={The world's most well-known cryptocurrency, Bitcoin, is much attractive to financial market players due to its recent price boom and fall. It is very difficult to anticipate because of the substantial volatility of the Bitcoin conversion scale. Forecasting of its behavior is crucial for the financial industry sectors. Some of the research works have been used machine learning techniques on past trends data of Bitcoin for its price predictions but they lack in accuracy. Therefore, the aim of this paper is to look into the global crypto-currency price movement trends about social media communication data as well as historical data trends. The thought is to analyze informative trends in online groups and social media networks to fully understand and extract useful information which could be used to improve the prediction accuracy of cryptocurrency price fluctuations. In this work we examine the behavior of Artificial Neural Networks (ANN), Recurrent Neural Networks (RNN) with LSTM and GRU, ARIMA model, Random forests(RF), and others for price direction predictions. Similarly, the SVM and ANN are used to predict Bitcoin’s minimum, maximum, and closing prices. The outcomes of the forecasts are also utilized as inputs to improve forecasts of price movement. The results showed that performance was greatly improved by the characteristics that were picked as well as by the effective machine learning and deep learning techniques.},
  keywords={Training;Support vector machines;Recurrent neural networks;Social networking (online);Bitcoin;Artificial neural networks;Forestry;Bitcoin price prediction;Random Forest;RNN;LSTM;ARIMA},
  doi={10.1109/Confluence56041.2023.10048799},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{8769586,
  author={Siddiqui, Atiq W.},
  booktitle={2019 2nd International Conference on Computer Applications & Information Security (ICCAIS)}, 
  title={Predicting Natural Gas Spot Prices Using Artificial Neural Network}, 
  year={2019},
  volume={},
  number={},
  pages={1-6},
  abstract={Natural gas is a major global energy commodity. Gas prices around the world face substantial volatility, inducing major downside market risks. Forecasting accuracy is thus a major concern for the consumers. Traditional econometrics models do not perform well due to inherent nonlinear and nonstationary gas price data. We thus propose an Autoregressive Neural Network (ARNN) model for forecasting daily spot gas prices. The model is benchmarked against the traditional Autoregressive Integrated Moving Average (ARIMA) model. Using a cross validation study, the ARNN model showed an improvement of around 33% over ARIMA in terms of mean squared error. This improvement is significant when price forecasts are used in gas purchase decisions.},
  keywords={Biological system modeling;Natural gas;Predictive models;Forecasting;Data models;Adaptation models;Measurement uncertainty;Natural gas;spot prices;forecasting;ARIMA;artifical neural network;nonlinear autoregressive neural network},
  doi={10.1109/CAIS.2019.8769586},
  ISSN={},
  month={May},}@INPROCEEDINGS{11050133,
  author={Stojkić, Ana and Borić, Donata and Marić, Leila Luttenberger and Špišić, Vladimir},
  booktitle={2025 21st International Conference on the European Energy Market (EEM)}, 
  title={The Impact of Meteorological Data Quality on Accurate Forecast of Solar Power Plant Production}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={As we strive to mitigate the impact of global warming, RESs (Renewable Energy Source) have become indispensable in shaping a sustainable future. However, as RESs play an increasingly significant role, power grids are facing greater volatility in maintaining a power system stability. Among the most important renewable energy sources is solar power, whose production is highly contingent upon weather conditions and whose prevalence continues to grow. The forecast accuracy is directly linked to the quality of meteorological data, which must be precisely measured and reflect specific local conditions. Usually, relying on a single data source alongside with different data analysis approaches and feature selection methods can yield varying forecast outputs. This research aims to conduct a comparative analysis of how meteorological data from various sources, combined with models ranging from simple linear regression to advanced deep learning neural networks, can influence the accuracy of forecasts, ultimately enhancing the reliability of solar power production.},
  keywords={Renewable energy sources;Accuracy;Soft sensors;Weather forecasting;Production;Predictive models;Data models;Reliability;Forecasting;Power generation;data sources;forecasting accuracy;power grid;solar power},
  doi={10.1109/EEM64765.2025.11050133},
  ISSN={2165-4093},
  month={May},}@INPROCEEDINGS{11165808,
  author={Joshi, Pooja and Bhardwaj, Jyotirmoy and Størdal, Ståle and Kolhe, Mohan and Haugom, Erik},
  booktitle={2025 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)}, 
  title={Analysis of Feature Engineering in Deep Learning Architectures for Dynamic Electricity Price Forecasting}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Forecasting is critical for the electricity market and is particularly challenging with the introduction of Intermittent Energy Sources (IES), such as solar or wind. Due to the inherent volatility of IES, electricity price forecasting (EPF) models often fail to deliver the expected performance. Notably, Deep Neural Networks (DNN), assisted with feature engineering, demonstrated good forecasting performance in deregulated electricity markets for the EPF application domain, even in highly volatile scenarios. In this work, we demonstrate the impact of diverse data transformation approaches for a DNN-based EPF, which is crucial for explainable artificial intelligence (xAI). Results indicate that feature engineering through data transformations and normalization enhances the performance and explainability of EPF. Performance evaluation via error metrics shows the efficacy of the proposed approach for Nordpool.},
  keywords={Performance evaluation;Analytical models;Electricity;Artificial neural networks;Computer architecture;Predictive models;Electricity supply industry;Data models;Forecasting;Artificial intelligence;Electricity price forecasting;energy markets;explainable artificial intelligence;deep neural networks;forecast assessment},
  doi={10.1109/ACDSA65407.2025.11165808},
  ISSN={},
  month={Aug},}@ARTICLE{10494511,
  author={Mardjo, Anny and Choksuchat, Chidchanok},
  journal={IEEE Access}, 
  title={HyBiLSTM: Multivariate Bitcoin Price Forecasting Using Hybrid Time-Series Models With Bidirectional LSTM}, 
  year={2024},
  volume={12},
  number={},
  pages={50792-50808},
  abstract={Despite their growing popularity in recent research, most hybrid models that harness the strengths of both classical time-series analysis and deep learning models have been explored within the univariate forecasting context. In the econometric domain, where exogenous factors play a crucial role; there is a pressing need for more studies focusing on multivariate forecasting. This paper introduces a novel hybrid model, HyBiLSTM. It integrates an ARIMAX GARCHX model for initial forecasting, followed by a second forecasting phase that addresses the residuals using a bidirectional long short-term memory model optimized through grey wolf optimization algorithm. The final forecast is a composite derived from both models. Three quantitative metrics (mean absolute error, root mean square error, and mean absolute percentage error) assessed the model performance using data that spanned social and economic variables from July 1, 2019, to December 31, 2022. The results revealed several key findings: 1) The addition of exogenous factors improved the performance of the ARIMA and GARCH models. 2) The BiLSTM variant outperformed other LSTM variants when combined with the ARIMAX GARCHX model. 3) An analysis using Shapley additive explanations indicated that bitcoin price was influenced by stock prices, Twitter volume, gold prices, and the Twitter sentiment index. 4) The presence of a structural break had a significant effect on the model’s forecasting accuracy. Beyond expanding the academic literature on hybrid models within a multivariate context, this offers valuable practical insights for investors. Specifically, it analyzes various factors that could serve as early indicators of bitcoin price fluctuations.},
  keywords={Biological system modeling;Predictive models;Long short term memory;Forecasting;Bitcoin;Data models;Time series analysis;LSTM;ARIMAX;GARCHX;bitcoin;SHAP;bidirectional LSTM},
  doi={10.1109/ACCESS.2024.3386029},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10543621,
  author={Rathinavel, Keshav and K, Indira Kumar A and Sahoo, Anshuman and Singh, Rimjhim Padam and Kanchan, Sneha},
  booktitle={2024 IEEE 9th International Conference for Convergence in Technology (I2CT)}, 
  title={Geopolitical Risk Analysis and its Impact on Market Volatility}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This study addresses the influence of geopolitical risks on financial markets, as noticed in recent events like the COVID-19 pandemic and the Russia-Ukraine war. This study showcases a model combining financial indices with the Geopolitical Risk Index (GPRI), employing Bi-LSTM networks with attention mechanisms to analyze the data. This approach captures the nuanced effects of geopolitical events on market volatility. Focused on the pandemic period, our model offers insights into market dynamics during times of geopolitical unrest and serves as a predictive tool for market behavior in response to global events.},
  keywords={COVID-19;Analytical models;Pandemics;Predictive models;Data models;Risk analysis;Indexes;GPR Index;Volatility Spillover},
  doi={10.1109/I2CT61223.2024.10543621},
  ISSN={},
  month={April},}@INPROCEEDINGS{11020201,
  author={Liu, SiXing and Lan, QuanXiang},
  booktitle={2025 8th International Conference on Advanced Algorithms and Control Engineering (ICAACE)}, 
  title={Long-Term Gold Price Prediction Using the CNN-BiGRU Model Enhanced with an Attention Mechanism}, 
  year={2025},
  volume={},
  number={},
  pages={1369-1375},
  abstract={Gold has been regarded as a precious metal by humankind since ancient times, and its unique physical and chemical properties have made it important in several fields, including industry, finance, and jewelry manufacturing. As a safe-haven asset, fluctuations in the price of gold directly impact the risk and return of investment portfolios, underscoring the significance of accurate forecasting for investors, policymakers, and financial institutions. Conventional time series forecasting methodologies are inadequate in capturing the intricate nonlinear patterns exhibited by gold price fluctuations. In this paper, we propose a hybrid deep learning model, CNN-BiGRU-AM, with the aim of enhancing the accuracy of gold price predictions. This hybrid model integrates the strengths of both CNN and BiGRU, leveraging CNN to identify significant features in historical price data and BiGRU to handle long-term dependencies in time-series data. Additionally, it incorporates an attention mechanism, a key innovation that enhances the model's predictive accuracy. The test results show that, on the same dataset, the proposed model makes the most accurate predictions compared to the other four models. It has an RMSE value of 0.9811, which is much lower than the CNN-GRU-AM (RMSE value of 1.085) and GRU (RMSE value of 1.8623).},
  keywords={Gold;Analytical models;Attention mechanisms;Accuracy;Fluctuations;Correlation;Current measurement;Predictive models;Forecasting;Investment;CNN;BiGRU;Attention mechanism;GLD;Prediction},
  doi={10.1109/ICAACE65325.2025.11020201},
  ISSN={},
  month={March},}@INPROCEEDINGS{10609104,
  author={Kock, Robin and Kaheh, Zohreh and Shafie-Khah, Miadreza},
  booktitle={2024 International Symposium on Power Electronics, Electrical Drives, Automation and Motion (SPEEDAM)}, 
  title={Developing Two RNN-Based Algorithms for Electricity Price Forecasting in Markets with High Penetration of Renewable Energy Resources}, 
  year={2024},
  volume={},
  number={},
  pages={1266-1270},
  abstract={Precisely predicting electricity prices can greatly benefit various participants in the energy market. This is a challenging endeavor due to the inherent volatility of electricity prices. Studies have shown that as renewable energy generation increases, electricity markets and prices tend to become more unpredictable. To tackle this problem effectively, different ML-based algorithms have been presented. This paper proposes two novel electricity price forecasting algorithms based on Recurrent Neural Networks-Long Short-Term Memory (RNN-LSTM) and Recurrent Neural Networks-Gated Recurrent Unit (RNN-GRU). Two algorithms perform well in terms of MAE and RMSE scores, indicating their suitability for electricity price forecasting tasks. These results align with similar research findings and highlight their effectiveness.},
  keywords={Renewable energy sources;Recurrent neural networks;Automation;Electricity;Prediction algorithms;Electricity supply industry;Power electronics;Electricity Price Forecasting;Machine Learning;Long Short-Term Memory;Gated Recurrent Unit},
  doi={10.1109/SPEEDAM61530.2024.10609104},
  ISSN={2835-8457},
  month={June},}@INPROCEEDINGS{11004771,
  author={Tendulkar, Shreya G.},
  booktitle={2025 International Conference on Advanced Computing Technologies (ICoACT)}, 
  title={Optimized Electricity Price Prediction for Battery Energy Storage System (BESS) Scheduling}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={With the growing integration of renewable energy sources and the deregulation of electricity markets, electricity prices have become increasingly volatile, complicating accurate price forecasting. This volatility is especially significant for Battery Energy Storage Systems (BESS), which rely on price predictions to schedule their charging and discharging cycles and maximize market arbitrage opportunities. Traditional prediction models often focus on minimizing the prediction error, which quantifies the difference between predicted and actual prices. However, this approach does not necessarily lead to optimal decision-making in BESS operations. Instead of focusing solely on prediction accuracy, the BESS's objective is to optimize its charging/discharging schedule to maximize benefits from price fluctuations, which involves minimizing the decision error—the gap between the optimal decisions based on predicted prices and those based on true market prices. This paper proposes a “predict, then optimize” framework, where accurate price predictions are integrated into a BESS scheduling model. The framework aims to reduce decision errors and enhance the arbitrage potential for BESS, contributing to more efficient energy storage management and better market performance. The research discusses various price prediction models and highlights the importance of aligning prediction strategies with the actual objectives of BESS operations to achieve superior financial outcomes.},
  keywords={Schedules;Renewable energy sources;Accuracy;Battery energy storage system;Processor scheduling;Electricity;Storage management;Focusing;Predictive models;Forecasting},
  doi={10.1109/ICoACT63339.2025.11004771},
  ISSN={},
  month={March},}@INPROCEEDINGS{10101073,
  author={Singh, A. and Shukla, B. and Jos, Jibrael},
  booktitle={2023 2nd International Conference for Innovation in Technology (INOCON)}, 
  title={Comparative Analysis of CPI prediction for India using Statistical methods and Neural Networks}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Inflation is one of the main issues affecting the world economy right now, necessitating the accurate inflation prediction for the development of tools and policies by the monetary authorities to prevent extreme price volatility. Expectations of inflation influence many financial and economic actions, and this dependence motivates economists to develop techniques for precise inflation forecasting. Nearly everyone in the economy is impacted by inflation, including lending institutions, stock brokers, and corporate financial officials. In many cases, inflation determines whether a firm will accept a particular project or if banks will make a particular loan. These different economic actors can modify their financial portfolios, strategic goals, and upcoming investments if they are able to forecast changes in inflation rates. The multiple interaction economic components that depend on inflation will be better understood by economic agents operating in a business context if inflation forecasting accuracy is improved. There are numerous techniques to forecast inflation ranging from basic statistical methods to complex neural network methods. Therefore, this paper employs LSTM model to train and analyze the Consumer Price Index (CPI) indicators to obtain inflation-related prediction results. The experimental results on historical data show that the statistical model has good performance in predicting India’s inflation rate compared to deep learning methods in case of smaller dataset.},
  keywords={Technological innovation;Statistical analysis;Economic indicators;Neural networks;Time series analysis;Predictive models;Macroeconomics;Consumer Price Index;RNN;LSTM;Stacked LSTM;GRU;ARIMA;SARIMA;Holt-Winters},
  doi={10.1109/INOCON57975.2023.10101073},
  ISSN={},
  month={March},}@INPROCEEDINGS{8595571,
  author={Mujeeb, Sana and Javaid, Nadeem and Javaid, Sakeena},
  booktitle={2018 IEEE 21st International Multi-Topic Conference (INMIC)}, 
  title={Data Analytics for Price Forecasting in Smart Grids: A Survey}, 
  year={2018},
  volume={},
  number={},
  pages={1-10},
  abstract={Electricity Price Forecasting (EPF) plays a significant role in competitive electricity markets. Market participants rely on price forecast for generation, assets scheduling and effective bidding plan formulation. The uncertainty and volatility of energy market makes price forecasting a very challenging task. This paper gives a survey on methods and techniques used in literature for price forecasting in last four years. This work provides general background of price forecasting and brief discussion of the models and approaches implemented in the area of price forecasting. A comparison of price forecasting techniques with respect to different categories is presented that draws out the important aspects of the implemented methodologies.},
  keywords={Forecasting;Predictive models;Support vector machines;Smart grids;Time series analysis;Neural networks;Data Analytics;Big Data;Price Forecasting;Artificial intelligent Forecasters;Deep Learning},
  doi={10.1109/INMIC.2018.8595571},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10157017,
  author={Nanthiya, D. and Gopal, S.B. and Balakumar, S. and Harisankar, M. and Midhun, S.P.},
  booktitle={2023 2nd International Conference on Vision Towards Emerging Trends in Communication and Networking Technologies (ViTECoN)}, 
  title={Gold Price Prediction using ARIMA model}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={The most valuable metal in the world is gold. It is the most sought-after commodity available. The study and forecasting of the daily gold price rate and the future gold price rate using machine learning algorithms and methodologies. Due to the multifactorial and nonlinear structure of the gold market, it is impossible to anticipate the gold price, which is influenced by a variety of external variables like marketing conditions, economic crises, oil price rate hikes, tax benefits, and interest rates. Using machine learning to enhance the performance of certain types of activities. It is used to the forecasting of financial variables, with an emphasis on equities rather than commodities. It focuses on how predictions are made utilising datasets and statistical analysis. Using ensemble-based machine learning methods such as Linear Regression, ARIMA Model, Random Forest Regression. The predictions are derived from a dataset of gold price rates. The performance measurements are MAE and RMSE. In Linear Regression values are 19.82,24.41. ARIMAA model 0.040, 0.046 and Random Forest is 0.150, 0.156. The results suggest ARIMAA model predict value in high accuracy.},
  keywords={Measurement;Gold;Analytical models;Statistical analysis;Oils;Linear regression;Finance;Machine Learning;Linear Regression;Multiple Linear Regression;ARIMA Model;Random Forest Regression},
  doi={10.1109/ViTECoN58111.2023.10157017},
  ISSN={},
  month={May},}@INPROCEEDINGS{10892497,
  author={Wong, Noelle Y. L. and Srinivasan, Dipti and Cheu, Eng Yeow and Chiam, Zhonglin},
  booktitle={2024 IEEE Sustainable Power and Energy Conference (iSPEC)}, 
  title={Variational Representation for Risk Assessment in Aggregated Supply Curve Forecasting: A Case Study in Singapore's Electricity Market}, 
  year={2024},
  volume={},
  number={},
  pages={416-421},
  abstract={This study underscores the potential of variational representation as a tool for uncertainty estimation in the energy market, which would help Independent System Operators (ISO) in risk assessment and demand response. Forecasts of future supply curves are also very valuable to energy suppliers seeking to optimize bidding strategies in an oligopolistic power market characterized by information privacy and volatility of individual bidding behaviors and variability in renewable energy generation. However, traditional deterministic modelling methods may not adequately capture the inherent uncertainty and volatility of the electricity market. Our variational encoding technique produces a resultant embedding space that is stochastic and exhibits substantial interpretability, which we exploit to demonstrate the model's transparency. By using the learned posterior probability distribution of the embedded aggregated supply curves (ASCs) to determine the statistical dispersion, we identify and study periods of high uncertainty in the Singapore electricity market between December 2021 and March 2023. We seek to provide insights into the origins of these uncertainties, showing that the method can capture changes in the market useful for risk modelling in decision-making.},
  keywords={Renewable energy sources;Uncertainty;ISO;Decision making;Stochastic processes;Predictive models;Electricity supply industry;Probabilistic logic;Encoding;Risk management;deep learning;LSTM;VAE;electricity price forecasting;ASC forecasting;stochastic modelling;strategic bidding;power system economics and market;power equipment planning and asset management},
  doi={10.1109/iSPEC59716.2024.10892497},
  ISSN={2837-522X},
  month={Nov},}@INPROCEEDINGS{8581312,
  author={Jiang, LianLian and Hu, Guoqiang},
  booktitle={2018 15th International Conference on Control, Automation, Robotics and Vision (ICARCV)}, 
  title={A Review on Short-Term Electricity Price Forecasting Techniques for Energy Markets}, 
  year={2018},
  volume={},
  number={},
  pages={937-944},
  abstract={The electricity price forecasting (EPF) is essential for decision-making mechanisms of market participants to survive in the deregulated and competing commercial environment. Due to special features of the electricity such as seasonality, the constant balance between production and consumption required by the system, and environmental dependencies, electricity prices generally shows extreme volatility and price spikes with the heteroscedasticity. This paper provides a survey of main EPF methodologies and the ultimate goal of this survey is to provide readers insights and guidelines for choosing different EPF techniques for day-ahead electricity markets. For each type of method, we briefly introduce its principle and then describe how it is applied in EPF. Many new EPF techniques developed recently are also discussed, especially the artificial intelligence forecasting methods. The pros and cons of each type of method are provided in a final table so that users can pay attention to when choosing them. In the final section, several promising methods and potential directions for further exploration are presented.},
  keywords={Predictive models;Computational modeling;Hidden Markov models;Forecasting;Smoothing methods;Electricity supply industry;Market research;Electricity price forecasting (EPF);deep learning;artificial intelligence;energy market;time series models},
  doi={10.1109/ICARCV.2018.8581312},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10645107,
  author={Miljana Milić, A. and Milojković, Jelena and Lukač, Duško and Petrušić, Andrija},
  booktitle={2024 11th International Conference on Electrical, Electronic and Computing Engineering (IcETRAN)}, 
  title={ANN Forecasting of European Natural Gas Dynamics: Implications for CO2 Emission, Electricity Production, and Market Trends}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents neural network-based forecasting models tailored to predict annual CO2 emissions resulting from natural gas usage, annual electricity production from gas sources, and annual gas prices across Europe. The selection of these parameters is motivated by their critical role in shaping the region's energy landscape and their significant implications for environmental sustain ability, energy security, and market dynamics. By analyzing three time series datasets, the forecasting models combine various factors influencing gas consumption, electricity generation, and price fluctuations, and enable policymakers and stakeholders to anticipate future trends and formulate effective strategies. Through validation and evaluation processes, our models demonstrate robust performance in accurately forecasting CO2 emissions, electricity production, and gas prices, thus providing a valuable tool for informed decision-making in energy planning and policy formulation.},
  keywords={Renewable energy sources;Electricity;Biological system modeling;Power system dynamics;Production;Predictive models;Market research;time series;ANN forecasting;gas-based electricity production;CO2 emission;energy market dynamics},
  doi={10.1109/IcETRAN62308.2024.10645107},
  ISSN={},
  month={June},}@INPROCEEDINGS{10235419,
  author={Gao, Yufeng and Feng, Jingfan and Tao, Zheng},
  booktitle={2023 IEEE 5th International Conference on Power, Intelligent Computing and Systems (ICPICS)}, 
  title={Exploring the Impact of Input Features on GAN-Based Stock Prediction}, 
  year={2023},
  volume={},
  number={},
  pages={219-223},
  abstract={This essay examines the impact of input attributes and training dataset size on stock prediction with Generative Adversarial Networks (GAN). The results indicate that more attributes do not necessarily lead to better model performance, and 2–3 sets of data attributes are often sufficient for good performance. The best set of data attributes includes a combination of core price information, news score information, and economic activities information, together with the combination of core prices information, news information, and mathematical information generated through Fourier transformation. The impact of different attributes on prediction performance varies depending on the size of the training set, with news information playing a positive role in smaller training sets and attributes such as stock index, mathematical information, and economic activities of the company having a positive impact on larger training sets. The future work involves validating these theories on different models and investigating the potential positive effects of standard information on larger training samples. Overall, this research highlights the importance of considering both the input attributes and training dataset size when using GAN models for stock prediction.},
  keywords={Training;Economics;Computational modeling;Companies;Predictive models;Generative adversarial networks;Mathematical models;GAN;stock prediction;input features},
  doi={10.1109/ICPICS58376.2023.10235419},
  ISSN={2834-8567},
  month={July},}@INPROCEEDINGS{11064192,
  author={Malyala, Rishi and Thattai, Kuthsav and Malik, Anam and Ravishankar, Jayashri},
  booktitle={2024 4th International Conference on Smart City and Green Energy (ICSCGE)}, 
  title={Weather-Independent Forecasting for State-Wide Energy Markets Using Hybrid GPI-DSSM Model}, 
  year={2024},
  volume={},
  number={},
  pages={156-161},
  abstract={This paper introduces a novel hybrid forecasting model for state-wide energy markets, combining a Graph-based Patch Informer (GPI) and Deep State Sequential State Memory (DSSM) architecture to predict electricity prices. Integrating spatial-temporally variable weather data can introduce noise and inconsistencies, as different regions within a state experience varying weather conditions. The GPI-DSSM model avoids these issues by relying solely on demand and price data, focusing on intrinsic and hidden relationships between aggregate demand and regional reference price (RRP). By using aggregate demand as a hidden state within the Gated Recurrent Unit (GRU) based DSSM, the model captures dependencies driving price fluctuations, while the GPI transformer handles long-range temporal patterns. This hybrid architecture provides robust, accurate forecasts, demonstrating that the geo-spatial-temporal limitations of weather data on aggregate demand forecasting can be effectively managed by focusing on core market variables like demand and price.},
  keywords={Green energy;Smart cities;Aggregates;Noise;Memory architecture;Focusing;Weather forecasting;Predictive models;Transformer cores;Transformers;Regional Reference Price;State-wide energy systems;Electricity Markets;Graph Patch Informer;Deep Sequential State Memory},
  doi={10.1109/ICSCGE64239.2024.11064192},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11273385,
  author={Das, Abhinav and Schlüter, Stephan},
  booktitle={2025 10th International Conference on Energy Efficiency and Agricultural Engineering (EE&AE)}, 
  title={Bayesian Neural Networks with Monte Carlo Dropout for Probabilistic Electricity Price Forecasting}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Accurate electricity price forecasting is critical for strategic decision-making in deregulated electricity markets, where volatility stems from complex supply-demand dynamics and external factors. Traditional point forecasts often fail to capture inherent uncertainties, limiting their utility for risk management. This work presents a framework for probabilistic electricity price forecasting using Bayesian neural networks (BNNs) with Monte Carlo (MC) dropout, training separate models for each hour of the day to capture diurnal patterns. A critical assessment and comparison with the benchmark model, namely: generalized autoregressive conditional heteroskedasticity with exogenous variable (GARCHX) model and the LASSO estimated auto-regressive model (LEAR), highlights that the proposed model outperforms the benchmark models in terms of point prediction and intervals. This work serves as a reference for leveraging probabilistic neural models in energy market predictions.},
  keywords={Uncertainty;Monte Carlo methods;Electricity;Neural networks;Predictive models;Probabilistic logic;Vectors;Bayes methods;Stakeholders;Forecasting;Electricity Price Forecasting;Bayesian Neural Networks;Monte Carlo Dropout;Uncertainty Quantification;Machine Learning},
  doi={10.1109/EEAE65901.2025.11273385},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11589694,
  author={Thöni, Patrick and Beltrami, Filippo and Grossi, Luigi and Lucarno, Riccardo},
  booktitle={2026 22nd International Conference on the European Energy Market (EEM)}, 
  title={Ensemble Methods for Italian Day-Ahead Electricity Price Forecasting}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a systematic benchmarking study of ensemble methods for Day-Ahead (DA) Electricity Price Forecasting (EPF), an area where rigorous evaluation remains scarce despite the well-established benefits of forecast combination. Unlike existing studies that typically propose and benchmark a single ensemble technique, we evaluate over 100 ensemble variants — spanning simple averaging, rule-based heuristics, and data-driven weighting schemes — applied to a diverse suite of statistical, machine learning, and deep learning base models. Our framework jointly addresses three dimensions: unified evaluation across combination rules, ensemble sizes, and weight update schemes; systematic comparison at both daily and per-period (quarter-hourly) granularity; and joint assessment of forecast accuracy and stability. All methods are applied at 15-minute price resolution, in line with the Italian day-ahead market’s transition to intraday settlement granularity completed in October 2025. Our results show that the best ensemble improves upon the best individual model by 5.81% in MAE — a statistically significant gain — while also reducing error variance and large-error incidence. Averaging-based methods deliver more uniform and statistically robust improvements than rule-based heuristics, which yield larger peak gains but with lower consistency. Component analysis confirms that all model families contribute to the best per-period ensemble, with deep learning architectures receiving greater weight during volatile midday periods. Overall, data-driven averaging ensembles emerge as practical and robust tools for operational DA-EPE.},
  keywords={Modeling;Forecasting;Pricing;Electricity;Printing;Accuracy;Ranking (statistics);Windows;Energy;Gain;Day-Ahead Market;Deep Learning;Electricity Price Forecasting;Ensemble Methods;Machine Learning Models},
  doi={10.1109/EEM68581.2026.11589694},
  ISSN={2165-4093},
  month={June},}@INPROCEEDINGS{11691680,
  author={Fitriana, Pingkan Mayosi and Halim, Zairihan Abdul and Salih, Safia and Ernawan, Ferda},
  booktitle={2026 IEEE 1st International Conference on Artificial Intelligence Implementation & Applications (ICAIIA)}, 
  title={The Causal Impact of COVID-19 on G20 Stock Markets Using LSTM Counterfactual Forecasting}, 
  year={2026},
  volume={},
  number={},
  pages={202-207},
  abstract={The COVID-19 pandemic has significant implications to the financial stability and stock market value. Researchers have examined the pandemic effects using econometric models, this approach struggles to capture the nonlinear dynamics, structural breaks, and extreme volatility associated with pandemic periods. This paper utilized deep learning techniques to model complex time-series under unprecedented shocks. This paper proposed a Long Short-Term Memory (LSTM) neural network for time-series prediction to predict and calculate causal inference for G20 countries from 1 January 2018 to 30 December 2020. The analytical framework incorporates pandemic-related variables: daily confirmed cases (DCC), daily death cases (DDC), and the stringency index (SINDEX), macroeconomic indicators such as exchange rate (ER), interest rate (BOND), volatility index (VIX), gold price (GOLD), and oil price (OIL). The experiments also evaluate the important features for each model by using SHapley Additive exPlanations (SHAP). The results show that the LSTM model achieved a high predictive accuracy for all G20 countries. The causal analyses reveal heterogeneous pandemic effects across G20 markets, with significant negative impacts observed in France, the United Kingdom, and Indonesia, while most developed markets demonstrated stronger resilience. The proposed LSTM model achieved consistently strong performance across most countries, with MAPE values ranging from 2.07% to 5.84%.},
  keywords={Modeling;Long short term memory;Stock markets;COVID-19;Pandemics;Forecasting;Printing;Indexes;Indexing;Equations;COVID-19;deep learning;stock market prediction;LSTM},
  doi={10.1109/ICAIIA70172.2026.11691680},
  ISSN={},
  month={Sep.},}@ARTICLE{9738619,
  author={Akşehir, Zinnet Duygu and Kiliç, Erdal},
  journal={IEEE Access}, 
  title={How to Handle Data Imbalance and Feature Selection Problems in CNN-Based Stock Price Forecasting}, 
  year={2022},
  volume={10},
  number={},
  pages={31297-31305},
  abstract={Stock market forecasting is a time series problem that aims to predict possible future prices or directions of an index/stock. The stock data contains high uncertainty and is influenced by too many factors; hence it isn’t easy to achieve the goal by traditional time series methods. In literature, the convolutional neural networks (CNN) models were used for stock market forecasting and gave successful results. But, data imbalance due to labeling and feature selection problems were seen when considering these models. Hence, this study proposed a new rule-based labeling algorithm and a new feature selection approach to solve the issues. In addition, a CNN-based model, which was presented to predict the next day’s trade action of stocks in the Dow30 index, was constructed to check the effectiveness of the data labeling and the feature selection approach. Different image-based input variable sets were created using technical indicators, gold, and oil price data to feed the CNN model. The prediction performance of CNN models was compared with other studies in the literature. The experimental results showed that the CNN prediction model, which uses the proposed feature selection and labeling approaches in this study, performs 3-22% higher accuracy than the CNN-based models taking part in other studies. Also, the labeling approach proposed is more successful than Chen and Huang’s data weighting approach to solve the stock data imbalance problem. This algorithm reduced the ratio between labeled data from 15 times to 1.8 times.},
  keywords={Predictive models;Labeling;Data models;Convolutional neural networks;Biological system modeling;Stock markets;Forecasting;CNN model;feature selection;labeling;stock prediction},
  doi={10.1109/ACCESS.2022.3160797},
