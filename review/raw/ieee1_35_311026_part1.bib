  booktitle={2020 IEEE International Conference on Informatics, IoT, and Enabling Technologies (ICIoT)}, 
  title={Using Deep Learning to Predict Stock Movements Direction in Emerging Markets: The Case of Qatar Stock Exchange}, 
  year={2020},
  volume={},
  number={},
  pages={440-444},
  abstract={Deep learning approaches have been utilized to predict stocks. In this study, we use convolutional neural network (CNN) to predict stocks direction in Qatar stock exchange (QE) as a case of emerging markets. Prediction in emerging markets is more challenging than in developed ones because they have higher volatility rate. They are influenced by developed markets and by other external factors including oil price. In this study, we aim to use these external factors to improve the accuracy of the prediction in QE. In addition to historical data, we include data of S&P index, Nikkei index, and oil price in the features of our mode. It is found that using these external factors improves the accuracy of the prediction by 10%.},
  keywords={Stock markets;Predictive models;Indexes;Oils;Machine learning;Data models;Convolutional neural networks;stock prediction;deep learning;emerging markets;Qatar stock exchange},
  doi={10.1109/ICIoT48696.2020.9089616},
  ISSN={},
  month={Feb},}@ARTICLE{11122531,
  author={Wang, Xiang and Wang, Hao and Wang, Zirong and Wu, Di and Xue, Yuan and Ye, Lingxiao and Zhang, Yucong},
  journal={IEEE Access}, 
  title={A Hybrid PLO-Transformer-CEEMDAN Model for Natural Gas Price Forecasting}, 
  year={2025},
  volume={13},
  number={},
  pages={143489-143508},
  abstract={To address the nonlinear and non-stationary characteristics of natural gas prices, this study proposes a hybrid PLO-Transformer-CEEMDAN forecasting framework. The model integrates weight optimization, multi-scale trend extraction, and residual correction, effectively utilizing 27 heterogeneous features—including Google Trends indicators—to improve predictive accuracy. Empirical evaluations on Henry Hub monthly data (2004–2024) show that the model achieves exceptional forecasting performance (RMSE: 0.0257, R2: 0.9998), representing a 92.87% RMSE reduction compared to the baseline Transformer. Notably, incorporating Google Trends alone leads to a 30.91% improvement in accuracy, underscoring its value in capturing market sentiment prior to price changes. Overall, the proposed method significantly outperforms conventional benchmarks in both predictive precision and generalization ability, offering a robust tool for energy price forecasting and market risk assessment.},
  keywords={Predictive models;Forecasting;Transformers;Natural gas;Adaptation models;Accuracy;Market research;Optimization;Transformer cores;Data models;Energy market;natural gas price forecasting;PLO;residual series modeling;transformer},
  doi={10.1109/ACCESS.2025.3597657},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11537089,
  author={Faris, Zainab and Hussein, Ehab Abdulrazzaq},
  booktitle={2026 8th International Congress on Human-Computer Interaction, Optimization and Robotic Applications (ICHORA)}, 
  title={Efficient Hybrid Deep Learning Framework for Accurate Day-Ahead Electricity Price Forecasting in the Danish DK1 Market}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Accurate day-ahead electricity price forecasting is a fundamental aspect of efficient energy market management, particularly in regions characterized by high volatility, such as the Danish DK1 electricity market. This study proposes and evaluates a hybrid deep learning framework designed to enhance the reliability and precision of electricity price predictions. The hybrid architecture synergistically integrates Convolutional Neural Networks (CNN) to automatically extract local and spatial features from historical price data, a Variational Autoencoder (VAE) to generate compact, regularized representations thereby mitigating noise and strengthening model robustness against sudden price spikes, and Gated Recurrent Units (GRU) to capture complex temporal dependencies and sequential patterns. To assess the performance of this framework, it is compared with several benchmark models, including traditional Artificial Neural Networks (ANNs), standalone CNNs, GRUs, and CNN-GRU combinations. Model evaluation is conducted using standard performance metrics, such as Mean Absolute Error (MAE), Mean Squared Error (MSE), and Root Mean Squared Error (RMSE), under various market conditions. The results demonstrate that the proposed hybrid model consistently outperforms benchmark approaches, achieving superior prediction accuracy and generalization capacity. These findings suggest that integrating CNN, VAE, and GRU techniques provides a practical and effective solution for forecasting day-ahead electricity prices in highly dynamic and volatile energy markets.},
  keywords={Forecasting;Modeling;Pricing;Electricity;Convolutional neural networks;Printing;Power markets;Energy;Electricity supply industry;Timing;Deep learning;DK1 market;Time series forecasting;Renewable energy;Electricity markets},
  doi={10.1109/ICHORA69329.2026.11537089},
  ISSN={2996-4393},
  month={May},}@INPROCEEDINGS{9006195,
  author={Tang, Yuanyuan and Wang, Qingmei and Xu, Wei and Wang, Mingming and Wang, Zhaowei},
  booktitle={2019 IEEE International Conference on Big Data (Big Data)}, 
  title={Natural Gas Price Prediction with Big Data}, 
  year={2019},
  volume={},
  number={},
  pages={5326-5330},
  abstract={In recent decades, commodities have attracted the attention of a large number of investors and financial professionals, and their prices have become very important for investors and policy makers. Although natural gas is widely used as a clean energy, there is less literature on price research and most of them use historical prices and fundamental factors to analyze natural gas price. Based on historical prices, this paper analyzes whether internet search data and news sentiment can improve forecasting ability, and compare which can achieve better prediction results. The experimental results show that both internet search and news sentiment contain additional information to improve the prediction effect, and internet search data can achieve better prediction results.},
  keywords={Natural gas;Predictive models;Oils;Biological system modeling;Google;Forecasting;Market research;natural gas;price prediction;internet search;news sentiment;deep learning},
  doi={10.1109/BigData47090.2019.9006195},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11589786,
  author={Næss, Lina Ganter and Kost, Christoph and Thomsen, Jessica},
  booktitle={2026 22nd International Conference on the European Energy Market (EEM)}, 
  title={Multi-Day Forecasting of Day-Ahead Electricity Prices under Input Forecast Uncertainty}, 
  year={2026},
  volume={},
  number={},
  pages={1-4},
  abstract={Electricity price forecasts are increasingly important for trading and procurement decisions in European power markets with growing renewable generation and increasing price volatility. When forecasting prices for future delivery periods, key drivers such as load and renewable generation are only available as forecasts rather than realised values.This paper investigates how the use of realised versus forecasted inputs in model training and prediction affects multi-day-ahead forecasts of hourly German day-ahead market prices. A feed-forward neural network is evaluated in a rolling training framework under three input configurations: training on realised inputs and predicting with forecasted inputs, training and predicting with forecasted inputs, and an ex post perfect-input benchmark using realised inputs at prediction time. Forecast errors increase with prediction horizon, and input forecast errors account for a substantial share of overall prediction error. Training on forecasted inputs does not systematically improve forecasting accuracy in this setting.},
  keywords={Forecasting;Modeling;Pricing;Training;Electricity;Machine learning;Energy;Accuracy;Timing;Feedforward neural networks;Forecast uncertainty;Forecasting;Power markets},
  doi={10.1109/EEM68581.2026.11589786},
  ISSN={2165-4093},
  month={June},}@ARTICLE{8864986,
  author={Gao, Wei and Aamir, Muhammad and Shabri, Ani Bin and Dewan, Raimi and Aslam, Adnan},
  journal={IEEE Access}, 
  title={Forecasting Crude Oil Price Using Kalman Filter Based on the Reconstruction of Modes of Decomposition Ensemble Model}, 
  year={2019},
  volume={7},
  number={},
  pages={149908-149925},
  abstract={The modes’ reconstruction into the stochastic and deterministic components is proposed for forecasting the crude oil prices with the concept of “divide and conquer” and modes reconstruction. It is to reduce the complexity in the computation and to enhance the forecasting accuracy of the decomposition ensemble technique. Under the framework of “divide and conquer”, the decomposition and ensemble methodologies of forecasting power successfully improves with the proposed model based on the modes’ reconstruction. The corresponding reconstruction is using average mutual information (AMI). The proposed procedure is based on four layers i.e., complex data decomposition, reconstruction of modes into components, the prediction of each individual component and assembling the final prediction. In the proposed procedure, the modes of the stochastic component are analyzed thoroughly as it influences the prediction results significantly. For verification and illustration purposes, the case study of Brent and West Texas Intermediate (WTI) daily crude oil prices data are used, and the empirical study confirms that the outcomes outperform all the considered benchmark models, including auto-regressive integrated moving average (ARIMA) model, generalized autoregressive conditional heteroscedasticity (GARCH) model, NAÏVE model, ARIMA Kalman Filter model. This outcome is achieved, with the reconstruction decomposition ensemble (RDE) model along stochastic and deterministic components. Hence, it is concluded that the proposed model achieved higher forecasting accuracy and takes less computational time with the modes’ reconstruction as opposed to using all the decompose modes.},
  keywords={Oils;Predictive models;Forecasting;Computational modeling;Hidden Markov models;Stochastic processes;Data models;Average mutual information;crude oil price;decomposition ensemble model;reconstruction;deterministic and stochastic components},
  doi={10.1109/ACCESS.2019.2946992},
  ISSN={2169-3536},
  month={},}@ARTICLE{9716135,
  author={Antwi, Emmanuel and Gyamfi, Emmanuel Numapau and Kyei, Kwabena A. and Gill, Ryan and Adam, Anokye Mohammed},
  journal={IEEE Access}, 
  title={Modeling and Forecasting Commodity Futures Prices: Decomposition Approach}, 
  year={2022},
  volume={10},
  number={},
  pages={27484-27503},
  abstract={Price instability is a paramount concern since commodity prices are associated with the livelihood and the economy of a nation as a whole; any extraordinary price fluctuation in the futures market shows that forecasts in commodities is an essential venture. The difficulties in predicting commodity prices are due to the unpredictability of the world’s financial issues, fiscal dispensation, the speculative market’s exacerbation, and several other elements. This study aims to model and forecast the market price of commodity futures. We applied decomposition techniques, empirical mode decomposition (EMD), and variational mode decomposition (VMD) to three commodities: corn, crude oil, and gold over the commodity spot market prices. We used the Granger causality test to establish mutual relationships amongst the three commodity futures prices. Three commodity price data with different periods were decomposed into several intrinsic modes. Using three forecasting performance evaluation criteria, statistical measures such as mean absolute error (MAE), root mean square error (RMSE), and mean percentage error (MAPE) to compare the capabilities of the suggested models. We also introduced Diebold Mariano (DM) test in selecting the optimal models for each commodity, since MAE, RMSE and MAPE have some shortcomings. We found that the combined models outperformed the individual back propagation neural network (BPNN) and autoregressive integrated moving average (ARIMA) models in forecasting corn and crude oil futures prices series, while BPNN emerged as the optimal model for predicting gold futures prices series. Variational mode decomposition emerged as the ideal data pre-treatment method and contributed to enhancing the predicting ability of the BPNN and the ARIMA models. The empirical results showed that models combined with decomposition methods predict commodity futures prices accurately and can easily capture the volatility in commodity futures prices.},
  keywords={Predictive models;Oils;Gold;Forecasting;Economics;Autoregressive processes;Data models;Back propagation neural network;commodity price;empirical mode decomposition;forecasting;Granger causality test;variational mode decomposition},
  doi={10.1109/ACCESS.2022.3152694},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10276011,
  author={Deepa, P.B. and Daisy, Josephine},
  booktitle={2023 4th International Conference on Smart Electronics and Communication (ICOSEC)}, 
  title={Deep Learning Based Prediction of Commodity Prices Using LSTM}, 
  year={2023},
  volume={},
  number={},
  pages={1708-1715},
  abstract={Commodity price prediction using deep learning, specifically LSTM models, is a challenging task due to limited data, price volatility, and the complexity of capturing temporal dependencies. In recent years, various techniques have been explored to address these challenges, such as transfer learning, model interpretability, handling seasonality, and ensemble learning. However, existing systems still face issues related to model interpretability, uncertainty quantification, and adaptability to evolving market conditions. This article aims to analyze one of the machine learning methods and what applications it can have in the financial world. Specifically, it aims to explore a technique called deep learning. To do this, some methods are analyzed, which are most relevant and most used in the industry, which are found within the deep learning method. Once the selected methods are analyzed, it is intended to implement them in a programming environment, in this case Python is chosen, and then a practical case is developed and evaluated. The case in question is the forecasting of commodity prices, with particular focus on the price of Brent. Different technical analysis indicators will be used in this forecasting model, knowing that there is no solid statistical basis in their use, but in practice most traders use them and, in the absence of shocks, on a macroeconomic basis, the results obtained when using them are, in general, quite adequate. Finally, the results of the predictions obtained are compared under different models to calculate which model gives us the greatest advantage.},
  keywords={Deep learning;Adaptation models;Solid modeling;Uncertainty;Computational modeling;Transfer learning;Predictive models;Deep Learning;Long short-term memory (LSTM);Convolutional neural network (CNN);Stock market;Finance},
  doi={10.1109/ICOSEC58147.2023.10276011},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11315454,
  author={Sayed, Marwan and Mahmood, Alhasan and Khan, Muhammad Muaz and Ahmed, Yossef and Alhazbi, Saleh},
  booktitle={2025 IEEE/ACS 22nd International Conference on Computer Systems and Applications (AICCSA)}, 
  title={Predicting Stock Trends in Emerging Markets with Multi-Source Data: A Study on the Qatar Stock Exchange}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Predicting stock movements in emerging markets is challenging due to high volatility and the influence of diverse factors. This study proposes a classification-based approach for forecasting next-day stock price direction on the Qatar Stock Exchange (QSE) using a modified Classification Temporal Fusion Transformer (TFT). The model integrates historical stock data, technical indicators, global market indices, commodity trends, and news sentiment. Experiments on four major QSE-listed companies from 2018 to 2024 show that combining technical and sentiment features improves predictive accuracy. The Classification TFT achieved up to 68% accuracy, outperforming traditional methods and highlighting the value of multi-source data for financial forecasting in emerging markets.},
  keywords={Accuracy;Companies;Predictive models;Transformers;Market research;Data models;Thin film transistors;Stock markets;Forecasting;Tuning;Stock market prediction;Temporal Fusion Transformer;deep learning;technical indicators;news sentiment analysis;Qatar Stock Exchange},
  doi={10.1109/AICCSA66935.2025.11315454},
  ISSN={2161-5330},
  month={Oct},}@INPROCEEDINGS{11338073,
  author={Bhaskaran, S. and N, Venkata Subramanian},
  booktitle={2025 International Conference on Cognitive, Green and Ubiquitous Computing (IC-CGU)}, 
  title={A Hybrid Recommender System for Predicting Gold Prices Using Financial and Temporal Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Predicting the cost of gold is essential in financial decision-making and investment planning. The traditional models are generated by the majority of econometric or time-series methods, but they do not address the specifics of investment behavior of users. In the study we develop a hybrid recommender system based on collaborative filtering, content-based analysis and temporal modeling to predict the price of gold and recommend investment activities. We make use of data on gold prices as well as pertinent data on the macroeconomy and preference data of simulated investors to make up a complete predictive model. Findings indicate that the combination of various techniques is more accurate than individual methods. The resulting model is full of customized information and offers better forecasting abilities. This research shows the possibility of the recommended systems not bound to e-commerce as in the finance and commodity sectors.},
  keywords={Gold;Collaborative filtering;Biological system modeling;Finance;Predictive models;Ubiquitous computing;Planning;Forecasting;Recommender systems;Investment;Hybrid Recommender System;Gold Price Forecasting;Collaborative Filtering;Time-Series Prediction;Financial Decision Support},
  doi={10.1109/IC-CGU67042.2025.11338073},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11393142,
  author={Ivana, Jane and Aleitta, Kyla and Setiyo, Khaylanissa and Perwiro Atmojo, Robertus Nugroho},
  booktitle={2025 8th International Seminar on Research of Information Technology and Intelligent Systems (ISRITI)}, 
  title={AI and Big Data for Optimizing Indonesia’s Oil Trade Balance}, 
  year={2025},
  volume={},
  number={},
  pages={176-181},
  abstract={Indonesia's oil trade balance, which was in surplus in the late 1990s, has gradually moved into an extensive deficit. Crude oil exports fell drastically throughout time from USD 5.71 billion in 1996 to just USD 2.23 billion in 2024. Exports of crude oil have fluctuated although they are still less than imports. With a peak of USD 31.76 billion in 2012, imports of oil products increased from USD 2.08 billion in 1996 to USD 25.92 billion in 2024. This study forecasts trade values and identifies abnormalities using artificial intelligence (AI) and big data. Grid-searched ARIMA models and an automated data pipeline were used with the best models, ARIMA (0,2,1) for exports and ARIMA (2,2,1) for imports, showing short term corrections after sharp changes. Events like the 2008 oil price rise and COVID-19 decline in 2020 are the main causes of volatility, according to Z-score results of year-over-year analysis. This suggests that persistent instability is not the root source of volatility. The model's capacity to offer a more realistic long-term prognosis is demonstrated by the final projection, which predicts a major decrease in oil exports and a large trade imbalance by 2030 when compared to the Hybrid VAR-LSTM approach model. The results suggest opportunities to boost export recovery and reduce reliance on imports. Data-based routing and AI forecasting are applied for this. To increase energy security, recommendations include incorporating more detailed data such as including outside variables in forecasts as well as AI-assisted distribution and refining. To improve forecast accuracy even more, future studies might expand this framework by adding advanced deep learning architectures like Transformer models or bidirectional LSTMs.},
  keywords={Fluctuations;Oils;Biological system modeling;Bidirectional long short term memory;Predictive models;Big Data;Oil insulation;Transformers;Data models;Forecasting;Big Data;Oil Trade Balance;ARIMA Modelling;Hybrid VAR-LSTM},
  doi={10.1109/ISRITI68345.2025.11393142},
  ISSN={2832-1456},
  month={Dec},}@INPROCEEDINGS{11330206,
  author={K, Krishna Kumar. and Aalam, S. Shiek and Sonya, A. and K, Divya. and S, Sakthivel. and S, Yuvaraj.},
  booktitle={2025 4th International Conference on Applied Artificial Intelligence and Computing (ICAAIC)}, 
  title={Predictive Accuracy Comparison Between Machine Learning and Deep Learning Frameworks in Energy Stock Forecasting}, 
  year={2025},
  volume={},
  number={},
  pages={294-299},
  abstract={The unpredictability of financial markets, driven by their volatility and nonlinear patterns, makes accurate stock price forecasting a difficult task. This study investigates the predictive capability of Machine Learning(ML) and Deep Learning(DL) models by comparing the performance of LSTM networks with XGBoost regression for forecasting Indian energy sector stocks. One year of historical stock price data was retrieved from the Yahoo Finance platform, which served as the primary data source for this study, and technical indicators such as exponential moving averages (EMA-5, EMA-10) were incorporated as features. Training and validation were performed on stock data from several petroleum and oil sector companies, and predictive accuracy was measured using MAE, RMSE, and R2 metrics. Results show that XGBoost outperformed LSTM, achieving a lower average RMSE (4.96 vs. 7.14) and higher average R2 (0.9949 vs. 0.9857), indicating superior error minimization and generalization. The results emphasize the strength of ensemble-based approaches such as XGBoost in modeling intricate stock market behaviors, demonstrating their reliability for short-term forecasting when compared to deep learning models.},
  keywords={Deep learning;Training;Accuracy;Computational modeling;Soft sensors;Predictive models;Reliability;Forecasting;Stock markets;Long short term memory;Extreme Gradient Boosting;Long Short-Term Memory;Financial Prediction;Technical Indicators;Exponential Moving Averages;Moving Averages},
  doi={10.1109/ICAAIC64647.2025.11330206},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10383005,
  author={Gomez, William and Wang, Fu-Kwun},
  booktitle={2023 IEEE 5th Eurasia Conference on IOT, Communication and Engineering (ECICE)}, 
  title={Hybrid Decomposition-Deep Learning Model for Energy Load Prediction}, 
  year={2023},
  volume={},
  number={},
  pages={557-562},
  abstract={Energy data have a complex behavioral pattern due to many factors that influence the energy market. Energy forecasting promotes the effective and reliable operation of power system management and efficient allocation of resources, especially during an economic crisis. To reduce the difficulty of load volatility, noisy measurement, and non-linearity and improve short-term power load forecasting, we proposed a novel data-driven hybrid model for predicting load datasets with different time horizons. We used complete ensemble empirical model decomposition with adaptive noise (CEEMDAN) to decompose load data into several subsequences’ intrinsic mode functions (IMFs) and a residual while dealing with the mode mixing problem. The proposed model integrated bidirectional long short term with attention (BiLSTM-AM) and deep neural network (DNN) to predict the modes. The hyperparameters of BiLSTM-AM-DNN were tuned using the Bayesian optimization method to achieve high accuracy. DNN was integrated at the end of BiLSTM-AM to extract more accurate characteristics from load data and further improve the forecast. Accurate uncertainty was estimated for risk management and planning. The proposed model achieved an empirical coverage above 95% on average. A thorough comparison was made to verify the superiority of the proposed model compared to the competing models.},
  keywords={Economics;Adaptation models;Uncertainty;Artificial neural networks;Predictive models;Data models;Time measurement;short-term load prediction;deep neural network;bidirectional long short-term with attention;electricity load;uncertainty estimation},
  doi={10.1109/ECICE59523.2023.10383005},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10426519,
  author={Khunti, Shravan and Kumar, Prikshit and Rao, M. Lakshman and Muni, T Vijay and Singh, Varun Sanjeev and Subhani, Shaik Chand Mabhu},
  booktitle={2023 Global Conference on Information Technologies and Communications (GCITC)}, 
  title={Application of Machine Learning and Deep Learning Algorithms to the Prediction of Stock Market Trends}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={The stock market's inherent volatility poses ongoing challenges for stock traders, as it is subject to a multitude of circumstances that exert influence on its behavior. This research aims to mitigate the risk associated with forecasting stock market trends through the utilization of deep learning and machine learning techniques. Eleven machine learning models were utilized in this study: random forest, logistic regression, xgboost, naive Bayes, K-nearest neighbors, decision tree and support vector classifier and extreme gradient boosting. Additionally, two powerful deep learning techniques: recurrent neural networks (RNN) and long short term memory (LSTM) were used. From the Tehran Stock Exchange, four market groups were chosen for the experimental estimates. Petroleum, non-metallic minerals, basic metals, and diversified financials are all part of these categories.},
  keywords={Deep learning;Recurrent neural networks;Support vector machine classification;Market research;Data models;Stock markets;Long short term memory;stock market trend prediction;deep learning;Support Vector Classifier;Artificial Neural Network;stock trading;k-nearest neighbors;RNN;long short-term memory},
  doi={10.1109/GCITC60406.2023.10426519},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10895930,
  author={Dash, Anupa Sekhar and Mishra, Ujjwal},
  booktitle={2024 IEEE Pune Section International Conference (PuneCon)}, 
  title={Application of NLU based Sentiment Analysis in the Hybrid Stock Price Forecasting Model using Deep Learning Model}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={For any developing market, like the Indian stock market, creating a stock market forecasting model is difficult. The reason being investor behavior on economic factors like changes in the western stock market, variations in the price of commodities on the international market, war-related escalations, and central bank actions influence the stock prices in emerging stock markets and less work on prior studies to consider investor behaviors based on several economic elements that affect price movement. To address this issue, a hybrid forecasting model is developed that uses Deep Learning algorithms through a multivariate Long Short-Term Memory (LSTM) model to predict future open and close prices by combining sentiment analysis data of economic information along with historical prices. The findings indicate that sentiment analysis data on economic information has an impact on stock price movement. The proposed model achieved better results in terms of coefficient for the determinant (R2) and a Mean Absolute Percentage Error (MAPE) for the predicted result. The study findings can be used in future studies of other markets and asset classes where investor opinion toward certain events may have an impact on price fluctuations.},
  keywords={Economics;Analytical models;Sentiment analysis;Predictive models;Market research;Data models;Indexes;Stock markets;Forecasting;Long short term memory;Stock Market;Deep Learning;LSTM;Sentiment Analysis;NLU},
  doi={10.1109/PuneCon63413.2024.10895930},
  ISSN={2831-5022},
  month={Dec},}@INPROCEEDINGS{10861408,
  author={Namani, Soumya and Amin, Md Al and Miah, Md Ochiuddin and Ahad Khan, Abdullah Al and Kabir, Md Faisal and Ullah, Md Habib},
  booktitle={2024 IEEE Energy Conversion Congress and Exposition (ECCE)}, 
  title={Real-Time Energy Price Forecasting using BiLSTM-Autoencoder Deep Learning Model}, 
  year={2024},
  volume={},
  number={},
  pages={1689-1694},
  abstract={Electricity price forecasting is crucial in the energy markets as it affects various stakeholders, including electricity consumers, retailers, suppliers, and grid operators. Still, it is enormously challenging due to high volatility, rapid spikes, seasonality, and others. Traditional forecasting methods often fail to capture the complex dynamics of electricity pricing, especially in real-time markets. Therefore, this paper introduces a new approach to forecasting real-time electricity prices by synergizing a bi-directional Long Short-Term Memory (BiLSTM) network with an autoencoder. Integrating BiLSTM into autoencoders allows a nuanced understanding of temporal data, significantly improving forecast accuracy. The result demonstrates lower Mean Absolute Error, Root Mean Square Error, and Mean Absolute Percentage Error compared to standard models, highlighting the potential of this hybrid approach in complex data-driven forecasting scenarios.},
  keywords={Training;Electricity;Autoencoders;Bidirectional long short term memory;Bidirectional control;Predictive models;Real-time systems;Data models;Forecasting;Standards;Autoencoder;BiLSTM;Deep Learning;Electricity Price;Real-time Energy Market;Regression},
  doi={10.1109/ECCE55643.2024.10861408},
  ISSN={2329-3748},
  month={Oct},}@ARTICLE{10756599,
  author={Joshi, Pooja and Størdal, Ståle and Lien, Gudbrand and Mishra, Deepti and Haugom, Erik},
  journal={IEEE Access}, 
  title={A Comprehensive Analysis of Dropout Assisted Regularized Deep Learning Architectures for Dynamic Electricity Price Forecasting}, 
  year={2024},
  volume={12},
  number={},
  pages={177327-177341},
  abstract={As the world moves towards a sustainable future, there is a need for efficient integration of intermittent energy sources (IES) sources with intelligent energy grids. Electricity from IES (such as wind, solar, hydro, etc.) relies on various environmental factors and introduces significant uncertainties. This, in turn, impacts the financial viability of the investment plan for energy utilities and demands the deployment of efficient electricity price forecasting (EPF) approaches. Many existing EPF approaches show limited performance due to significant nonlinearity, high volatility, and continuous evolutions of exogenous variables. For such applications, data-driven approaches such as deep learning (DL) have shown promising forecasting capabilities in recent years. Therefore, this work comprehensively analyses the performance of various DL architectures for EPF across five major global deregulated electricity markets. Furthermore, to improve the performance, we propose a distinct approach by integrating Monte Carlo dropouts and weighted constraints in a DL architecture. The performance of model is assessed against regression-based models and benchmark DL architectures in terms of error matrices and computational time. The results demonstrate that the presented methodology enables the identification of the most appropriate DL architecture and demonstrates improved forecasting performance for electricity markets when compared against benchmarks.},
  keywords={Forecasting;Electricity;Computer architecture;Electricity supply industry;Predictive models;Convolutional neural networks;Logic gates;Computational modeling;Benchmark testing;Training;Electricity price forecasting;energy markets;machine learning;deep learning;forecast assessment},
  doi={10.1109/ACCESS.2024.3501773},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9271504,
  author={Tikhonov, E.E. and Chebanov, K.A. and Burlyaeva, V.A.},
  booktitle={2020 International Multi-Conference on Industrial Engineering and Modern Technologies (FarEastCon)}, 
  title={Development of Forecasting Theory and Methods for Developing Forecasts in Electroenergetics}, 
  year={2020},
  volume={},
  number={},
  pages={1-5},
  abstract={The article discusses several fundamental problems in forecasting problems that form the scientific novelty of the research. One of the problems is formulated as the need to determine the key parameters that form the basis of the forecasting model and allow determining the state of the subject area. The next key problem in the literature is formulated as the “curse of dimensionality”. Occurs when the researcher tries to take into account the maximum number of indicators and criteria for evaluating the subject area in the model, and this leads to the fact that the computer model required for its solution approaches the “Turing limit”. The third problem is described in the literature as the problem of “supersystem”. All elements of the predicted system or process can form higher-level systems that have their own unique properties. This makes it fundamentally impossible to describe a super-system mapping of target functions from the point of view of the systems and processes that make up the super-system. To develop the theory of forecasting and overcome these problems, we propose the use of such sections of modern mathematics as neuromathematics and deep machine learning, chaos theory, catastrophe theory, and the theory of self-organizing systems. It is believed that these methods will increase the depth of the forecast by identifying hidden patterns and relationships among poorly formalized conventional methods of predictive indicators.},
  keywords={Forecasting;Predictive models;Analytical models;Computational modeling;Neural networks;Econometrics;Time series analysis;forecasts;neural networks;machine learning;catastrophe theory},
  doi={10.1109/FarEastCon50210.2020.9271504},
  ISSN={},
  month={Oct},}@ARTICLE{9335921,
  author={Saeed Alzaeemi, Shehab Abdulhabib and Sathasivam, Saratha},
  journal={IEEE Access}, 
  title={Examining the Forecasting Movement of Palm Oil Price Using RBFNN-2SATRA Metaheuristic Algorithms for Logic Mining}, 
  year={2021},
  volume={9},
  number={},
  pages={22542-22557},
  abstract={RBFNN with different algorithms and the logic mining method for forecasting constitute the most significant tools and techniques, which are used to demonstrate the economic growth in the country. Upon using monthly data spanning from Jan 2016 to March 2020 for the manufacturing of palm oil, the results mainly revealed that RBFNN-2SATRAAIS is the most accurate and efficient model compared to RBFNN-2SATRAPSO and RBFNN-2SATRAGA in forecasting the price of palm oil. RBFNN-2SATRAAIS had the highest average overall accuracy (90.476190%), followed by RBFNN-2SATRAPSO (85.71%), and RBFNN-2SATRAGA (76.19%). The results also showed that the spot price of palm oil is highly influenced by the total exports and imports, as well as the production of palm oil, its end-stocks, and Malaysia’s real, effective exchange rate. By using the data mining technique based on the energy minimization technique, the logical mining task was carried out. The empirical findings provided useful insights into decision-making and policy implementations, including the formulation of strategies to help the industry in dealing with constant price fluctuations and, thereby, enabling the Malaysian palm oil industry to continue its domination over the international market.},
  keywords={Oils;Data mining;Forecasting;Prediction algorithms;Petroleum industry;Neurons;Genetic algorithms;Palm oil prices;economic growth;forecasting;artificial immune system;particle swarm optimization;genetic algorithm;radial basis functions neural network;2 satisfiability;2 satisfiability reverse;Analysis;logic mining},
  doi={10.1109/ACCESS.2021.3054816},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10837084,
  author={Singh, Sumit Kumar and Kant Sahu, Ravi and Sahoo, Soumya and Alam, Sarfaraz and Verma, Vivek and Tripathy, Hrudaya Kumar},
  booktitle={2024 International Conference on Intelligent Computing and Emerging Communication Technologies (ICEC)}, 
  title={Harnessing Sentiment Analysis and Deep Learning for Precise Stock Price Forecasts}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Stock market prediction has remained the subject of inquiry for a long time. Research intensified and new avenues were offered by the advent of computers and machine learning. By using easily accessible historical pricing and sentiment data, this research effort seeks to forecast stock share movements. The models were utilized: the GRU LSTM model that utilized past prices as its independent variable, and a Random Forest model that integrated sentiment analysis data obtained from Intensity Analyzer with other significant variables like the price of gold and oil, currency exchange rates, and policies of the Indian government. Securities returns were added for accuracy purposes. Predictions on the values of HDFC Bank, TCS, SBI-main, and four other shares were the final result. The models' effectiveness was evaluated using the RMSE metric.},
  keywords={Deep learning;Analytical models;Sentiment analysis;Accuracy;Social networking (online);Computational modeling;Predictive models;Data models;Forecasting;Stock markets;Random Forest;LSTM;Sentiment analysis;KNN;and GRU},
  doi={10.1109/ICEC59683.2024.10837084},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10816779,
  author={TP, Kauser Nissar and Sultana, Shaziya},
  booktitle={2024 8th International Conference on Computational System and Information Technology for Sustainable Solutions (CSITSS)}, 
  title={Advanced Techniques for Daily Gold Price Forecasting in India Through Statistical Analysis and Predictive Modeling}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Gold, a crucial asset in the Indian economy, is influenced by numerous factors, including economic indicators and market volatility. The methodology adopted in this study encompasses a comprehensive preprocessing framework tailored for the TFT model, effectively addressing challenges such as missing timesteps and incorporating key variables like the Consumer Price Index (CPI), USD to INR exchange rate, and other macroeconomic indicators that influence gold prices. The study involved conducting a thorough statistical analysis to understand the impact of these variables on gold prices, enabling the careful selection of features suitable for the model. A meticulous tuning of model parameters, including the learning rate, dropout rates, and hidden size, was carried out through a series of experimental trials aimed at optimizing performance. Each trial was evaluated based on several metrics, including Mean Absolute Error (MAE), Mean Absolute Percentage Error (MAPE), and Root Mean Squared Error (RMSE), leading to significant improvements in the model's predictive capabilities. Additionally, various baseline models such as ARIMA, Linear Regression, and LSTM were benchmarked against the TFT model using a dataset spanning from 2011 to September 2024. The findings reveal that the TFT model not only surpasses traditional forecasting methods but also provides an efficient framework for understanding the impact of economic fluctuations on gold prices. The study also emphasizes the importance of interpretability in forecasting models, utilizing techniques like attention mechanisms and variable importance analysis to offer deeper insights into the model's decision-making process.},
  keywords={Gold;Analytical models;Statistical analysis;Economic indicators;Predictive models;Data collection;Transformers;Data models;Thin film transistors;Forecasting;Gold Price Forecasting;Temporal Fusion Transformer (TFT);Time Series Forecasting;ARIMA;Linear Regression;LSTM;Attention Mechanisms;Variable Importance;Interpretability in Models},
  doi={10.1109/CSITSS64042.2024.10816779},
  ISSN={2767-1097},
  month={Nov},}@ARTICLE{9446053,
  author={Azam, Muhammad Furqan and Younis, Muhammad Shahzad},
  journal={IEEE Access}, 
  title={Multi-Horizon Electricity Load and Price Forecasting Using an Interpretable Multi-Head Self-Attention and EEMD-Based Framework}, 
  year={2021},
  volume={9},
  number={},
  pages={85918-85932},
  abstract={Accurate system marginal price and load forecasts play a pivotal role in economic power dispatch, system reliability and planning. Price forecasting helps electricity buyers and sellers in an energy market to make effective decisions when preparing their bids and making bilateral contracts. Despite considerable research work in this domain, load and price forecasting still remains to be a complicated task. Various uncertain elements contribute to electricity price and demand volatility, such as changes in weather conditions, outages of large power plants, fuel cost, complex bidding strategies and transmission congestion in the power system. Thus, to deal with such difficulties, we propose a novel hybrid deep learning method based upon bidirectional long short-term memory (BiLSTM) and a multi-head self-attention mechanisms that can accurately forecast locational marginal price (LMP) and system load on a day-ahead basis. Additionally, ensemble empirical mode decomposition (EEMD), a data-driven algorithm, is used for the extraction of hidden features from the load and price time series. Besides that, an intuitive understanding of how the proposed model works under the hood is demonstrated using different interpretability use cases. The performance of the presented method is compared with existing well-known techniques applied for short-term electricity load and price forecast in a comprehensive manner. The proposed method produces considerably accurate results in comparison to existing benchmarks.},
  keywords={Forecasting;Load modeling;Time series analysis;Predictive models;Computational modeling;Load forecasting;Casting;Deep learning;energy markets;ensemble empirical mode decomposition;multi-head self-attention;short-term load and price forecasting;Kalman smoothing;model interpretability},
  doi={10.1109/ACCESS.2021.3086039},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11159825,
  author={Ashour, Marwan Abdul Hameed and Juma, Ahlam Ahmed},
  booktitle={2025 IEEE 16th Control and System Graduate Research Colloquium (ICSGRC)}, 
  title={Enhancing Economic Forecasting in the Arab World with Artificial Intelligence}, 
  year={2025},
  volume={},
  number={},
  pages={161-166},
  abstract={This study explores the effectiveness of traditional and artificial intelligence (AI)-based time series forecasting methods in predicting key economic indicators, specifically inflation rates and consumer prices, in the Arab world. Given the economic volatility in the region-driven by fluctuating oil prices, global market dynamics, and geopolitical uncertainties-accurate inflation forecasting is essential for informed and responsive policy decisions. Traditional models such as ARIMA are widely used for capturing linear patterns and seasonal trends, yet they fall short in modeling the nonlinear structures inherent in complex economic data. To address these limitations, this paper proposes a hybrid forecasting model that combines the strengths of ARIMA for modeling linear components with the adaptive capabilities of a Nonlinear Autoregressive (NAR) neural network to capture nonlinear dependencies. The hybrid ARIMA-NAR model was evaluated against the standalone ARIMA model using Root Mean Square Error (RMSE) and Mean Absolute Percentage Error (MAPE) as performance metrics. Results indicate that the hybrid model achieved significantly lower forecast errors, with a $47.2 \%$ improvement in RMSE and a $28 \%$ improvement in MAPE compared to the traditional ARIMA model. These findings underscore the potential of AI-driven approaches in enhancing the accuracy of economic forecasts. Forecasts for inflation rates from 2024 to 2030 suggest a gradual decline, potentially signaling increased economic stability and the positive impact of ongoing policy reforms. The study contributes to the growing body of literature advocating for the integration of AI in economic modeling and offers valuable insights for policymakers and regulators in shaping evidence-based strategies to support sustainable economic growth across the Arab region.},
  keywords={Adaptation models;Accuracy;Economic indicators;Biological system modeling;Time series analysis;Artificial neural networks;Predictive models;Economic forecasting;Data models;Artificial intelligence;Economic forecasting;ARIMA;Artificial Intelligence (AI);Artificial Neural Networks (ANN);Inflation prediction;Time series analysis},
  doi={10.1109/ICSGRC65918.2025.11159825},
  ISSN={2833-1028},
  month={Aug},}@INPROCEEDINGS{8554642,
  author={Chaitanya Lahari, M and Ravi, Dhakate Hardik and Bharathi, R},
  booktitle={2018 International Conference on Advances in Computing, Communications and Informatics (ICACCI)}, 
  title={Fuel Price Prediction Using RNN}, 
  year={2018},
  volume={},
  number={},
  pages={1510-1514},
  abstract={The fuel market has its impact directly or indirectly on the income distribution of nations affecting stock market, cost of living, education, essential commodities and many more. Likewise, in reciprocation the fuel prices are affected by numerous factors that in-turn find way into the common mans' routine. Thus, there is a clear necessity to forecast the fuel price trends not just for the motorists good, but for the economists of any nation to predict the economic trends due to these price fluctuations and to be in a state of preparedness. However, forecasting the fuel prices involves stochastic model involving regressive analysis of several variables with many hidden relationships between them. Recurrent Neural Networks determines the underlying rationale for non-linearity by analyzing the hidden relationships between the contributing factors. Hence this project employs a Recurrent Neural network model to forecast the non-linearly varying fuel prices in major metropolitan cities of India.},
  keywords={Fuels;Support vector machines;Recurrent neural networks;Market research;Urban areas;Predictive models;Atmospheric modeling;Petrol;Diesel;Price forecast;Recurrent Neural Networks;Fuel Price India},
  doi={10.1109/ICACCI.2018.8554642},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{9580085,
  author={Srinivasan, Kaushik},
  booktitle={2021 12th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Trading Stocks or its Options - Analysis of Publicly Traded Oil Companies in India}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={The stock market is very volatile in nature. Traders thrive on this volatility by buying stock when they are low and selling high or by exercising options or trading the option contracts. This can only be done if market movement trends are known. Recent advances in deep learning and neural networks have remodeled the markets. This paper attempts to analyze the gains in buying stocks, call options and exercising options. Stock price movements of major oil conglomerates in India are forecasted namely Indian Oil Corporation, Oil and Natural Gas Corporation and Reliance Industries Limited, using a custom LSTM neural network. This stock prediction model is benchmarked against FOREX, Crude oil rates, historical data of companies and their major multinational oil suppliers, along with their financial news sentiments, of the past three years. The option pricing model uses the Monte Carlo simulation, similar to Black-Scholes Model to accurately determine the call option prices. The computational results of these implementations and most importantly their accuracies are deliberated.},
  keywords={Monte Carlo methods;Oils;Computational modeling;Neural networks;Pricing;Companies;Predictive models;Stock Market Prediction;Option Pricing;LSTM;Neural Network;Finance;Monte Carlo Simulation},
  doi={10.1109/ICCCNT51525.2021.9580085},
  ISSN={},
