@INPROCEEDINGS{10165018,
  author={Lv, Dong and Wang, Yuan and Xu, Fei and Zhang, Bing and Wang, Hongye and He, Li and Zhu, Hui and Li, Junhui},
  booktitle={2023 IEEE International Conference on Power Science and Technology (ICPST)}, 
  title={Day-Ahead Reporting Strategy of a Wind Power Plant Based on CEEMDAN-IPSO-LSTM}, 
  year={2023},
  volume={},
  number={},
  pages={813-818},
  abstract={In the new power system, the output of new energy power stations has strong volatility, which leads to huge deviation assessment expenditure. Therefore, based on the improved data preprocessing algorithm and deep learning algorithm, a day-ahead reporting strategy of wind power plants considering error prediction characteristics is proposed. Firstly, considering the historical real output and prediction error, the historical data is decomposed based on the complete noise-assisted ensemble empirical mode decomposition algorithm (CEEMDAN). Then, the components are introduced into the long short-term memory (LSTM) optimized by the improved particle swarm optimization algorithm (IPSO), and the components are reconstructed to obtain the original prediction curve and the error prediction curve. Finally, the empirical distribution function is used to revise the prediction error curve, and the original prediction curve and the error prediction curve are superimposed to obtain the final day-ahead report curve. The correctness and feasibility of the reporting strategy are verified by simulation analysis.},
  keywords={Empirical mode decomposition;Prediction methods;Wind power generation;Prediction algorithms;Power systems;Particle swarm optimization;Wind forecasting;deep learning;improved particle swarm optimization algorithm;empirical distribution function;day-ahead reporting strategy},
  doi={10.1109/ICPST56889.2023.10165018},
  ISSN={},
  month={May},}@INPROCEEDINGS{11297914,
  author={Htet, Thinzar and Kurubanjerdjit, Nilubon and Nupap, Soontarin and Htay, Tint Tint},
  booktitle={2025 22nd International Joint Conference on Computer Science and Software Engineering (JCSSE)}, 
  title={Comparison of Regression and Classification Models for Forecasting Thai Gold Prices}, 
  year={2025},
  volume={},
  number={},
  pages={256-261},
  abstract={Accurate forecasting of gold prices is essential for investors, policymakers, and businesses due to gold's role as a financial asset and market hedge. This study compares classification and regression models to predict Thai domestic gold prices using daily price data and macroeconomic indicators. Classification models were applied to forecast short-term trends ("Up," "Down," "Neutral"), while regression models predicted the actual price. A time-series cross-validation approach with lagged and rolling features captured temporal dependencies in the data. Results indicate that Ridge Regression (alpha=1) achieved the lowest mean absolute error and highest R2, demonstrating superior predictive performance for daily prices, while Logistic Regression achieved the highest F1-score for trend prediction. The findings highlight the effectiveness of regularised regression in modelling gold price dynamics and the challenges of trend classification due to market volatility and class imbalance.},
  keywords={Gold;Logistic regression;Accuracy;Predictive models;Market research;Transformers;Real-time systems;Macroeconomics;Forecasting;Software engineering;Gold price forecasting;classification;regression;Time-series prediction;Feature engineering;Thailand},
  doi={10.1109/JCSSE67377.2025.11297914},
  ISSN={2642-6579},
  month={Nov},}@ARTICLE{11058928,
  author={Hosseini, Seyed Ali and Grimaccia, Francesco and Niccolai, Alessandro and Trimarchi, Silvia},
  journal={IEEE Access}, 
  title={Pattern-Based Feature Extraction for Improved Deep Learning in Financial Time Series Classification}, 
  year={2025},
  volume={13},
  number={},
  pages={113343-113355},
  abstract={In this paper, the authors introduce a novel feature extraction method based on pattern detection in financial data to enhance the performance of deep learning models for financial time series classification. Existing financial forecasting models often struggle with the inherent volatility and complexity of financial markets, particularly due to their reliance on traditional financial data features which fail to capture intricate price patterns. This research addresses the critical gap in effectively identifying and leveraging these patterns to improve predictive accuracy. By collecting tick-by-tick data from the European Carbon Emission Allowance market and resampling it to a 15-minute timeframe, we developed a method to detect pivotal price patterns and extract relevant features. Integrating these features with traditional open, high, low, close, and volume (OHLCV) data in long-short-term memory (LSTM) and gated recurrent unit (GRU) combined with dense neural networks, our empirical results demonstrate significant improvements in model performance, showcasing enhanced accuracy compared to models using only traditional data features.},
  keywords={Feature extraction;Forecasting;Predictive models;Long short term memory;Data models;Accuracy;Biological system modeling;Market research;Time series analysis;Deep learning;Energy market;financial pattern extraction;financial feature extraction;deep learning;financial data classification},
  doi={10.1109/ACCESS.2025.3584251},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10987293,
  author={Tiwari, Priyanshu and Patil, Soumya and Ambareesh, S and Raj, Rishabh},
  booktitle={2025 International Conference on Artificial Intelligence and Data Engineering (AIDE)}, 
  title={Optimizing FAANG Stock Forecasting: The Power of Feature Engineering and LSTM in Financial Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={410-416},
  abstract={The unprecedented growth and market capitalization of the FAANG stocks - Facebook, Amazon, Apple, Netflix, and Google (Alphabet) - have mushroomed into the pay-off race of the leaders of the global financial market. Stock price volatility prediction attracts the focus of the investors and analysts in the pursuit of profit maximization relying on market movements. In order to enhance the precision of stock price predictions for FAANG companies, other more intricate methods for feature engineering are also coupled together with LSTM neural networks. Stock price dynamic intricacies are being reflected by the model using the complete set of financial indicators, predictive analytics, and market sentiment data as features. The work showed a phenomenal application of LSTM networks in the analysis and prediction of stock price trends compared to the classic methods on the sequential-by-nature front dealing with long dependencies. It is actually possible to build a strong base of data enabling the detection of such elusive trends in the performances of FAANG stocks and technical indicators, sentiment analysis, or economic metrics, for instance, thereby getting into working order for LSTM modeling. Results from experiments show the method provides better accuracy and reliability than conventional machine learning models, thus collecting valuable insights for certain financial-forecasting purposes. The paper serves as a demonstration illustrates how feature engineering and LSTM might be combined to improve predicting financial markets and provides one solution for investors, financial analysts, and policymakers who look to make informed investment decisions.},
  keywords={Analytical models;Accuracy;Data preprocessing;Machine learning;Predictive models;Market research;Data models;Forecasting;Long short term memory;Investment;Deep-learning;EDA;FAANG;LSTM;Machine-learning;Nifty;Stock},
  doi={10.1109/AIDE64228.2025.10987293},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{8469954,
  author={Fidalgo, J. Nuno and Da Rocha, Eduardo F. N. R.},
  booktitle={2018 15th International Conference on the European Energy Market (EEM)}, 
  title={Improving Electricity Price Forecasting Trough Data Segmentation Based on Artificial Immune Systems}, 
  year={2018},
  volume={},
  number={},
  pages={1-5},
  abstract={The price evolution in electricity market with large share of renewables often exhibits a deep volatility, triggered by external factors such as wind and water availability, load level and also by business strategies of market agents. Consequently, in many real applications, the performance of electricity price is not appropriate. The goal of this article is to analyze the available market data and characterize circumstances that affect the evolution of prices, in order to allow the identification of states that promote price instability and to confirm that class segmentation allows increasing forecast performance. A regression technique (based on Artificial Neural Networks) was applied first to the whole set and then to each class individually. Performances results showed a clear advantage (above 20%) of the second approach when compared to the first one.},
  keywords={Forecasting;Artificial intelligence;Detectors;Artificial neural networks;Production;Immune system;Electricity supply industry;Electricity markets;artificial immune systems;clustering;neural networks;price forecasting},
  doi={10.1109/EEM.2018.8469954},
  ISSN={2165-4093},
  month={June},}@ARTICLE{10858154,
  author={Amiri, Babak and Haddadi, Amirali and Farajpour Mojdehi, Kosar},
  journal={IEEE Access}, 
  title={A Novel Hybrid GCN-LSTM Algorithm for Energy Stock Price Prediction: Leveraging Temporal Dynamics and Inter-Stock Relationships}, 
  year={2025},
  volume={13},
  number={},
  pages={24815-24832},
  abstract={Energy stock price prediction is a pivotal challenge in financial forecasting, characterized by high volatility and complexity influenced by geopolitical factors, regulatory shifts, and sector-specific issues. Traditional methods often struggle to account for the intricate dependencies and temporal patterns present in energy stock data. To address these limitations, this study introduces a hybrid model that integrates a Graph Convolutional Network (GCN) with an attention-enhanced Long Short-Term Memory (LSTM) architecture. By employing a graph structure derived from Dynamic Time Warping (DTW), the GCN captures inter-stock relationships, while the attention mechanism within the LSTM component refines the modelling of temporal dynamics, allowing the model to focus on the most relevant historical information. Experimental evaluations across multiple energy stocks show that this combined LSTMGC model significantly outperforms conventional approaches- including Linear Regression, GRU, MLP, and standalone LSTMs- when assessed using Mean Squared Error (MSE) and R-squared (R2) metrics. By jointly leveraging spatial and temporal dependencies, as well as the selective attention mechanism, the proposed framework enhances predictive accuracy and reliability, offering valuable insights for investors and policymakers navigating the evolving energy market.},
  keywords={Predictive models;Long short term memory;Analytical models;Accuracy;Forecasting;Data models;Machine learning;Time series analysis;Sentiment analysis;Deep learning;Stock price;energy;graph neural networks;long short-term memory;dynamic time warping;graph convolutional networks},
  doi={10.1109/ACCESS.2025.3536889},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11203773,
  author={Khan, Inam Ullah and Jamil, Mohsin},
  booktitle={2025 IEEE 13th International Conference on Smart Energy Grid Engineering (SEGE)}, 
  title={Hybrid Long Short-Term Memory (LSTM) and Exponentially Weighted Moving Average (EWMA) Model for Accurate and Scalable Electricity Price Forecasting}, 
  year={2025},
  volume={},
  number={},
  pages={107-111},
  abstract={Accurate electricity price forecasting is critical for market participants seeking to optimize bids and manage risk in increasingly volatile energy markets. This paper proposes a hybrid machine learning framework that integrates Long ShortTerm Memory (LSTM) networks with Exponentially Weighted Moving Average (EWMA) volatility smoothing. The framework optimizes bid strategy formulation for Battery Energy Storage System (BESS) operators in electricity markets, thereby enhancing market participation efficiency. The model was trained and validated on historical Austrian market data including wholesale electricity price, frequency containment reserve price, electrical load, gas price, radiation, temperature, and wind speed. This approach directly supports more informed decision-making for local traders and operators. Model training was accomplished through 64,500 iterations over 6.1 hours, utilizing a variable learning rate and MATLAB’s Deep Learning Toolbox to accelerate convergence. The computational process was executed on a dedicated Intel Core i9-14900HX/NVIDIA RTX 4060 platform, demonstrating that the approach is both scalable and suitable for real-time deployment scenarios with intra-day retraining requirements. The hybrid model achieves a root mean square error (RMSE) of 1.2207 €/MWhe, outperforming several established benchmarks while providing year-forward price forecasts with hourly resolution.},
  keywords={Training;Accuracy;Battery energy storage system;Electricity;Computational modeling;Predictive models;Mathematical models;Forecasting;Long short term memory;Load modeling;Electricity;Energy;Commodity Pricing;Forecasting;Finance;Battery Energy Storage System (BESS);Optimization;Operations Research;Smart Grid;Artificial Intelligence;Volatility},
  doi={10.1109/SEGE65970.2025.11203773},
  ISSN={2575-2693},
  month={Aug},}@INPROCEEDINGS{11003306,
  author={Kochsuwan, Krist and Nonsiri, Sarayut and Kanignant, Tanyaporn},
  booktitle={2025 17th International Conference on Knowledge and Smart Technology (KST)}, 
  title={Machine Learning Techniques for Renewable Energy Forecasting in Thailand}, 
  year={2025},
  volume={},
  number={},
  pages={382-387},
  abstract={The effects of global warming have led to increasing environmental issues caused by the release of greenhouse gases, primarily from the use of fossil fuels, which remain the main energy source for humans. The volatility of crude oil and natural gas prices is influenced by global economic conditions, currency exchange rates, geopolitical issues, climate, and the fact Thailand's fossil fuel production capacity is insufficient to meet domestic demand. Therefore, transitioning from fossil fuels to renewable and alternative energy source becomes increasingly important. This study applied machine learning models, including Extremely Randomized Trees (ERT), Extreme Gradient Boosting (XGB), Light Gradient Boosting (LGB), Support Vector Regression (SVR), Recurrent Neural Networks (RNN), and Prophet to forecast total renewable electricity production (TREEP), total electricity consumption (TEC) and Proportion of TREEP and TEC (PTT) using meteorological data, economic indices, and population data. The goal is to predict the PTT value in Thailand over a 12-month period for decision-making by government agencies involve in the development and support of renewable energy. The results are shown Prophet suitable for TREEP, TEC and the PTT with MAPE of $2.709 \%, 4.098 \%$, and 3.236 %, respectively.},
  keywords={Support vector machines;Renewable energy sources;Recurrent neural networks;Electricity;Time series analysis;Weather forecasting;Production;Predictive models;Boosting;Forecasting;renewable energy;forecasting;machine learning;multivariate time series;electricity consumption},
  doi={10.1109/KST65016.2025.11003306},
  ISSN={2473-764X},
  month={Feb},}@INPROCEEDINGS{11589616,
  author={Wang, Zhikun and Hua, Haochen and Zhou, Yang and Zheng, Jin},
  booktitle={2026 22nd International Conference on the European Energy Market (EEM)}, 
  title={Probabilistic Forecasting of Day-Ahead Electricity Prices in Germany: A Hybrid Deep Learning and Mixture Distribution Approach}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The increasing integration of renewable energy has introduced severe volatility to day-ahead electricity markets, characterized by zero-price agglomerations and highly asymmetric tail risks. Traditional models struggle to capture these complex dynamics. This paper proposes a novel two-stage hybrid probabilistic forecasting framework. First, an Informer neural network efficiently extracts long-range deterministic trends. Second, the forecasting residuals are modeled using a conditional zero-inflated skewed-t distribution. The distribution’s shape parameters are explicitly mapped to fundamental physical drivers via generalized linear models (GLM) and calibrated by minimizing the continuous ranked probability score (CRPS). Evaluated on the highly volatile German1|5-minute market, the proposed framework exhibits profound physical interpretability and exceptional probabilistic calibration. It effectively hedges against deep negative prices and dynamically adjusts prediction intervals to envelop extreme spikes, providing a robust risk management tool.},
  keywords={Modeling;Forecasting;Pricing;Energy;Printing;Electricity;Equations;Optimization;Poles and zeros;Power markets;Continuous ranked probability score;day-ahead electricity market;Informer;probabilistic forecasting;zeroinflated skewed-t distribution},
  doi={10.1109/EEM68581.2026.11589616},
  ISSN={2165-4093},
  month={June},}@INPROCEEDINGS{11701797,
  author={Sarpong-Streetor, Richard Manu Nana Yaw and Sokkalingam, Rajalingam and Daud, Hanita and Asirvadam, Vijanth Sagayan and Zainudin, Nooraini and Ackah, Ishmael and Oppong, Riverson and Rashid, Alidu},
  booktitle={2026 10th International Conference on Computing, Communication, Control & Automation (ICCUBEA)}, 
  title={Spatio-Temporal Forecasting and Control for Global Petroleum Energy Markets Using Hybrid Multi-Agent Graph-Based Reinforcement Learning Models-A Mathematical Framework}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Global petroleum fuel pricing, increasingly governed by deregulated market regimes, exhibits significant volatility driven by crude oil prices, exchange rates, and shifting supply-demand conditions. These dynamics require advanced models capable of capturing both spatial interdependencies and temporal evolution across global markets. This paper proposes a mathematical framework for spatio-temporal forecasting and control using hybrid multi-agent graph-based reinforcement learning. Global fuel markets are modeled as graph-structured systems, enabling the representation of interactions between geographically distributed nodes alongside their time-dependent behavior. Multi-agent reinforcement learning introduces adaptive decision-making, supporting both forecasting and control under dynamic conditions. To demonstrate the framework, a Graph Attention Network with Gated Recurrent Units (GAT-GRU) is implemented. The model effectively integrates spatial attention and temporal sequence learning, achieving improved predictive performance. The results validate the framework's capability, offering a scalable foundation for analyzing and forecasting complex global energy markets.},
  keywords={Equations;Modeling;Tagging;Pricing;Printing;Fuels;Forecasting;Optimization;Reinforcement learning;Lubricating oils;Multi-Agents;Graph;Petroleum Prices;Reinforcement Learning;Mathematical Framework},
  doi={10.1109/ICCUBEA69821.2026.11701797},
  ISSN={2771-1358},
  month={Aug},}@INPROCEEDINGS{11082181,
  author={Liu, Yuhao and Sun, Yu and Tian, Liwei and Wang, Baoping},
  booktitle={2025 IEEE 34th Wireless and Optical Communications Conference (WOCC)}, 
  title={Research on the Application of Purchasing Management in W Company Based on Deep Learning}, 
  year={2025},
  volume={},
  number={},
  pages={209-214},
  abstract={Polyester Pre-Oriented Yarn (POY) is a fundamental and essential raw material in the polyester fiber industry and serves as one of the primary inputs for China’s textile sector. Due to the oligopolistic nature of upstream suppliers, downstream enterprises have limited bargaining power, making POY price fluctuations a significant factor affecting the procurement costs of Company W. To manage procurement strategically, Company W must aggregate and analyze market supply and demand information to optimize its raw material purchasing plans.In response to this challenge, this study employs a hybrid CEEMDAN-BO-LSTM model to perform time series forecasting. Based on the predicted POY price trends for the first quarter of 2025, and considering Company W's demand, a Deep Q-Network (DQN) from reinforcement learning is utilized to develop an optimized procurement strategy aimed at minimizing total procurement cost. The strategy includes both scheduling of procurement time points and allocation of purchase quantities. A strategic procurement plan for the first quarter of 2025 is developed and compared against traditional procurement approaches. The results demonstrate that the proposed method significantly contributes to risk mitigation and cost control in procurement, offering tangible cost-saving benefits. This strategy can serve as a practical reference for other companies seeking to enhance their strategic procurement processes.},
  keywords={Procurement;Wireless communication;Costs;Time series analysis;Companies;Reinforcement learning;Predictive models;Raw materials;Yarn;Forecasting;LSTM;Time series model;Dynamic procurement;Reinforcement learning},
  doi={10.1109/WOCC63563.2025.11082181},
  ISSN={2379-1276},
  month={May},}@INPROCEEDINGS{11546129,
  author={Singh, Ashwani and Manon, Aldrin and Pothen, Bincy and Tiwari, Shivshankar and Kumar, Mohit},
  booktitle={2026 IEEE 2nd International Conference on Quantum Photonics, Artificial Intelligence & Networking (QPAIN)}, 
  title={Forecasting Rupee Volatility: An Integrated Machine Learning Framework for Strategic Financial Management}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Exchange rate volatility: The exchange rate especially between the US Dollar and the Indian Rupee (USD/INR) is a great problem in terms of financial planning and risk management in the emerging markets such as India. This paper introduces a combined machine learning model of predicting Rupee volatility using sophisticated procedural designs to enhance the degree of prediction and decision making among corporate and government entities. The framework works on the basis of Long Short-Term Memory neural networks to predict the exchange rate dynamics and compares the performance of LSTM to classical models, including Autoregressive Integrated Moving Average and the Random Walk model. LSTM model is tested through walk-forward, Diebold-Mariano, and metrics based on financial data, and proves to reduce the Root Mean Squared Error by 38 percent as compared to ARIMA. Moreover, LSTM has better economic value, a Sharpe of 0.50 and a Kelly Growth of 0.22 are higher, and risk-adjusted returns are better. The results indicate that machine learning tools, in particular, LSTM, can contribute greatly to financial prediction, which provides a superior ability to manage risk, budget, and decision-making in the private and government sectors. It could be of use in addressing the challenges of financial risks related to the changes in the exchange rates because this research suggested a powerful and statistically sound method of predicting the exchange rate fluctuations.},
  keywords={Modeling;Machine learning;Long short term memory;Printing;Timing;Machining;Forecasting;Exchange rates;Testing;Conferences;Exchange Rate Forecasting;Machine Learning;LSTM;Financial Risk Management;USD/INR;Public Sector Finance},
  doi={10.1109/QPAIN69676.2026.11546129},
  ISSN={},
  month={April},}@INPROCEEDINGS{10161960,
  author={Levikari, Saku and Nykyri, Mikko and Kärkkäinen, Tommi J. and Honkapuro, Samuli and Silventoinen, Pertti},
  booktitle={2023 19th International Conference on the European Energy Market (EEM)}, 
  title={Load Forecasting in Nordic Residential Buildings}, 
  year={2023},
  volume={},
  number={},
  pages={1-8},
  abstract={Renewable power production technologies, such as solar photovoltaics, are becoming increasingly popular in the residential sector. Due to the volatility of renewable power production, and mismatch between peak production and consumption hours, it can be beneficial to augment local power production with energy storage systems, such as batteries. Connection to mains grid also facilitates selling overproduction, especially when the price of electricity is high. However, such a system requires automated decision making, which would highly benefit from knowing the state of electrical load, price and solar power production in advance. This study focuses specifically on the task of load forecasting, applied to Nordic multifamily residential buildings, which are mainly heated by district heating. While it is common to utilize weather data for load forecasting, this work shows by properly choosing and optimizing the forecast model, omitting the weather data can in this case improve the accuracy of the forecasts.},
  keywords={Renewable energy sources;Load forecasting;District heating;Buildings;Weather forecasting;Production;Predictive models;Battery energy storage systems;microgrids;load forecasting},
  doi={10.1109/EEM58374.2023.10161960},
  ISSN={2165-4093},
  month={June},}@INPROCEEDINGS{11385370,
  author={Xiang, Yang and Chong, Lei},
  booktitle={2025 6th International Conference on Smart Grid and Energy Engineering (SGEE)}, 
  title={Research on Optimization of Enterprise Electricity Consumption Strategy and Cost Control Based on Electricity Price Signal}, 
  year={2025},
  volume={},
  number={},
  pages={722-726},
  abstract={Against the backdrop of the deepening reform of the energy market, which has triggered sharp fluctuations in electricity prices, the electricity costs of large electricityconsuming enterprises have surged dramatically, and traditional electricity consumption models struggle to adapt to the dynamic electricity price environment. To address this issue, this paper proposes an integrated optimization model featuring “data-driven -predictive modeling-strategy optimization-collaborative regulation”: by analyzing enterprises' electricity consumption characteristics and leveraging high-precision models to accurately predict future electricity loads and prices, it establishes a dynamic electricity price classification and load priority mechanism, and further integrates demand response and energy storage systems to form a comprehensive electricity optimization solution. Taking energy conservation and emission reduction as the means to regulate electricity consumption strategies, this model not only reduces enterprises' electricity costs but also contributes to the achievement of the “dual carbon” goals; comparative experiments have verified its favorable application effects.},
  keywords={Costs;Fluctuations;Electricity;Collaboration;Predictive models;Demand response;Data models;Forecasting;Load modeling;Energy storage;Load Forecasting;Electricity price forecasting;Time-of-Use Electricity Price;Demand Response;Optimal Scheduling},
  doi={10.1109/SGEE68429.2025.11385370},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11048313,
  author={Rafi, Md Samuru and N, Siddharth and K, Hrushikesh Raju and Sidhwa, H. H.},
  booktitle={2025 International Conference on Recent Advances in Electrical, Electronics, Ubiquitous Communication, and Computational Intelligence (RAEEUCCI)}, 
  title={AI-Driven Currency Arbitrage Optimization System and Correlation Risk Using Statistical Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The increasing complexity of global financial markets and their need for advanced techniques for currency arbitrage and risk assessment. This research delivers an AI-based currency arbitrage optimizer which implements XGBoost and LSTM models for USD/INR and USD/JPY and JPY/INR currency markets prediction. The system utilizes Bellman-Ford, which is a Garch(1,1) model to find profitable currency arbitrage opportunities from forecasted values while the Bellman-Ford algorithm creates trade routes using linear programming and risk evaluation relies on Sharpe Ratio and Monte Carlo Simulation. The evaluation of volatility spillover effects between two oil-based economies relies on statistical techniques which include GARCH modeling for performing correlation risk analysis. The evaluation of our experimental approach performed using historical forex data from twenty years revealed enhanced accuracy in forecasts while generating better risk-adjusted returns.},
  keywords={Analytical models;Exchange rates;Correlation;Accuracy;Biological system modeling;Predictive models;Linear programming;Risk management;Currencies;Long short term memory;Arbitrage;Exchange rate;LSTM;XGBoost;Linear programming;Bellman-ford;Correlation risk;GARCH;Volatility;Risk Assessment;statistics;Market anomalies},
  doi={10.1109/RAEEUCCI63961.2025.11048313},
  ISSN={},
  month={April},}@ARTICLE{11006081,
  author={Dash, Ritesh and Sinha, Anupa and Jyotheeswara Reddy, K. and Dhanamjayulu, C. and Kamwa, Innocent},
  journal={IEEE Access}, 
  title={Dynamic Modeling and Quantum-Enhanced Forecasting of Multi-Seasonal Energy Prices in Simulated Microgrid Environments}, 
  year={2025},
  volume={13},
  number={},
  pages={90362-90388},
  abstract={The study address the challenge of forecasting per unit energy prices in a microgrid environment consisting of solar and hydro power resources under multi-seasonal variations. Traditional deep learning techniques such as LSTM, GRU and ESN often struggle with non-linear dependencies and volatility in energy market. To overcome these we propose a hybrid framework incorporating Adiabatic Quantum Computing (AQC) for electricity price forecasting. The proposed AQC model encodes-32 system and market related variables into quantum states and applies adiabatic evolution to derive optimized price prediction. Simulation results using real microgrid data set-up based on HIL shows that AQC reduces forecasting error by 17.03% compared to LSTM, 14.29% to GRU and 13.88% to ESN over 24-hrs and 48-hrs horizons. The enhanced accuracy and robustness of the quantum assisted model demonstrates its potential for next generation energy market forecasting and decisions making tool. The entire framework is tested using a synthetic microgrid dataset designed to emulate real-world seasonal and operational dynamics. While this enables controlled validation of the models, the generalizability of the results to real world deployment requires further empirical evaluations on physical microgrid data set.},
  keywords={Predictive models;Forecasting;Load modeling;Quantum computing;Electricity;Data models;Analytical models;Microgrids;Long short term memory;Computational modeling;AQC;LSTM;GRU;ESN;spot market;energy trading;microgrid},
  doi={10.1109/ACCESS.2025.3570719},
  ISSN={2169-3536},
  month={},}@ARTICLE{10637406,
  author={Alsheebah, Fikry Mansour M. and Al-Fuhaidi, Belal A.},
  journal={IEEE Access}, 
  title={Emerging Stock Market Prediction Using GRU Algorithm: Incorporating Endogenous and Exogenous Variables}, 
  year={2024},
  volume={12},
  number={},
  pages={132964-132971},
  abstract={Stock market prediction poses significant challenges due to the inherent noise and volatility of the data. These challenges are further amplified in emerging stock markets, where data volatility increases due to numerous endogenous and exogenous variables. Despite the progress made in models for stock market prediction, such as Autoregressive Integrated Moving Average (ARIMA), Support Vector Machines (SVMs), and deep learning models, there is still a need for further research in emerging stock markets. This study addresses the complexity and non-linearity of emerging stock market data by proposing a deep learning model that utilizes Gated Recurrent Unit (GRU) algorithm to predict the next-day closing price. The proposed model leverages the inclusion of exogenous variables to enhance the model’s performance. Three datasets are constructed for three main emerging market indices, specifically in Qatar, Saudi Arabia, and China. Using mean absolute percentage error (MAPE), the inclusion of exogenous variables led to a noticeable improvement over the related work results from 0.74, 1.68, and 0.72 for indices of Qatar, Saudi Arabia, and China respectively to 0.16, 0.6, and 0.2. Furthermore, the results demonstrate the appropriateness of GRU algorithm for predicting emerging stock markets.},
  keywords={Stock markets;Indexes;Biological system modeling;Logic gates;Predictive models;Neural networks;Deep learning;Emerging stock market prediction;GRU;time series data},
  doi={10.1109/ACCESS.2024.3444699},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11385720,
  author={Kumar, Suresh and Kumar, Pardeep and Sidhu, Renu and Kumari, Neha and Kaur, Swapandeep and Singh, Kawal Nain},
  booktitle={2025 International Conference on Innovations and Emerging Technologies In AI & Communication Systems (IETACS)}, 
  title={Empirical Analysis of AI Methods of Forecasting financial Times Series: A Research on LSTM and ML models in Indian Stock, Commodity and Energy Prices}, 
  year={2025},
  volume={},
  number={},
  pages={800-805},
  abstract={The present paper provides an empirical analysis of the methods of Artificial Intelligence (AI) predicting the financial time series data in the Indian context, namely the use of Long Short-Term Memory (LSTM) neural network, Random Forest Regression, and Support Vector Machines (SVM). There are four main variables of the study that are the NIFTY 50 stock index, the historical gold price, the price of crude oil and the price of natural gas which represent important sectors of the Indian economy. The paper demonstrates that the AI models outperform the conventional econometric models (such as ARIMA and Ordinary Least Squares (OLS) regression), significantly in terms of accuracy of predictions, sensitivity to volatility, and the ability to fit non-linearity in the actions of variables. LSTM reduced the Root Mean Square Error (RMSE) by more than 50 percent in stock market forecasts when compared to ARIMA and the machine learning model improved the prediction performance of credit default by 17 percent compared to the logistic regression model. This research uses a mixed methods design, an Integrative survey, blending model-based performance evaluation with the qualitative contributions of 100 stakeholders in the Indian financial institutions, fintech affiliates, and regulatory authority. These findings reveal a wide optimism in terms of AI to enhance risk management and make the operations more efficient and also highlight the consistent concerns about data protection, clean governance and institutional readiness. The paper concludes by calling on the urgency of explainable AI systems (XAI), effective regulatory strategies, and industry synergies so that ethically and sustainably AI should be applied in the financial sector of forecasting, particularly in the emerging economies, such as India.},
  keywords={Support vector machines;Surveys;Explainable AI;Biological system modeling;Time series analysis;Neural networks;Predictive models;Forecasting;Stock markets;Long short term memory;Artificial Intelligence;Financial forecasting;Machine Learning;Time Series;LSTM Neural Networks},
  doi={10.1109/IETACS68750.2025.11385720},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11050338,
  author={Papadopoulos, Demetrios N. and Qussous, Ramiz and Weidlich, Anke},
  booktitle={2025 21st International Conference on the European Energy Market (EEM)}, 
  title={Harnessing Automl for Electricity Price Forecasting in Germany: A Comparative Analysis of Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Electricity price forecasting is crucial for energy market stakeholders, facilitating informed decisions in trading, investment, and operational planning to optimize portfolios and ensure grid stability. Machine learning (ML) models have proven effective for this task, but their deployment often demands substantial computational resources and expertise in both energy markets and ML techniques. Automated Machine Learning (AutoML) addresses these challenges by automating key steps like feature engineering, preprocessing, model selection, and hyperparameter tuning. This study evaluates the performance of three leading AutoML frameworks-Auto-sklearn, TPOT, and FLAML-for day-ahead electricity price forecasting in Germany, focusing on the year 2024. The evaluation includes testing during two distinct periods characterized by high and low price volatility. By incorporating domain-specific features, these frameworks are benchmarked against a Multi-Layer Perceptron (MLP) to assess their viability in comparison to traditional neural networks. The findings aim to provide insights into the scalability and effectiveness of AutoML for complex, data-intensive forecasting tasks, offering practical solutions for navigating the challenges of Germany's dynamic electricity market.},
  keywords={Electricity;Computational modeling;Scalability;Predictive models;Automated machine learning;Electricity supply industry;Stability analysis;Stakeholders;Forecasting;Tuning;Electricity Market;AutoML;Price Forecasting},
  doi={10.1109/EEM64765.2025.11050338},
  ISSN={2165-4093},
  month={May},}@INPROCEEDINGS{11655166,
  author={Peng, Jiayi and Ma, Yanna and Wei, Wei and Wang, Hongxia and Hu, Mengyao and Shao, Yupeng and Shao, Bilu and Junfang, Fang},
  booktitle={2026 IEEE 9th International Conference on Big Data and Artificial Intelligence (BDAI)}, 
  title={A Hybrid Computational Intelligence Framework for PTA Futures Price Forecasting with Ridge Residual LSTM-Forest}, 
  year={2026},
  volume={},
  number={},
  pages={450-454},
  abstract={Purified terephthalic acid (PTA) futures forecasting is a challenging computational intelligence problem because prices are jointly driven by upstream crude oil and para-xylene costs, downstream polyester demand, spot-futures basis, market sentiment, and trading behavior. The resulting series contains linear autocorrelation, nonlinear residual patterns, feature redundancy, and regime-dependent volatility. This paper proposes a hybrid computational intelligence framework for next-day PTA futures price forecasting. The framework combines a Ridge linear anchor with a random-forest-screened LSTM ensemble, referred to as LSTM-Forest. Ridge regression first extracts the dominant linear component from all engineered features, while the LSTM-Forest module learns the remaining nonlinear residual from selected features and rolling historical windows. A double Bollinger-band module is further used to evaluate the decision-support value of the predicted price curve. Using daily PTA futures data from December 2006 to April 2026, with training data up to 2024, validation data in 2025, and testing data from January to April 2026, the selected configuration achieves a test MAE of 76.08 CNY per ton, RMSE of 107.07 CNY per ton, MAPE of 1.23 percent, directional accuracy of 67.11 percent, and correlation of 0.9889. Benchmark and ablation experiments show that linear models are strong competitors, random-forest feature screening improves the LSTM-Forest module, and derivative loss does not provide stable gains under the current setting. The results indicate that residual learning is an interpretable way to integrate linear structure, neural ensemble learning, and trading-signal analysis for commodity futures forecasting.},
  keywords={Modeling;Forecasting;Long short term memory;Pricing;Printing;Forests;Testing;International trade;Equations;Random forests;computational intelligence;PTA futures;financial time-series forecasting;residual learning;Ridge regression;LSTM-Forest;random forest feature selection;neural ensemble},
  doi={10.1109/BDAI70753.2026.11655166},
  ISSN={},
  month={July},}@INPROCEEDINGS{9943925,
  author={Aun, Yichiet and Khaw, Yen-Min Jasmina and Gan, Ming Lee and Chern, Debra Lee Hooi},
  booktitle={2022 5th International Conference on Data Science and Information Technology (DSIT)}, 
  title={A Machine-Learning Ensemble Method for Temporal-aware Sales Forecasting}, 
  year={2022},
  volume={},
  number={},
  pages={1-7},
  abstract={Machine-learning-driven sales forecasting is gaining momentum in inventory management based on customer shopping behaviors. However, it is difficult to build a one-size-fits-all sales forecasting model for general purpose use due to the volatility of product turnaround and complex consumer behaviors. Traditionally, single forecasting models such as ARIMA modeling are used to predict sales. However, existing models have little real- world applicability given the apparent forecast disparity between experimental and real-world predictions due to model overfitting. This project proposes an ensemble Machine-learning method using weighted XGBoost, ARIMA, and Holt-Winters for sales forecasting of a grocery chain to address model overfitting issues. The intuition of the work is to combine several ML models to reduce variance (bagging), bias (boosting), and improve predictions (stacking). The contribution of this work includes: (1) implementation of exploratory modeling for in-depth exploratory data analysis (EDA) in grocery datasets and (2) feature engineering for the weighted integration of designed forecasting models using a lag and sliding window techniques. The preliminary result of the research places the model developed at the 70th percentile of the Corporacion Favorita Sales Forecasting Competition in Kaggle.},
  keywords={Analytical models;Profitability;Oils;Stacking;Predictive models;Inventory management;Data models;sales forecasting;machine-learning;ensemble;time series;big data},
  doi={10.1109/DSIT55514.2022.9943925},
  ISSN={},
  month={July},}@INPROCEEDINGS{9492201,
  author={Lai, Shanyan and Jiang, Hongyu and Ye, Chunyang and Zhou, Hui},
  booktitle={2021 International Conference on Service Science (ICSS)}, 
  title={Chinese stock market prediction based on multifeature fusion and TextCNN}, 
  year={2021},
  volume={},
  number={},
  pages={59-64},
  abstract={Stock trend forecasting plays a great role in maximizing the profit of stock investment. However, due to the high volatility and non-stationarity of the stock market, accurate trend prediction is very difficult. With the development of the Internet and deep learning technology, people can use deep learning methods to reveal market trends and volatility from the explosive information on the Internet. Unfortunately, there is a large amount of content related to the stock market, and a large part of it is useless information. As a result, how to extract the effective information and combine this information as different characteristics to effectively predict stock trends has become the biggest challenge. In order to cope with these challenges, we use TextCNN as the news text feature extractor for feature extraction of news information, and propose a prediction method based on multi-feature fusion: Bi-LSTNAA, to predict the Chinese stock market. Extensive experiments on actual stock market data show that the our method has a greater improvement in the accuracy of stock trend prediction.},
  keywords={Deep learning;Predictive models;Feature extraction;Market research;Explosives;Internet;Data mining;Stock trend forecast;feature fusion;News feature extraction},
  doi={10.1109/ICSS53362.2021.00017},
  ISSN={},
  month={May},}@INPROCEEDINGS{9432090,
  author={Mishra, Pramod K.},
  booktitle={2021 5th International Conference on Intelligent Computing and Control Systems (ICICCS)}, 
  title={Predicting Agri-Food Prices with Time-Series and Data-Mining based Methods}, 
  year={2021},
  volume={},
  number={},
  pages={1127-1134},
  abstract={Onion, potato and tomato (OPT) are some of the most essential commodities of every Indian household due to their affordability and need. But most of the times it has been seen that the prices fluctuate throughout the year and sometimes affording some of these items become difficult for a typical middle-class family in India. Especially, the case of onion, being a food item in most of the households, the market behaves very erratically and is a matter of concern. There is hardly any concrete evidence available why the price of onion fluctuates drastically leading to consumers' grief. In this paper, the price of onion has been modeled using Winters' and (S)ARIMA(X) (auto-regressive integrated moving average method with seasonality (S) and exogenous variable (X)) algorithms using Python. The paper has tried to predict the prices and cites some of the causes for such fluctuations. It is observed when supply/arrival has no major role in the price fluctuations; there the volatile wholesale price is statistically significant causing the higher price fluctuations. The question behind high wholesale price fluctuations, given constant/relatively constant supply, is a matter of further supply chain research.},
  keywords={Exchange rates;Fluctuations;Supply chains;Time series analysis;Optimized production technology;Predictive models;Prediction algorithms;Agri-food price;Time series data;Prediction;Machine learning;Prediction accuracy},
  doi={10.1109/ICICCS51141.2021.9432090},
  ISSN={},
  month={May},}@INPROCEEDINGS{10754218,
  author={Bouabidi, Sanaa and Hanyn, Dounia and Salhi, Abderahim and Baslam, Mohamed},
  booktitle={2024 10th International Conference on Optimization and Applications (ICOA)}, 
  title={Advanced Machine Learning Techniques for Predicting Precious Metal Prices in Financial Trading}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In an environment as intricate as the financial markets, where fortunes can shift in an instant, the prices of gold, silver, and oil emerge as puzzles, their fluctuations shrouded in mystery. These precious commodities, valued for their intrinsic worth and myriad applications, have long captivated both traders and investors. Today, technological advancements in machine learning play an increasingly crucial role in analyzing these fluctuations, thereby influencing market trends and contributing to shaping global economies. In this context, our aim is to design an intelligent system capable of accurately predicting the prices of gold, silver, and oil in the financial markets. The convergence of cutting-edge technology and financial strategies is essential to understanding and anticipating the movements of precious metal prices. Sophisticated algorithms such as Random Forest Regression (RFR), Long Short-Term Memory (LSTM) networks, and Support Vector Regression (SVR) allow us to explore new horizons in forecasting market trends. This study delves into this technological and financial convergence, paving the way for redefining the boundaries of precious metal price prediction through artificial intelligence, offering more precise and informed investment strategies, and thereby contributing to the evolution of practices in the financial sector.},
  keywords={Support vector machines;Silver;Gold;Fluctuations;Oils;Market research;Prediction algorithms;Long short term memory;Random forests;Convergence;Machine Learning;Trading;Regression;Precious Metals;LSTM},
  doi={10.1109/ICOA62581.2024.10754218},
  ISSN={2768-6388},
  month={Oct},}@INPROCEEDINGS{11512465,
  author={Panagopoulos, Michael and Zhou, Zeyang and Storey, Thomas and Thiyagarajan, Karthick and Moreira, Catarina and Prasad, Mukesh},
  booktitle={2025 18th International Conference on Sensing Technology (ICST)}, 
  title={Hybrid Meta-Ensemble Learning for High-Frequency Price Forecasting in the Australian National Electricity Market}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Short-term electricity price forecasting in Australia’s National Electricity Market is challenging due to five minute settlement intervals, extreme volatility, and increasing renewable energy penetration. This study aims to enhance operational forecasting accuracy through a sensing-driven metaensemble that remains robust across regions with varying market dynamics. The proposed TriModal MetaBoost integrates Long Short-Term Memory networks, XGBoost, and Random Forest via a meta-regressor. Engineered features capture temporal structure, momentum, volatility, and stress signals. The model is trained and evaluated on nine years of data covering five regions, and is benchmarked against eleven baselines and four hybrid competitors using RMSE, MAE, $R^{2}$, and sMAPE. MetaBoost achieves an average RMSE of 3.068, MAE of $0.970, R^{2}$ of 0.9992, and sMAPE of 2.574%, outperforming alternatives in New South Wales, Queensland, and Victoria. In contrast, PSO-XGBoost performs better in South Australia and Tasmania. Treating market signals as sensed data streams and combining heterogeneous learners yields state-of-the-art accuracy in the NEM’s five-minute environment. The evidence supports region-aware ensemble design and motivates adaptive weighting strategies for real-time bidding, risk management, and system operations.},
  keywords={Modeling;Forecasting;Pricing;Printing;Machine learning;Energy;Long short term memory;Australia;Convolutional neural networks;Machining;Energy forecasting;Machine learning;LSTM;XGBoost;Australian National Electricity Market;Hybrid Approach},
  doi={10.1109/ICST66402.2025.11512465},
  ISSN={2156-8073},
  month={Dec},}@INPROCEEDINGS{11455300,
  author={Aljuffairi, Abdulla and Shaker, Mustafa and Panigrahi, Shrikant Krupasindhu and Tripathy, Sasikanta},
  booktitle={2025 5th International Conference on Sustainable Islamic Business and Finance (SIBF)}, 
  title={The Impact of Gold and Oil Prices on Bitcoin Price: An Analytical Study}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper investigates how price dynamics of Bitcoin are affected not simply by endogenous factors of the cryptocurrency market, but also by exogenous ones related to the worlds of gold and oil. Empirical results based on statistical analysis (regression modeling, correlation matrix) show a significant positive, along with interesting, link between oil prices and Bitcoin, that reflects the influence of world energy markets, inflation, and liquidity on the value of Bitcoin. In the meantime, gold has a steady but minor effect, which indicates that Bitcoin is slowly integrating into normal stores of value, if it doesn't behave entirely like the shiny metal during times of economic stress. The results underscore the need to stop treating Bitcoin as a separate universe that is detached from the macro models. Predictive modelling calls for a bullish uptrend over 5 years for Bitcoin, with the usual caveat for future estimates. In general, this research adds to our new understanding of Bitcoin as an intermediate asset, both irrational (speculation) and rational (hedge), and motivates further attention on how this digital currency continues to interact with major commodities as it becomes more integrated in the world of global finance.},
  keywords={Gold;Analytical models;Correlation;Statistical analysis;Economic indicators;Oils;Biological system modeling;Finance;Bitcoin;Predictive models;Bitcoin;Oil Prices;Gold;Cryptocurrency;Speculation;Financial Integration},
  doi={10.1109/SIBF68061.2025.11455300},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10882507,
  author={Kumar, Rahul and Moolchandani, Jhankar and Shukla, Anshita and Sahu, Santosh and Thada, Vikas and Chole, Vikrant},
  booktitle={2024 13th International Conference on System Modeling & Advancement in Research Trends (SMART)}, 
  title={Machine Learning-Based Prediction of Gold Prices Using Economic Indicators}, 
  year={2024},
  volume={},
  number={},
  pages={520-524},
  abstract={In furtherance to this, this research work focuses on the role of applying machine learning techniques in predicting the price of Gold using price data along with three macroeconomic variables. Thirteen models were tested in order to determine which of the three models: They also established that among the seven algorithms, namely linear regression, random forest regressor, and gradient boosting regressor, is the most useful in predicting gold price. Gradient Boosting Regressor was the optimized of all to tremendous accuracy with the help of the used algorithm that let it learn complex and non-linear features in the data inputs. They proved that the recent month and year price data, long term moving average and US Dollar Index (DXY) are the variables which affect the gold prices. The results confirm the necessity to include a broad set of economic variables in the model and the information can be reputable and valuable to investors and policy makers. Nevertheless, it could be proposed that future work would try to incorporate more features and even try to apply deep learning as an effort to improve the accuracy of the envisioned predictions.},
  keywords={Gold;Accuracy;Machine learning algorithms;Biological system modeling;Predictive models;Prediction algorithms;Boosting;Market research;Macroeconomics;Random forests},
  doi={10.1109/SMART63812.2024.10882507},
  ISSN={2767-7362},
  month={Dec},}@INPROCEEDINGS{9773693,
  author={Subhan, Abdul and Khurshid, Nabila and Shah, Zarwa},
  booktitle={2022 2nd International Conference on Artificial Intelligence (ICAI)}, 
  title={Uncovering Price Puzzle in the Wheat Economy of Pakistan: An Application of Artificial Neural Networks}, 
  year={2022},
  volume={},
  number={},
  pages={84-89},
  abstract={Wheat is at the epicenter of global food security. Extreme wheat price volatility can contribute to broader social risks in terms of food security, human development and have a significant influence on farmers' incomes in the coming years especially in developing countries like Pakistan. Wheat is not only the major staple crop of the country's food security, but it also contributes about 10.3% in agriculture which accounts for 2.2% of domestic GDP. However, the presumable intensification in climate change and macroeconomic instability is reputed as a threat to wheat price stability nationwide. Against this backdrop, this research develops a precise wheat price puzzle forecasting model using the Long- Short Term Memory Recurrent Neural Networks (LSTM-RNN) - an application of Artificial Intelligence. LSTM-RNN are proficient in handling non-linear complex systems owing to their special LSTM nodes. An assessment of the planned framework with a handful of prevailing models is also discussed. Results showed that LSTM-RNN outperformed in terms of accuracy and uncovered that wheat prices will progressively swell and shrink by 2030, which will pose menaces to the whole economy. Moreover, our proposed methodology may be used as a guiding principle for other crops as well, to fortify sustainable agriculture development by 2030.},
  keywords={Recurrent neural networks;Crops;Food security;Predictive models;Agriculture;Stability analysis;Macroeconomics;Climate change;artificial intelligence;wheat price puzzle;LSTM-RNN;Pakistan},
  doi={10.1109/ICAI55435.2022.9773693},
  ISSN={},
  month={March},}@INPROCEEDINGS{11059484,
  author={Aledhari, Mohammed and Rahouti, Mohamed},
  booktitle={2025 International Wireless Communications and Mobile Computing (IWCMC)}, 
  title={Forecasting Oil Prices with Social Media Sentiment and Natural Language Processing}, 
  year={2025},
  volume={},
  number={},
  pages={1150-1155},
  abstract={Predicting oil prices is challenging due to factors beyond supply and demand, such as geopolitical events and public sentiment. Traditional models often fail to integrate real-time sentiment data, a growing market influence driven by social media. This study introduces a novel approach to oil price forecasting by combining social media sentiment from X (formerly Twitter) with advanced natural language processing and a long short-term memory (LSTM) neural network. Analyzing sentiment from millions of tweets, we capture public sentiment’s potential impact on West Texas Intermediate crude prices. Our LSTM-based model, designed to handle sequential data, achieved an R-squared of 0.831121, outperforming traditional econometric models and demonstrating a strong correlation between social sentiment and price trends. These results highlight the value of the social media sentiment in enhancing forecasting accuracy, offering actionable insights for investors and policymakers. Future research could extend this method to other commodities, further advancing economic forecasting through social sentiment analysis.},
  keywords={Wireless communication;Accuracy;Social networking (online);Oils;Biological system modeling;Blogs;Data models;Real-time systems;Long short term memory;Tuning;Oil;social media;sentiment;natural language processing},
  doi={10.1109/IWCMC65282.2025.11059484},
  ISSN={2376-6506},
  month={May},}@ARTICLE{11044350,
  author={Yin, Hui-Dong and Li, Yi-Yang},
  journal={IEEE Access}, 
  title={Bayesian-Optimized Multi-Task Gaussian Process Regression With Composite Kernels for Soybean Oil Futures Forecasting}, 
  year={2025},
  volume={13},
  number={},
  pages={107532-107541},
  abstract={Accurate forecasting of agricultural commodity prices is critical for economic stability and strategic decision-making, yet remains challenging owing to nonlinear dynamics and multifactorial volatility. This study addresses the forecasting of soybean oil prices in China’s wholesale markets by developing a Bayesian-optimized Multi-Task Gaussian Process Regression (MTGPR) framework. Traditional econometric models and machine learning approaches often struggle with non-stationary data and uncertainty quantification, while existing Gaussian process applications in agricultural markets remain underexplored. We propose a composite kernel architecture integrating Matérn 2.5 and Exponential Sine Squared (ESS) kernels to capture localized price trends, periodic cycles, and heteroskedastic volatility. The framework incorporates futures market indicators and employs spectral analysis with Reproducing Kernel Hilbert Space (RKHS) theory for feature alignment. Using a decade-long dataset (2015–2024) of daily soybean oil prices, the model undergoes rigorous validation via cross-validated Bayesian optimization, bootstrap error estimation, and posterior predictive intervals. Comparative evaluations against Long Short-Term Memory (LSTM), Gated Recurrent Unit (GRU), Support Vector Regression (SVR) and Extreme Gradient Boosting (XGBoost) demonstrate MTGPR’s superiority, achieving a mean absolute percentage error (MAPE) of 0.85% and R2 of 0.9313. Key innovations include adaptive kernel selection, probabilistic uncertainty bands for risk-aware strategies, and cross-market transferability analysis. Results confirm the model’s capacity to disentangle complex market patterns while maintaining computational tractability. This work advances agricultural price forecasting by bridging theoretical Bayesian methods with practical trading applications, offering policymakers and market participants a robust tool for hedging and supply chain optimization.},
  keywords={Kernel;Forecasting;Bayes methods;Biological system modeling;Computational modeling;Vegetable oils;Machine learning;Predictive models;Accuracy;Gaussian processes;Bayesian methods;Gaussian processes;Mercer kernel functions;agricultural forecasting;commodity price forecasting},
  doi={10.1109/ACCESS.2025.3581288},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11467951,
  author={Reynafarje, Santiago Pomar and Parra, Wilber Encarnacion and Alarcon, Jymmy Stuwart Dextre},
  booktitle={2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)}, 
  title={Predictive Model for the Price of Gold Using Machine Learning}, 
  year={2026},
  volume={},
  number={},
  pages={01-08},
  abstract={The prediction of gold prices represents a significant challenge for sectors such as mining and finance, especially in emerging economies like Peru. Traditional models show limitations in the face of high market volatility and the presence of multiple influential variables, as they fail to capture nonlinear relationships and respond effectively to abrupt changes in the economic environment. In response to this issue, this study proposes a predictive model based on the XGBoost algorithm, using macroeconomic variables such as the dollar index, interest rates, oil prices, the Standard & Poor's 500 (S&P 500) index, and others related to international markets. The methodology was structured in four phases: dataset selection, algorithm training, evaluation using regression metrics, and temporal validation. The model was trained with historical data and validated with recent records to simulate real-world conditions. The results obtained in Experiment 2 indicate high predictive capacity, with a Mean Absolute Error (MAE) of 18.90 USD, Root Mean Squared Error (RMSE) of 23.45 USD, and a Coefficient of Determination ($\mathbf{R}^{\mathbf{2}}$) of 0.92. Compared to the manual approach evaluated in Experiment 1, the model achieved a 29.6 % improvement in predictive accuracy, a 93% reduction in response time, and a 29% increase in user satisfaction, establishing itself as an effective tool to support strategic decision-making in environments sensitive to gold price fluctuations.},
  keywords={Feedback;Circuits;Protocols;HTTP;Amplitude shift keying;Amplitude modulation;Artificial intelligence;Artificial neural networks;Machine learning;Predictive models;Gold Price;Machine Learning;Predictive Model;Price Prediction},
  doi={10.1109/ACDSA67686.2026.11467951},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{9716169,
  author={Kristian, Nova and Adzikri, Fikri and Rizkinia, Mia},
  booktitle={2021 17th International Conference on Quality in Research (QIR): International Symposium on Electrical and Computer Engineering}, 
  title={Ethereum Price Prediction Comparison Using k-NN and Multiple Polynomial Regression}, 
  year={2021},
  volume={},
  number={},
  pages={141-146},
  abstract={Machine learning (ML) algorithms have been widely used to predict future financial trends. It has become a tool for predicting future trends based on what is known beforehand. Like other financial stock markets, cryptocurrency has become a new sensation and challenge for investors to predict its behaviour. However, unlike other financial instruments, cryptocurrency has been renowned because of the difficulty to predict the price due to its volatility behaviour that changes so rapidly and since there is no fundamental economy for its value. This paper presents a performance comparison of two ML algorithms in predicting Ethereum price with non-time series analysis, which are k- Nearest Neighbors (k-NN) and multiple polynomial regression (MPR). The experiment used independent variables from related real-world economic fundamentals such as Dow Jones Index, gold price, oil price, and Ethereum volume. The experiment data was collected from the records from April 2017 until April 2021. For each algorithm, several methods of preprocessing data were used to match all independent data with the dependent data. Three different preprocessing scenarios were also used to find the maximum accuracy model. scenario 1 (feature selection based on correlation matrix), scenario 2 (feature selection based on correlation with the dependent variables and among independent variables), and scenario 3 (scenario 1 extracted with PCA). The performance of the compared methods was evaluated by using MSE and MAE. From the experiment, a comparison of results using two different models with k-NN and multiple polynomial regression is obtained. It is found that k-NN with a hyperparameter K = 2 have the best prediction with MSE = 449.032 and MAE = 14.282 compared with multiple polynomial regression with the best MSE = 13953.96 and MAE = 84.923.},
  keywords={Gold;Correlation;Oils;Data preprocessing;Prediction algorithms;Feature extraction;Market research;crypocurrency;k-NN;multiple polynomial regression},
  doi={10.1109/QIR54354.2021.9716169},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10744247,
  author={Golash, Richa and Golash, Kushagra},
  booktitle={2024 IEEE 5th India Council International Subsections Conference (INDISCON)}, 
  title={Enhancing Financial Market Analysis Bitcoin vs Gold through Machine Learning Algorithms: A Study on Risk Assessment and Portfolio Management}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Financial markets exhibit complex, nonlinear dynamic behavior that is often challenging to interpret using traditional linear analysis methods. Risk assessment and, accordingly, portfolio management are the most important tasks for investors in order to avoid big losses. Gold trading is considered a safe haven, but it shows slow growth. In contrast, bitcoin or cryptocurrency trading is being proliferated. Many established financial institutions, like PayPal and Fidelity, are making it easier than ever for individuals to buy and sell Bitcoin. While Bitcoin trading can be potentially lucrative, it’s crucial to understand the significant risks involved before diving The volatile nature of Bitcoin can be emotionally stressful, leading to anxiety and poor decision-making. High-risk activity like stock trading requires a strong understanding of the market, particularly in high-risk assets like Bitcoin and gold, which demands a deep comprehension of market dynamics and the ability to tolerate volatility. Through this study, we delve into the application of machine learning algorithms to comprehend correlations, causality, and predict volatility in stock trading. Specifically, we focus on analyzing the trading behavior of cryptocurrency (bitcoin) vs. physical assets (gold) in terms of their volatility and comparing them in correlation with the stock index of crude-oil, S&P 500, and the dollar. This structured study aims to shed light on the effectiveness of machine learning algorithms in understanding and predicting volatility in stock trading, with a specific focus on Bitcoin and gold as high-risk assets.},
  keywords={Gold;Machine learning algorithms;Correlation;Uncertainty;Stability criteria;Bitcoin;Risk management;Reliability;Stock markets;Portfolios;stock trading;volatility prediction;machine learning algorithms;Bitcoin;gold;correlation;causality;risk management},
  doi={10.1109/INDISCON62179.2024.10744247},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11198108,
  author={Peng, Hao and Zhou, Jingfeng and Li, Zhihong and Ksibi, Albaraa and Xu, Xiaoying and Zhang, Qinxue},
  booktitle={2025 21st International Conference on Natural Computation, Fuzzy Systems and Knowledge Discovery (ICNC-FSKD)}, 
  title={Aviation Refueling Strategies Based on Neural Networks and Optimization Algorithms}, 
  year={2025},
  volume={},
  number={},
  pages={160-170},
  abstract={Aviation fuel costs account for 30% ~ 40% of total airline operating expenses. Therefore, optimizing refueling strategies to reduce fuel consumption and costs is crucial. Traditional fuel consumption optimization methods often struggle with complex flight networks and poor adaptability to dynamic environments. This study proposes an intelligent aviation fuel optimization system based on neural networks and optimization algorithms, combining deep neural networks, polynomial regression, and gradient optimization algorithms to improve the accuracy of fuel consumption prediction and optimize refueling strategies. The system builds a fuel consumption prediction model using historical data and meteorological information, and applies polynomial regression to reduce computational complexity. The optimization process, based on gradient descent methods, refines refueling plans while meeting safety constraints. The optimization objective can be configured to minimize either fuel costs or consumption. The system supports dynamic fuel price input and adjusts strategies based on real-time fuel prices and supply conditions. It enhances prediction accuracy and flexibility, automatically adjusts to price fluctuations, and improves operational efficiency and economic benefits for airlines.},
  keywords={Costs;Accuracy;Heuristic algorithms;Prediction algorithms;Polynomials;Systems support;Safety;Fuels;Optimization;Airline industry;aviation fuel consumption;neural networks;deep reinforcement learning;optimal refueling strategy},
  doi={10.1109/ICNC-FSKD67701.2025.11198108},
  ISSN={},
  month={July},}@INPROCEEDINGS{10548032,
  author={Pande, Shilpa Mangesh and Kumar Ramesh, Prem},
  booktitle={2024 Third International Conference on Distributed Computing and Electrical Circuits and Electronics (ICDCECE)}, 
  title={Time Series Modelling Approach for Predictive Analytics}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={India has been predominately an agrarian nation since the dawn of mankind. Agriculture continues to be the primary source of income in many parts of the country. Due to the population's rapid growth, there has been a surge in the requirement for crops and food in recent years. This gives the agricultural industry considerable room to create novel initiatives to satisfy the demand. Despite of rising demand, Indian farming sector didn't prove very successful. Poor demand and supply management typically leads to both high pricing for consumers and losses for farmers in developing nations like India. Our analysis demonstrates a significant mismatch between the demand for and supply of rice crops. Under various market conditions, this mismatch causes problems for both consumers and farmers in the Karnataka region. Taking into account the rice crop's demand, supply, and price fluctuations, we propose a model to balance demand and supply by predicting the rice price. In the proposed model, we discuss two methodologies for forecasting demand of rice crop. The proposed model uses time series models to predict demand. The rice crop price is predicted using SARIMA and Holt-Winter's seasonal approach, and their results are contrasted using RSME values. In order to reduce errors in prediction and to get accurate predictions from the best fit model, SARIMA and Holt- Winter's seasonal approach techniques were examined on the datasets by selecting initial values long with smoothing factors. This evaluation demonstrated trends and seasonal patterns. SARIMA model revealed promising results on the selected data sets.},
  keywords={Supply and demand;Smoothing methods;Computational modeling;Time series analysis;Crops;Pricing;Predictive models;time series modelling;holt winter's seasonal method;machine learning;SARIMA;demand prediction},
  doi={10.1109/ICDCECE60827.2024.10548032},
  ISSN={},
  month={April},}@INPROCEEDINGS{11738960,
  author={Evangelista, Clarissa Do Nascimento and Oliveira, Gabriel Almeida Santos De and Souza, Lawany Da Silva and Sales, Diego Câmara and Duarte, Victor Beltrão Valente and Silva, Luiz Eduardo Sales e},
  booktitle={2026 IEEE 14th International Conference on Smart Energy Grid Engineering (SEGE)}, 
  title={A Proposed Framework Using a Hybrid Structural-XGBoost Model for Brazilian Electricity Spot Price Forecasting Considering Hydrological Regimes}, 
  year={2026},
  volume={},
  number={},
  pages={114-121},
  abstract={The Brazilian short-term electricity price, known as the Difference Settlement Price (PLD), exhibits high volatility driven by hydrological conditions, demand shocks, and operational constraints. Most existing forecasting studies rely heavily on hydrological variables-such as Affluent Natural Energy (NEA) and reservoir level, which limits their applicability when such data are unavailable or delayed. To address this, this paper investigates whether raw climatic variables alone can effectively explain PLD dynamics. We propose a two-stage hybrid framework combining Ordinary Least Squares (OLS) regression with eXtreme Gradient Boosting (XGBoost) to capture both linear trends and complex, non-linear market relationships. Evaluating the model’s robustness under water stress, the framework achieves superior predictive stability with a Weighted MAPE of 13.99%, significantly outperforming standalone machine learning approaches. The architecture intrinsically captures climate interactions, naturally decoding the impact of thermal shocks during drought regimes without relying on artificial penalization or risking overfitting. Ultimately, by mapping extreme values and mitigating financial risk during price spikes, this approach proves that integrating a structural baseline outshines pure deep learning benchmarks.},
  keywords={Modeling;Pricing;Forecasting;Machine learning;Energy;Printing;Architecture;Computer architecture;Rain;Timing;Electricity prices;PLD;climate variables;econometric modeling;machine learning;hydrological regimes},
  doi={10.1109/SEGE70974.2026.11738960},
  ISSN={2575-2693},
  month={Aug},}@INPROCEEDINGS{9592418,
  author={Lai, Shanyan and Ye, Chunyang and Zhou, Hongyu Jiang Hui},
  booktitle={2021 IEEE International Conference on Smart Data Services (SMDS)}, 
  title={Chinese stock trend prediction based on multi-feature learning and model fusion}, 
  year={2021},
  volume={},
  number={},
  pages={18-23},
  abstract={Stock trend predicting is an extremely attractive research issue since the accurate prediction of the stock market trend can obtain higher investment returns. Unfortunately, the stock market is affected by various events, resulting in constant volatility. As a result, it is difficult to accurately predict the stock market changing trend. The challenges lie in how to study various related factors and extract effective information to make reliable predictions. However, the independence of news information is high. This limits the abilities of the model. In addition, the fusion of news and time series data can cause the problem of dimensional disparity. In response to these challenges, we proposed a multi-feature learning method based on attention, TCBiGA, to predict the Chinese stock trends. Extensive experiments on real-world data show that our method can extract a more effective knowledge base from a set of different data, thereby improving the performance of the model.},
  keywords={Learning systems;Time series analysis;Knowledge based systems;Predictive models;Market research;Data models;Data mining;Stock prediction;Model fusion;Multi-feature learning;TextCNN;Bi-GRU},
  doi={10.1109/SMDS53860.2021.00013},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11491428,
  author={Ghose, Swattic and Jawwad, Rubaiyet Hossain and Rafin, Nafiz Imtiaz and Yahiya, Yamin Bin and Khaled, Faiyaz Bin and Alam, Md. Golam Rabiul},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={An Integrated Approach to Forecast Bitcoin Price Incorporating Economic Factors, Strategic Commodities, and X Tweets}, 
  year={2025},
  volume={},
  number={},
  pages={1846-1851},
  abstract={Bitcoin is known for its volatility. So, we conducted a diverse market analysis to construct a conclusive market feature dataset and a hybrid model architecture to find better insight and make better forecasts. One key factor that other research overlooked was the market impact of AMD and NVIDIA. These two most prominent tech companies provide consumerlevel GPUs mostly used for cryptocurrency mining. Focusing on these gaps, we conducted an extensive study of the potential markets and their impact on our model training. We provided an extensive data analysis of the impact of crude oil, gold, AMD, NVIDIA, S&P500, NASDAQ, and sentiment analysis of 85 million tweets altogether on Bitcoin price. The volume of tweets that we collected through web scraping is substantial to the other studies. From our comparative analysis, we deduced that A bidirectional LSTM works best for predicting the Bitcoin trend compared to other deep learning and time series models. Thus, we chose Bidirectional LSTM as our base model and used it to build a hybrid architecture ensemble model with Random Forest Regressor. For the proposed model, we have deployed four simultaneous Bayesian Optimized Bidirectional LSTM models, each with its distinct input features, and trained the Random Forest Regressor model using the predictions from those four models. The trained Random Forest model was used to select the best forecast we obtained from the four Bi-LSTM models. Our findings indicate that Bidirectional LSTM predicts more accurately when sentiment analysis and other macroeconomic aspects are incorporated.},
  keywords={Electronic countermeasures;Electronic warfare;Protocols;HTTP;Internet;Communication systems;Computer networks;Bidirectional long short term memory;Long short term memory;Machine learning;Bitcoin;Macro Economics;Sentiment Analysis;GPU;Bayesian Optimization;Bidirectional LSTM;Ensemble Random Forest Regressor},
  doi={10.1109/ICCIT68739.2025.11491428},
  ISSN={2474-9656},
  month={Dec},}@INPROCEEDINGS{8916502,
  author={Petrichenko, Lubov and Petrichenko, Roman and Sauhats, Antans and Baltputnis, Karlis},
  booktitle={2019 16th International Conference on the European Energy Market (EEM)}, 
  title={Avoided Costs-Based Comparison of Consumer-Scale Energy Storage Control Approaches}, 
  year={2019},
  volume={},
  number={},
  pages={1-5},
  abstract={The aim of the paper is to obtain new knowledge for the improvement of planning and control of manufacturing processes in energy-intensive enterprises, considering variations in electricity market price and energy storage possibilities. Particularly, optimisation of the planning and control of consumer-scale battery energy storage system connected behind the meter is considered. To solve the optimisation problem, price forecasting procedures, models of the objects under study, control, optimisation, and verification algorithms were chosen. The objective function of the optimisation problem is formulated in the form of avoided costs, defined as the difference between the costs of consumed electricity with and without an energy storage system. Deterministic and stochastic approaches were used and compared.},
  keywords={Planning;Forecasting;Optimization;Batteries;Stochastic processes;Task analysis;energy storage;investment planning;operational planning;optimisation},
  doi={10.1109/EEM.2019.8916502},
  ISSN={2165-4093},
  month={Sep.},}@ARTICLE{9492833,
  author={Zhang, Wenjie and Liu, Shunqi and Gandhi, Oktoviano and Rodríguez-Gallegos, Carlos D. and Quan, Hao and Srinivasan, Dipti},
  journal={IEEE Transactions on Sustainable Energy}, 
  title={Deep-Learning-Based Probabilistic Estimation of Solar PV Soiling Loss}, 
  year={2021},
  volume={12},
  number={4},
  pages={2436-2444},
  abstract={Although the integration of solar photovoltaic (PV) systems is gaining widespread acceptance, the intermittency and instability of PV power generation lead to several operational challenges. PV power generation can be impacted by multiple environmental factors, such as the soiling of solar PV panels. There are some conventional methods proposed to deterministically estimate the solar power loss caused by soiling. However, the error of deterministic estimation cannot be eliminated due to the inherent volatility of solar power. Therefore, this paper proposes a probabilistic quantification method, namely SolarQRNN, to estimate the power loss by leveraging images captured by surveillance cameras. Specifically, the proposed model employs a novel quantile loss function and deep learning structures (backbone networks based on residual convolution units), which combines quantile regression and computer vision models for the first time. The proposed method has been extensively tested on a solar panel soiling image dataset. Test results indicate that SolarQRNN outperforms benchmark classification models with at least 51% improvements in evaluating metrics.},
  keywords={Convolutional neural networks;Photovoltaic systems;Solar panels;Feature extraction;Deep learning;Photovoltaic (PV) system;solar PV panel soiling;probabilistic estimation;deep learning;convolutional neural network},
  doi={10.1109/TSTE.2021.3098677},
  ISSN={1949-3037},
  month={Oct},}@INPROCEEDINGS{11276081,
  author={Wongsathan, Rati and Thant, Hein and Seedadan, Isaravuth and Thway, Win Mya and Puangmanee, Wutthichai},
  booktitle={2025 9th International Conference on Information Technology (InCIT)}, 
  title={AI-Based Feature Importance Analysis of Factors Affecting Thailand's Gold Price across COVID-19 Phases and One-Year-Ahead Price Estimation}, 
  year={2025},
  volume={},
  number={},
  pages={665-672},
  abstract={Gold is a key investment asset, highly sensitive to macroeconomic and financial fluctuations, and exhibited volatility during and after the COVID-19 pandemic. This study investigates the main determinants of gold prices in Thailand, the world's seventh-largest market, using numerical indicators including the SET Index, USD-THB exchange rate, inflation rate, and WTI crude oil prices. AI-based methods-Decision Tree, Random Forest, and XGBoost with SHAP analysis-are compared with conventional approaches such as Lasso, Elastic Net, and composite ARSD. Results indicate that external factors, WTI and USD-THB, were most influential during the pandemic. XGBoost with SHAP shows that after the pandemic, a combination of internal and external factors-SETIndex and USD-THB-becomes the most significant determinants, contrasting with other methods that identify only internal factors (Inflation and SETIndex) as primary drivers postpandemic. Short-term forecasting using post-pandemic key factors was conducted with linear and nonlinear models, with and without memory, including MLR, MLPNN, and LSTM. Incorporating the SETIndex and USD-THB yields significantly higher accuracy than using only internal factors, highlighting the influence of equity market risk and local currency strength on gold price movements. Long-term, one-year-ahead projections using these models and commercial package Facebook Prophet (Meta Inc.) suggest Thailand's gold price could reach approximately 60,000 THB per baht by May or June 2026. This study provides an AI-informed, understanding of gold price determinants, offering insights for investors and policymakers navigating volatile economic conditions.},
  keywords={COVID-19;Gold;Accuracy;Pandemics;Social networking (online);Biological system modeling;Predictive models;Macroeconomics;Forecasting;Long short term memory;gold price's determinants;Decision Tree;Random Forest;XGBoost with SHAP analysis;LSTM;Facebook Prophet},
  doi={10.1109/InCIT66780.2025.11276081},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11584527,
  author={Pan, Ruoqi and Li, Manjia and Huang, Ke},
  booktitle={2026 3rd International Conference on Electronic Engineering and Information Systems (EEISS)}, 
  title={An Applicability Study on Traditional Machine Learning and Large Language Models for Time-series Data Trend}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The futures time series feature is nonstationarity and varying volatility across different commodity types. This work formulates futures trend forecasting as a three-class classification problem and sets a $\pm 0.0005$ fluctuation threshold at the minute-level dataset. It compares CatBoost, MultiRocket and TimeGPT on the data for gold, corn, and crude oil. The temporal input matrix and sliding window are configured for MultiRocket and TimeGPT, respectively. Experiments indicate that TimeGPT achieves the highest overall accuracy of 0.8033 with balanced classification performance. CatBoost achieves high accuracy on partial datasets but shows clear category bias, whereas MultiRocket performs the worst. This study provides quantitative evidence for model selection between traditional machine learning and large time-series models in multicategory futures prediction.},
  keywords={Modeling;Pricing;Timing;Accuracy;Machine learning;Labeling;Printing;Windows;Machining;Testing;Trend prediction;TimeGPT;time Series Data},
  doi={10.1109/EEiSS69782.2026.11584527},
  ISSN={},
  month={April},}@INPROCEEDINGS{11652272,
  author={Sahu, Manish RK and Tune, Hadasha Nobel and Goyal, Eeshita and Kulkarni, Shailesh and Amonov, Mehriddin and Fazliddin, Tuyev},
  booktitle={2026 International Conference on NextGen Data Science and Analytics (ICNDSA)}, 
  title={Computational Economics: Modeling Energy Markets with AI}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The markets of energy are becoming complicated as the demand changes, integration of renewable sources, geopolitics and price volatility poses a challenge and the traditional econometric models could not help in making accurate predictions and design of the policy. This paper deals with the issue of low flexibility and inefficiency in predicting the energy market models. The main goal is to create an AI-assisted computational economics framework that will provide an opportunity to capture nonlinear interactions and dynamic market behaviour. The suggested solution involves a combination of machine learning and economic modeling in order to increase the accuracy of the forecast and efficiency of decision-making. In particular, the hybrid models that integrate Long Short-Term Memory (LSTM), Random Forest, and Reinforcement Learning are used to predict the past price patterns, demand-supply patterns, and the influence of the policy. It has been experimentally proven that the proposed AI-based structure is more effective in terms of predicting prices by 27.6 percent, forecasting errors by 34.2 percent, and the efficiency of demand estimation by 22.8 percent than the traditional econometric models. Also, the accuracy of policy simulation improved by 31.4 points, which allowed the improvement of strategic planning. The findings support the fact that AI in combination with computational economics make the models much more robust and responsive.},
  keywords={Modeling;Energy;Artificial intelligence;Machine learning;Accuracy;Equations;Forecasting;Long short term memory;Machining;Economics;Computational Economics;Energy Markets;Artificial Intelligence;Machine Learning;Forecasting Models;Policy Optimization},
  doi={10.1109/ICNDSA68777.2026.11652272},
  ISSN={},
  month={April},}@INPROCEEDINGS{11649203,
  author={Mishra, Himanshu and Dalal, Arvind and Singuluri, Indira and Gadare, Nikesh T. and Mishra, Rajesh Kumar},
  booktitle={2026 2nd International Conference on Sustainable Computing and Integrated Communication in Changing Landscape of AI (ICSCAI)}, 
  title={Mathematical Foundations of Machine Learning Algorithms for Signal Processing Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Exchange rate volatility: The exchange rate especially between the US Dollar and the Indian Rupee (USD/INR) is a great problem in terms of financial planning and risk management in the emerging markets such as India. This paper introduces a combined machine learning model of predicting Rupee volatility using sophisticated procedural designs to enhance the degree of prediction and decision making among corporate and government entities. The framework works on the basis of Long Short-Term Memory neural networks to predict the exchange rate dynamics and compares the performance of LSTM to classical models, including Autoregressive Integrated Moving Average and the Random Walk model. LSTM model is tested through walk-forward, Diebold-Mariano, and metrics based on financial data, and proves to reduce the Root Mean Squared Error by 38 percent as compared to ARIMA. Moreover, LSTM has better economic value, a Sharpe of 0.50 and a Kelly Growth of 0.22 are higher, and risk-adjusted returns are better. The results indicate that machine learning tools, in particular, LSTM, can contribute greatly to financial prediction, which provides a superior ability to manage risk, budget, and decision-making in the private and government sectors. It could be of use in addressing the challenges of financial risks related to the changes in the exchange rates because this research suggested a powerful and statistically sound method of predicting the exchange rate fluctuations.},
  keywords={Modeling;Long short term memory;Machine learning;Printing;Machining;Timing;Exchange rates;Forecasting;Testing;Measurement;Exchange Rate Forecasting;Machine Learning;LSTM;Financial Risk Management;USD/INR;Public Sector Finance},
  doi={10.1109/ICSCAI68849.2026.11649203},
  ISSN={},
  month={May},}@INPROCEEDINGS{11262694,
  author={Alsharif, Ghadeer O. and Anagnostopoulos, Christos and Marnerides, Angelos K.},
  booktitle={2025 IEEE 45th International Conference on Distributed Computing Systems Workshops (ICDCSW)}, 
  title={Incremental Learning Detection of Distributed Financially Motivated Attacks in Energy Markets}, 
  year={2025},
  volume={},
  number={},
  pages={189-194},
  abstract={The evolution of traditional electric markets into Smart Grids has ushered in a competitive environment driven by Locational Marginal Prices (LMPs), enabling market participants to bid and offer energy dynamically. However, this paradigm has been proven to be vulnerable to financially motivated False Data Injection Attacks (FDIAs). In these attacks, malicious actors manipulate the underlying measurement data to falsify market outcomes. Detecting anomalies in LMPs is challenging due to non-stationary characteristics stemming from operational system dynamics invoking inherent uncertainties. In addition, attack strategies are designed to mimic legitimate prices while achieving long-term financial gains. Recent studies have shown promising results in the detection of anomalies by analyzing error patterns generated by machine learning models. Likewise, in this work, we design an unsupervised Locational Marginal Pricing (LMP) manipulation detection model by statistically analyzing prediction error patterns from a Long Short-Term Memory (LSTM) model. Furthermore, we apply change point detection principles to detect changes in the prediction error pattern. Comprehensive experimental analysis and comparative assessments over real datasets highlight the efficiency of our proposed method in achieving a high attack detection rate whilst generating a low false alarm rate.},
  keywords={Analytical models;Uncertainty;System dynamics;Pricing;Predictive models;Vectors;System buses;Smart grids;Long short term memory;Anomaly detection;Energy market;False Data Injection Attack (FDIA);Locational Marginal Price (LMP);anomaly detection},
  doi={10.1109/ICDCSW63273.2025.00038},
  ISSN={2332-5666},
  month={July},}@INPROCEEDINGS{11180640,
  author={Sanchez, Fabien and Mohamed, Ahmed and Rigo-Mariani, Rémy and Debusschere, Vincent},
  booktitle={2025 IEEE Kiel PowerTech}, 
  title={Supervised Learning for the Bidding of Grid-Connected Batteries in the Day-Ahead Market}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper discusses the implementation of supervised learning (SL) as a straightforward data-driven technique to compute the day-ahead bids of grid-connected battery energy systems (BESS) participating in energy markets. The objective is to implicitly account for price uncertainty in the BESS schedule before assessing the economic performance. The case study is a 10 MW BESS battery participating in the day-ahead market. Physic-Informed and more traditional loss functions and a large set of tuning parameters are compared based on the generated daily revenues. Either the power injected by the BESS or its state of charge is controlled, illustrating a compromise to find between the accuracy and the resilience of the results, once confronted with the high volatility of energy prices. The performance of AI-based controllers is assessed in terms of precision with a theoretical optimum obtained with a "perfect forecast". A reference bidding strategy using "backcasting" as a forecast is also considered. Simulation over the year 2021 with an hourly training data set of the energy prices of 2020 shows that SL models do not necessarily perform better than reference results (with a minimal error of 58 %). However, discussions about their tuning and design choices shed light on the complex implementation process of the selected case study.},
  keywords={Training;Schedules;Uncertainty;Battery energy storage system;Supervised learning;Training data;Batteries;State of charge;Tuning;Resilience;Machine Learning;Supervised Training;Battery storage system;Day-Ahead market;data analysis},
  doi={10.1109/PowerTech59965.2025.11180640},
  ISSN={},
  month={June},}@ARTICLE{10458427,
  author={Li, Jinhao and Wang, Changlong and Zhang, Yanru and Wang, Hao},
  journal={IEEE Transactions on Energy Markets, Policy and Regulation}, 
  title={Temporal-Aware Deep Reinforcement Learning for Energy Storage Bidding in Energy and Contingency Reserve Markets}, 
  year={2024},
  volume={2},
  number={3},
  pages={392-406},
  abstract={The battery energy storage system (BESS) has immense potential for enhancing grid reliability and security through its participation in the electricity market. BESS often seeks various revenue streams by taking part in multiple markets to unlock its full potential, but effective algorithms for joint-market participation under price uncertainties are insufficiently explored in the existing research. To bridge this gap, we develop a novel BESS joint bidding strategy that utilizes deep reinforcement learning (DRL) to bid in the spot and contingency frequency control ancillary services (FCAS) markets. Our approach leverages a transformer-based temporal feature extractor to effectively respond to price fluctuations in seven markets simultaneously and helps DRL learn the best BESS bidding strategy in joint-market participation. Additionally, unlike conventional “black-box” DRL model, our approach is more interpretable and provides valuable insights into the temporal bidding behavior of BESS in the dynamic electricity market. We validate our method using realistic market prices from the Australian National Electricity Market. The results show that our strategy outperforms benchmarks, including both optimization-based and other DRL-based strategies, by substantial margins. Our findings further suggest that effective temporal-aware bidding can significantly increase profits in the spot and contingency FCAS markets compared to individual market participation.},
  keywords={Contingency management;Real-time systems;Generators;Uncertainty;Electricity supply industry;Regulation;Australia;Battery energy storage system;Deep reinforcement learning;Energy management;Battery energy storage system;deep reinforcement learning;energy arbitrage;frequency control ancillary services;transformer},
  doi={10.1109/TEMPR.2024.3372656},
  ISSN={2771-9626},
  month={Sep.},}@INPROCEEDINGS{11050206,
  author={El Makroum, Reda and Zwickl-Bernhard, Sebastian and Kranzl, Lukas and Auer, Hans},
  booktitle={2025 21st International Conference on the European Energy Market (EEM)}, 
  title={Reinforcement Learning-Based Charging Control in Households Under Real-Time Pricing}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a reinforcement learning-based approach for real-time charging control in households under realtime pricing. A Soft Actor-Critic agent is trained to optimize the charging and discharging of a stationary battery to minimize electricity costs while ensuring operational stability. Unlike predictive or rule-based approaches, the RL agent makes decisions without access to future prices, relying solely on current market conditions and past observations. The methodology is tested using historical market data from three electricity markets with distinct price dynamics: Germany, Austria, and Italy. Results demonstrate that the RL-based control successfully adapts to different market structures, effectively leveraging price fluctuations to improve household energy management.},
  keywords={Costs;Fluctuations;Refining;Pricing;Reinforcement learning;Electricity supply industry;Real-time systems;Batteries;Forecasting;Energy management;reinforcement learning;real-time pricing;battery storage;soft actor-critic;demand response},
  doi={10.1109/EEM64765.2025.11050206},
  ISSN={2165-4093},
  month={May},}@INPROCEEDINGS{10747424,
  author={Vieira, Douglas A. G. and e Horta, Gustavo de L. and Silva, Gustavo R. L. and Tavares, Leonardo D.},
  booktitle={2024 16th Seminar on Power Electronics and Control (SEPOC)}, 
  title={Dynamic Pricing-Driven Framework for Optimizing Energy Consumption}, 
  year={2024},
  volume={},
  number={},
  pages={1-11},
  abstract={This article presents a framework for calculating the hourly electricity price, considering the relationship between energy consumption and energy price in such a way to achieve the consumption closer to a given target. This framework considers a general definition between energy consumption and price, the objective function as a distance metric from the desired target, and a set of constraints. Two optimization methods were tested, the Trust-Region Constrained method and Sequential-Least Squares Programming (SLSQP). The results showed that it is possible to model the consumption/price relationship dynamically, and that this scenario was designed to encourage consumption outside of peak hours, not being restricted to the two forms of modeling presented. This aspect is particularly useful for short and long-term financial planning for energy suppliers. This flexibility in pricing strategies is a significant advancement in understanding consumer behavior in response to price changes. The paper opens avenues for further exploration, such as investigating alternative linear constraints, different price limits, and varying time intervals for consumption. This suggests a pathway for enhancing the framework’s applicability and effectiveness in real-world scenarios.},
  keywords={Seminars;Energy consumption;Renewable energy sources;Electricity;Pricing;Programming;Generators;Demand response;Sustainable development;Meteorology;Dynamic energy pricing;energy consumption;hourly electricity price;optimization;energy demand response},
  doi={10.1109/SEPOC63090.2024.10747424},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9216888,
  author={Fan, Hongbo and Luo, Xiaosong and Sun, Zhao-Hui and Yuan, Xin and Qiu, Siqi},
  booktitle={2020 IEEE 16th International Conference on Automation Science and Engineering (CASE)}, 
  title={Multi-model fusion based on Stacking: A predictive model for the price trend of natural rubber}, 
  year={2020},
  volume={},
  number={},
  pages={1237-1242},
  abstract={Natural rubber plays the most important role in manufacturing. It has an important position in the automobile tire industry, sealing industry and daily necessities industry. Therefore, its price trend has a major impact on industrial output and economy. For the manufacturing industry, a reasonable forecast of rubber prices will give enterprises a huge advantage in planning production, reducing costs and improving production efficiency. In this paper, in response to the demand for rubber price forecasts in the manufacturing industry, the relevant factors affecting rubber prices are analyzed, and the natural rubber price data sets of more than 500 sets of variables spanning 10 years are collected. The work related to data preprocessing and feature selection was completed. XGBoost was used as a super model to integrate the Random Forest, Adaboost and LSTM base models to obtain the final Stacking model. And provides an important reference for the development of natural rubber procurement strategy.},
  keywords={Rubber;Predictive models;Principal component analysis;Procurement;Training;Market research;Production;Data Fusion;Data Driven and Data Mining;Optimization and Optimal Control},
  doi={10.1109/CASE48305.2020.9216888},
  ISSN={2161-8089},
  month={Aug},}@INPROCEEDINGS{11087899,
  author={Wussow, Philipp and Haase, Jan},
  booktitle={2025 IEEE 8th International Conference on Industrial Cyber-Physical Systems (ICPS)}, 
  title={Machine Learning Models for Prediction of Energy Flexibility in Commercial Buildings}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Energy flexibility is critical for integrating renewable energy into power grids, as it helps mitigate supply volatility and enhance grid stability. This study presents a machine learning-based approach to predict energy flexibility, focusing on capacity and duration metrics. An ensemble model using support vector regression (SVR) was developed and trained on real-world energy consumption data from commercial buildings, incorporating weather variables. The results demonstrate strong predictive performance across diverse building types, and even on unsmoothed data, equipping aggregators with the tools to optimize energy market operations and support renewable energy integration.},
  keywords={Support vector machines;Renewable energy sources;Accuracy;Soft sensors;Buildings;Predictive models;Power system stability;Data models;Stability analysis;Usability;Machine learning;flexibility;forecasting;energy;buildings;aggregator},
  doi={10.1109/ICPS65515.2025.11087899},
  ISSN={2769-3899},
  month={May},}@INPROCEEDINGS{10503500,
  author={Jha, Kundan Kumar and Katiyar, Kuldip},
  booktitle={2024 IEEE International Conference on Interdisciplinary Approaches in Technology and Management for Social Innovation (IATMSI)}, 
  title={Impact of Russia-Ukraine war on Oil & Gas, Commodities and Metal Sector of Indian Economy}, 
  year={2024},
  volume={2},
  number={},
  pages={1-6},
  abstract={The global economy is grappling with significant consequences stemming from the conflict between Russia and Ukraine. The impact is notably observable in international trade, affecting vital commodities like wheat, crude oil, and raw materials. Despite India’s geographical distance from Russia and Ukraine, its trade connections expose it to the repercussions of their conflict. This study concentrates on evaluating how the Russia-Ukraine war has influenced three pivotal sectoral indices (Oil & Gas, Metal, and Commodities) within the Indian economy. Employing event study methodology, the analysis spans 364 days, covering 176 days before the event and 187 days after the event from September 01, 2021, to August 30, 2022.The findings disclose that nearly all sampled sectors experienced significantly positive abnormal returns during the post-event period, with the metal industry leading in showcasing the highest abnormal returns. Despite the initial positive returns, the market corrected itself. A prediction model has also been include in this study to predict the stock price of that time. These results provide potential advantages for portfolio managers, analysts, investors, and policymakers, aiding them in risk mitigation and the selection of appropriate investments during periods of heightened global uncertainty. The study’s conclusions also advocate for establishing an institutional and supervisory framework to identify and mitigate systematic risks through counter cyclical measures.},
  keywords={Technological innovation;Uncertainty;Systematics;Oils;Collaboration;Predictive models;Metals industry;Russia–Ukraine war;Abnormal returns;LSTM prediction Model;Indian stock market;NSE},
  doi={10.1109/IATMSI60426.2024.10503500},
  ISSN={},
  month={March},}@INPROCEEDINGS{11387154,
  author={Putra, Agrippina Nicola and Kurdhi, Nughthoh Arfawi and Siri, Zailan and Aruchunan, Elayaraja},
  booktitle={2025 International Conference on Artificial Intelligence and Technological Solutions (ICAITech)}, 
  title={Predictive and Interpretative Analysis of Gold Price Using Long Short-Term Memory and Opti-LIME}, 
  year={2025},
  volume={},
  number={},
  pages={174-178},
  abstract={Gold is one of the most popular investment instruments and is sought after by various groups. Its p opularity stems from the perception that gold is a relatively safe and stable asset, especially during times of economic uncertainty or financial market volatility. However, the price of gold itself cannot be predicted completely simply, as it is influenced by various complex, interrelated factors that are often difficult to explain directly. Recognizing the need for more accurate information for investment decision-making, we conducted this study with the aim of forecasting future gold prices using a machine learning-based approach. The model we used was Long Short-Term Memory (LSTM), a variant of artificial neural networks specifically designed to handle time series data. However, one challenge in using models such as LSTM is the lack of transparency in the decision-making process. Often, the model’s results appear as a “black box,” without a clear explanation of how and why they were obtained. To address this challenge, we integrated the LSTM model with an Extensible Artificial Intelligence (XAI) approach, Opti-LIME (Optimized Local Interpretable Model-Agnostic Explanations), which allows us to forecast prices while locally explaining the contribution of each feature to the model’s results. By combining the LSTM’s ability to predict price trends with the interpretive power of Opti-LIME, we have successfully produced an approach that is not only accurate but also transparently explainable. This approach is expected to help investors and other stakeholders understand gold price movements and make more informed decisions, based on reliable data and reasoning.},
  keywords={Gold;Adaptation models;Accuracy;Uncertainty;Decision making;Predictive models;Stability analysis;Forecasting;Long short term memory;Investment;LSTM;gold price;Opti-LIME;Explainabel AI},
  doi={10.1109/ICAITech66481.2025.11387154},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11431285,
  author={Sun, Hanxi and Xu, Yan and Xia, Yang and Xie, Dunjian and Zhang, Rui},
  booktitle={2025 IEEE PES Innovative Smart Grid Technologies - Asia (ISGT Asia)}, 
  title={A Learning based Bidding Strategy for Energy Arbitrage of Battery Energy Storage Systems in Day-Ahead Electricity Market}, 
  year={2025},
  volume={},
  number={},
  pages={96-100},
  abstract={Bidding under uncertain electricity prices remains a challenge for battery energy storage systems (BESS). This paper proposes a deep reinforcement learning based bidding strategy for battery energy storage systems to arbitrage in day-ahead electricity markets. First of all, a data-driven decision-making framework is designed to maximize the BESS's profit from market participation, which only relies on historical price data without the need for additional forecasting modules. Secondly, a confidence function is developed to evaluate the confidence of the bidding decision, enabling smoother and more adaptive bidding decisions for BESS under market uncertainties. During training, a Long Short-Term Memory (LSTM) network is enhanced with Proximal Policy Optimization (PPO) to capture temporal price features, which further improves decision-making. Case studies using three years of Australian market data demonstrate that the proposed method achieves stable convergence, high arbitrage revenue, and safe SoC compliance.},
  keywords={Training;Uncertainty;Battery energy storage system;Decision making;Asia;Electricity supply industry;Deep reinforcement learning;Smart grids;Long short term memory;Convergence;Battery energy storage system;day-ahead electricity market;deep reinforcement learning;bidding strategy},
  doi={10.1109/ISGTAsia63446.2025.11431285},
  ISSN={2378-8542},
  month={Nov},}@INPROCEEDINGS{11089652,
  author={Deng, Weisi and Liu, Xianzhuo and Liu, Jiale and Gao, Weidong and Wang, Haohuai},
  booktitle={2025 2nd International Conference on Electrical Technology and Automation Engineering (ETAE)}, 
  title={Research on Auxiliary Decision Making Algorithm for New Energy Participation in Multi Level and Multi Variety Electricity Market Based on 1DCNN-SLSTM}, 
  year={2025},
  volume={},
  number={},
  pages={146-152},
  abstract={In response to the volatility and nonlinearity of new energy power data, this paper presents a 1DCNN-SLSTM-based auxiliary decision-making algorithm for the new energy power market. 1DCNN extracts short-term local power data features, and SLSTM models long-term temporal dependencies, capturing seasonal and daily cycles. Multi-source feature fusion enables high-precision predictions. Experiments show the model surpasses ARIMA, LSTM, and SVM in RMSE (0.035), MAE (0.028), and $\mathrm{R}^{2}(0.92)$. Despite a 25 -minute training time, the 0.12second prediction time meets real-time needs and can be optimized with hardware. The findings offer reliable algorithmic support for new energy market scheduling and risk control.},
  keywords={Training;Decision making;Predictive models;Prediction algorithms;Feature extraction;Electricity supply industry;Power markets;Data models;Power generation;Long short term memory;new energy power generation;electricity market;deep learning;1DCNN-SLSTM;decision support},
  doi={10.1109/ETAE65337.2025.11089652},
  ISSN={},
  month={May},}@INPROCEEDINGS{11309456,
  author={Wang, Wen and Yang, Ye and Fang, Xiangliang and Zhang, Xiaoqing and Li, Yao and Li, Min and Liu, Sihua and Li, Peijun},
  booktitle={2025 2nd International Conference on Intelligent Computing and Data Mining (ICDM)}, 
  title={Optimization of Multi-Market Transaction Decisions for Data-Driven Electric Vehicle Aggregators}, 
  year={2025},
  volume={},
  number={},
  pages={126-130},
  abstract={As the “dual carbon” strategy progresses and the penetration rate of new energy continues to rise, electric vehicles (EVs) are increasingly playing a prominent role in power systems as flexible, adjustable load resources. Aggregators, by consolidating a large number of EV resources, have the potential to participate in diverse power markets such as the electricity energy market, ancillary services market, and demand response market. However, due to factors such as electricity price fluctuations, uncertainty in user charging behavior, and differences in market mechanisms, aggregators face complex and dynamic challenges in their trading decisions. This paper addresses the multi-market transaction challenges faced by EV aggregators by establishing a data-driven decision optimization framework. First, by introducing deep learning methods, the framework achieves high-precision predictions of electric vehicle user load behavior and electricity market prices. Second, a multiobjective robust optimization model is constructed to formulate cross-market participation strategies, considering factors such as revenue maximization, battery health, and user satisfaction. Finally, simulation verification is conducted in multiple typical urban distribution network scenarios to assess the robustness and economic viability of the strategies under different uncertainty conditions.},
  keywords={Uncertainty;Electricity;Power system dynamics;Distribution networks;Electric vehicles;Robustness;Power markets;Carbon;Vehicle dynamics;Optimization;Electric vehicles;aggregators;diversified markets;data-driven;transaction decision optimization},
  doi={10.1109/ICDM68174.2025.11309456},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10608907,
  author={Miskiw, Kim K. and Staudt, Philipp},
  booktitle={2024 20th International Conference on the European Energy Market (EEM)}, 
  title={Explainable Deep Reinforcement Learning for Multi-Agent Electricity Market Simulations}, 
  year={2024},
  volume={},
  number={},
  pages={1-9},
  abstract={As electricity systems evolve in the light of increased volatility and market variety, understanding market dynamics through simulations becomes crucial. Deep reinforcement learning (DRL) in combination with agent-based models (ABM) progressively garners attention as it allows the modeling of strategic bidding behavior of electricity market participants. However, as DRL is a black-box model, the learned behavior of market participants is hardly explainable nor interpretable for modelers. We bridge the gap in explainability of DRL in agentbased electricity market simulations by leveraging explainable DRL methods. The reviewed literature underscores the novelty of this approach, especially in multi-agent DRL settings. A case study comparing DRL and rule-based bidding strategies within the German electricity market showcases our method's potential. By analyzing DRL bidding strategies of 118 competitive DRL agents with clustering approaches and DeepSHAP, we investigate the underlying factors driving agent decisions, contributing to the development of transparent ABMs.},
  keywords={Electric potential;Analytical models;Visualization;Electricity;Force;Europe;Electricity supply industry;Agent-based simulation;electricity markets;multi-agent deep reinforcement learning;explainable reinforcement learning},
  doi={10.1109/EEM60825.2024.10608907},
  ISSN={2165-4093},
  month={June},}@INPROCEEDINGS{11501442,
  author={Sun, Yushu and Li, Guoqing and Wang, Yimei and Zhu, Hongzhi and Zhu, Jintao and Li, Zhen},
  booktitle={14th International Conference on Renewable Power Generation (RPG 2025)}, 
  title={Short-term electricity price forecasting based on Fourier attention and exogenous variables}, 
  year={2025},
  volume={2025},
  number={},
  pages={1173-1179},
  abstract={Short-term electricity price forecasting (STEP) plays a pivotal role in ensuring the stability and economic efficiency of modern power markets, especially under conditions of high volatility and increasing renewable penetration. However, existing models fail to adequately capture extreme price spikes, hierarchical periodic structures, and the dynamic impact of exogenous variables. To overcome these challenges, we propose Fourier-EPNet, a novel deep learning framework that integrates frequency-domain attention with multimodal variable fusion. Specifically, it features: (i) a Fourier Softmax attention mechanism, which extracts dominant periodic signals while suppressing high-frequency noise; and (ii) an exogenous-endogenous cross-attention module, which dynamically aligns historical price trends with forward-looking external drivers such as load and wind forecasts. Extensive experiments on five benchmark datasets (NP, PJM, BE, FR, DE) from the EPF corpus show that Fourier-EPNet consistently surpasses state-of-the-art baselines, achieving 49.5% lower MSE and 40.4% lower MAE on average. Ablation studies and theoretical visualization further validate the contribution and interpretability of each component. Overall, Fourier-EPNet offers a robust, interpretable, and generalizable solution for real-world electricity price forecasting, setting a strong foundation for intelligent energy market decision-making.},
  keywords={},
  doi={10.1049/icp.2025.3983},
  ISSN={},
  month={Oct},}@ARTICLE{10103757,
  author={Smets, Ruben and Bruninx, Kenneth and Bottieau, Jérémie and Toubeau, Jean-François and Delarue, Erik},
  journal={IEEE Transactions on Energy Markets, Policy and Regulation}, 
  title={Strategic Implicit Balancing With Energy Storage Systems via Stochastic Model Predictive Control}, 
  year={2023},
  volume={1},
  number={4},
  pages={373-385},
  abstract={Battery Energy Storage Systems (BESS) may exploit the increasing price volatility in imbalance settlement mechanisms via inter-temporal arbitrage. However, participating in these markets requires a careful trade-off between expected profits, accounting for the impact of BESS actions on prevailing imbalance prices, the financial risks and the incurred battery degradation costs. This paper introduces a novel forecast-informed Model Predictive Control (MPC) methodology in which a strategic and potentially risk-averse BESS performs implicit balancing by taking out-of-balance positions in near-real time. Thereby it anticipates expected imbalance prices in a European-style balancing market, and takes into account state of charge-dependent battery degradation costs. To this end, an attention-based recurrent neural network forecasting technique is leveraged to predict the System Imbalance. The proposed methodology is tested on a real-life case study of the Belgian balancing market. Expected profits of a 2 MW/2 MWh BESS (21,784 €/MW/month) are shown to exceed those of different benchmarks available in the literature, including the profit associated with participating in the day-ahead energy market with perfect price foresight (7,082 €/MW/month). From a system perspective, these implicit balancing actions performed by the BESS owner reduce the system imbalance in 75% of all cases, thus improving the cost-efficiency of power systems.},
  keywords={Optimization;Europe;Degradation;Batteries;Stochastic processes;Battery energy storage system;Predictive control;Balancing markets;battery energy storage;forecast-informed optimization;model predictive control},
  doi={10.1109/TEMPR.2023.3267552},
  ISSN={2771-9626},
  month={Dec},}
