@INPROCEEDINGS{11330787,
  author={Singh, Aryan and Singh, Monisha and R, Lakshmi},
  booktitle={2025 4th International Conference on Applied Artificial Intelligence and Computing (ICAAIC)}, 
  title={Impact of Macroeconomic Integration in Hybrid GARCH-GRU Volatility Modelling on Nifty Bank}, 
  year={2025},
  volume={},
  number={},
  pages={406-411},
  abstract={In countries like India, where banking systems are closely tied to macroeconomic swings, being able to forecast volatility is critical for managing financial risk. Sudden changes in interest rates, exchange movements, or growth expectations can unsettle banks much faster than in mature markets. Econometric tools such as the Generalised Autoregressive Conditional Heteroskedasticity (GARCH) model remain popular because they capture volatility clustering well, but they fall short when the data exhibit nonlinear patterns. Neural networks-particularly Gated Recurrent Units (GRUs)-handle time-series dynamics more effectively, though they tend to miss traits specific to financial volatility. In this work, we put forward a hybrid GARCH-GRU framework that blends the traditional strengths of econometric models with the pattern-learning ability of neural networks, while also folding in key macroeconomic indicators. The framework is applied to the Nifty Bank index and draws on daily records spanning March 2010 to December 2022. Altogether, the dataset includes just over three thousand observations, covering more than a decade of varied market conditions. The framework uses a two-step design: conditional volatility from a GJR-GARCH(1,1) model is first estimated and then used as input, along with macroeconomic variables such as repo rates, exchange rates (USD/INR, CNY/INR, EUR/INR), oil prices, and GDP growth, for the GRU network. Our results indicate that the hybrid model performs noticeably better, cutting the Mean Absolute Error by about a quarter. The error falls from 0.000263 in the baseline GARCH model to 0.000199 under the hybrid design. Among the different factors considered, movements in exchange rates and changes in repo rates stand out most strongly, showing how these macroeconomic signals feed directly into risk management for Indian banks.},
  keywords={Exchange rates;Economic indicators;Computational modeling;Oils;Banking;Predictive models;Macroeconomics;Econometrics;Risk management;Forecasting;Banking sector volatility;Emerging markets;Financial risk management;GARCH models;GRU networks;Hybrid forecasting models;Macroeconomic indicators;Volatility prediction},
  doi={10.1109/ICAAIC64647.2025.11330787},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9600241,
  author={Ivanyuk, Vera and Shuvalov, Konstantin},
  booktitle={2021 14th International Conference Management of large-scale system development (MLSD)}, 
  title={Neural Network-Based Methods for Forecasting Financial Time Series}, 
  year={2021},
  volume={},
  number={},
  pages={1-4},
  abstract={The article discusses methods for predicting time series based on neural networks. Distinctive features of neural networks in forecasting are described. A case study with constructing a neural network-based forecast is considered.},
  keywords={Neural networks;Time series analysis;Tools;Conference management;Large-scale systems;Complexity theory;Forecasting;neural networks;forecasting;modelling},
  doi={10.1109/MLSD52249.2021.9600241},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11580851,
  author={Timokhin, Vladimir and Kolomytseva, Anna and Kolomytseva, Irina and Kharitonov, Anton and Aksenov, Alexander},
  booktitle={2026 IEEE Ural-Siberian Conference on Biomedical Engineering, Radioelectronics and Information Technology (USBEREIT)}, 
  title={NLP-Driven Machine Learning Model for Early Detection of Crude Oil Price Volatility}, 
  year={2026},
  volume={},
  number={},
  pages={1-4},
  abstract={The relevance of this study arises from the growing necessity to address complex challenges situated at the intersection of macroeconomics, computational linguistics, and financial engineering. Rapid fluctuations in global oil markets significantly impact economic stability, making an earlydetection tool for oil price volatility highly valuable. Such a system directly addresses the critical requirements of financial institutions seeking robust hedging and risk management strategies, energy corporations optimizing extraction and logistics planning, and regulatory bodies tasked with monitoring systemic market risks. The primary objective is to justify the selection of a machine learning model for forecasting short-term oil price movements based on news content analysis, using daily direction as an indicator for volatility signals. By leveraging large-scale financial news corpora and employing advanced natural language processing techniques, we extract sentiment indicators and thematic features correlated with market movements. Comprehensive experimental evaluations compare multiple algorithmic approaches, including traditional statistical baselines and contemporary deep learning frameworks. Experiments indicate that neural network models achieve the best in-sample performance for short-term oil price movement prediction, suggesting their potential to capture complex dependencies in textual data, subject to further timeseries validation. These findings confirm the efficacy of deep architectures in capturing non-linear relationships within unstructured textual data, ultimately providing a highly scalable framework for real-time market intelligence and strategic decision-making across global energy and financial sectors.},
  keywords={Modeling;Pricing;Lubricating oils;Oils;Neural networks;Forecasting;Machine learning;Printing;Filtering;Filters;oil price volatility;machine learning;natural language processing;neural networks;news sentiment analysis;financial forecasting;risk management;computational finance},
  doi={10.1109/USBEREIT70063.2026.11580851},
  ISSN={2769-3635},
  month={May},}@ARTICLE{11058928,
  author={Hosseini, Seyed Ali and Grimaccia, Francesco and Niccolai, Alessandro and Trimarchi, Silvia},
  journal={IEEE Access}, 
  title={Pattern-Based Feature Extraction for Improved Deep Learning in Financial Time Series Classification}, 
  year={2025},
  volume={13},
  number={},
  pages={113343-113355},
  abstract={In this paper, the authors introduce a novel feature extraction method based on pattern detection in financial data to enhance the performance of deep learning models for financial time series classification. Existing financial forecasting models often struggle with the inherent volatility and complexity of financial markets, particularly due to their reliance on traditional financial data features which fail to capture intricate price patterns. This research addresses the critical gap in effectively identifying and leveraging these patterns to improve predictive accuracy. By collecting tick-by-tick data from the European Carbon Emission Allowance market and resampling it to a 15-minute timeframe, we developed a method to detect pivotal price patterns and extract relevant features. Integrating these features with traditional open, high, low, close, and volume (OHLCV) data in long-short-term memory (LSTM) and gated recurrent unit (GRU) combined with dense neural networks, our empirical results demonstrate significant improvements in model performance, showcasing enhanced accuracy compared to models using only traditional data features.},
  keywords={Feature extraction;Forecasting;Predictive models;Long short term memory;Data models;Accuracy;Biological system modeling;Market research;Time series analysis;Deep learning;Energy market;financial pattern extraction;financial feature extraction;deep learning;financial data classification},
  doi={10.1109/ACCESS.2025.3584251},
  ISSN={2169-3536},
  month={},}@ARTICLE{11129948,
  author={Khan, Abdullah Al Ahad and Ullah, Md Habib and Tabassum, Ruchira and Kabir, Md Faisal},
  journal={IEEE Transactions on Industry Applications}, 
  title={Enhanced Transformer-BiLSTM Deep Learning Framework for Day-Ahead Energy Price Forecasting}, 
  year={2026},
  volume={62},
  number={2},
  pages={1933-1947},
  abstract={Accurate forecasting of energy prices is critical to effectively mitigate operational risks and make strategic bidding decisions in day-ahead (DA) electricity markets. However, it is highly challenging due to volatile characteristics, seasonality, rapid spikes, and other nonlinear factors of price signals. In the given context, deep learning (DL) has gained attention in recent years due to its high potential in nonlinear approximation, but each model has its strengths and limitations. Therefore, this paper proposes a hybrid DL approach for time-series DA energy price forecasting based on the Transformer and Bidirectional Long Short-Term Memory (BiLSTM) model that facilitates strategically combining various components to extract patterns and further improve the sequence processing task. The proposed model uses a transformer architecture to capture patterns, temporal dynamics, and BiLSTM networks to forecast energy price fluctuations. The proposed approach is validated with simulations based on price data from the New York Independent System Operator, and the results show that the proposed approach consistently outperforms state-of-the-art DL models, achieving the lowest MAE (2.7818 $/MWh), RMSE (6.4937 $/MWh), sMAPE (6.6060%), MAPE (6.3741%) and highest R$^{2}$ (0.9393). The effectiveness of the proposed approach was justified through various case studies from different perspectives.},
  keywords={Forecasting;Predictive models;Transformers;Bidirectional long short term memory;Load modeling;Data models;Accuracy;Deep learning;Feature extraction;Electricity supply industry;BiLSTM;day-ahead energy market;deep learning;energy price;time-series forecasting;and transformer model},
  doi={10.1109/TIA.2025.3599812},
  ISSN={1939-9367},
  month={March},}@INPROCEEDINGS{11681972,
  author={S, Nirmalganesh and Jidesh, P.},
  booktitle={2026 International Conference on Emerging Technologies in Computing and Communication (ETCC)}, 
  title={Crude Oil Price Forecasting Using Transformer and Recurrent Architectures for Improved Strategic and Operational Decisions}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Forecasting crude oil prices over 60 day horizons is important for decision making in energy industry and commodity markets. Industries that rely heavily on crude oil such as refineries can benefit significantly from improved 30 to 60 day price forecasting, as it directly affects their procurement strategies, inventory planning, and risk management. There are many studies focusing on crude oil price prediction but forecasting at horizons over 30 to 60 days remains challenging. This work analyses various AI models such as XGBoost, GRU, LSTM, their bidirectional variants along with transformer architecture, for forecasting crude oil prices across multiple horizons. The models use more than 150 input features, including macroeconomic indicators, technical indicators used by traders, related commodity prices, and several engineered features derived from these variables. Forecast performance is evaluated for horizons of 1, 7, 14, 21, 30, 45, and 60 days. The models are trained using historical price data starting from 1990 and evaluated on an outof-sample test period from 2020 to 2025, which includes COVID-19 oil price shock and other market volatility. The results show that model performance changes across forecasting horizons. For short horizons XGBoost and GRU have performed well. Bidirectional models and Transformer remain stable and perform well at higher horizons. The Directional accuracy of Transformer based model is highest among the models, reaching above 70% at the 60 day horizon (H60), which indicates the usefulness of attention-based architectures for crude oil forecasting over a medium to long term horizon.},
  keywords={Forecasting;Lubricating oils;Modeling;Oils;Pricing;Machine learning;Transformers;Printing;Accuracy;Long short term memory;Crude oil price forecasting;deep learning;LSTM;GRU;Transformer;XGBoost;multi-horizon prediction;refinery planning;directional accuracy;time series forecasting},
  doi={10.1109/ETCC69750.2026.11681972},
  ISSN={},
  month={July},}@INPROCEEDINGS{11042415,
  author={Arokiaraj, K. A. and Vikram, R. and Ragav, D. R. and Gokul, M.},
  booktitle={2025 2nd International Conference on Research Methodologies in Knowledge Management, Artificial Intelligence and Telecommunication Engineering (RMKMATE)}, 
  title={Machine Learning for Stock Market Volatility Prediction Using LSTM and XGBoost: An Indian Market Perspective}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The time series behavior of stock price patterns raises a significant challenge in financial analytics: stock market volatility forecasting. This paper proposes a hybrid LSTM-XGBoost model that utilizes the sequence learning capability of LSTM and the ensemble boosting method of XGBoost in its capability to efficiently predict stock market trends. The model incorporates technical indicators like Moving Averages, RSI and MACD as training inputs. The indicators are applied to historical stock prices obtained from the NSE and BSE, respectively. The proposed methodology attains an experimental rate of accuracy of 99.23%, surpassing the individual LSTM, CNN-LSTM, GRU, and XGBoost. The model produces lower RMSE (0.045) and lower MAPE (1.23%) than other systems. The efficiency of the hybrid model as a monetary prediction tool has been established by these outcomes, which have now allowed us to achieve sound investment plans and reduced risk.},
  keywords={Training;Accuracy;Time series analysis;Reinforcement learning;Predictive models;Boosting;Prediction algorithms;Stock markets;Forecasting;Long short term memory;Stock Market Prediction;LSTM;XGBoost;Hybrid Model;Time Series Forecasting;Financial Analytics},
  doi={10.1109/RMKMATE64874.2025.11042415},
  ISSN={},
  month={May},}@INPROCEEDINGS{11448908,
  author={Shiva, J and Reddy, A Srinish and Devadasu, G and Gulzar, M D and P.Ramya and K.Rohini},
  booktitle={2025 2nd International Conference on Recent Trends in Electrical, Electronics and Computing Technologies (ICRTEECT)}, 
  title={Investigating and Constructing an Advanced Nonlinear Deep Learning Model for Crude Oil Price Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Investigating and Building an Advanced Nonlinear Deep Learning Model for Crude Oil Price Prediction Introduction: Many economic, geopolitical, and commercial factors make predicting crude oil prices a difficult nonlinear process. Dealing with the intricate network patterns generated during oil price fluctuations, conventional econometrics mixed with statistical modeling techniques frequently fall short. This paper assesses the evolution of an improved nonlinear deep learning system meant to predict crude oil prices. By means of RNNs and LSTM networks, transformer-based systems allow computers to predict prices by accuracy and dependability. Best prediction outcomes are produced by full data processing along with attribute generation and parameter adjustment. By means of a model that analyzes past price patterns relating to macroeconomic performance elements and financial news emotional data, it may perform more accurately for improved market understanding. Using MAE and RMSE performance measures, this model is compared to statistical techniques and conventional machine learning models. Experimental data indicates that over market volatility evaluations and price movement, deep learning models constructed with non-linear structures outperform conventional analysis methods. The study shows good uses of artificial intelligence for energy economics that will generate better data-based decision structures over the oil market.},
  keywords={Deep learning;Computers;Analytical models;Accuracy;Oils;Computational modeling;Buildings;Predictive models;Data processing;Data models;Artificial intelligence;market forecasting;LSTM;nonlinear changing modeling;deep learning;crude oil price prediction},
  doi={10.1109/ICRTEECT67512.2025.11448908},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11004959,
  author={Mili, Mehdi and Alaali, Yusuf},
  booktitle={2024 International Conference on IT Innovation and Knowledge Discovery (ITIKD)}, 
  title={Oil Volatility Forecasting and Risk Management: A Hybrid Machine Learning Approach}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Volatility forecasting is an essential task for investors, speculators, and market practitioners. In finance, volatility is used in pricing options and financial derivatives, portfolio optimization, and risk management. Among the financial assets and commodities, crude oil ranks high in terms of economic development and investment purposes. However, the crude oil market is very complicated and fluctuates rapidly as many variables can influence the price of crude oil in different ways, such as global demand and supply, geopolitical risk factors, macroeconomic indicators, and the prices of other commodities such as gold and silver. The impact of such variables on crude oil prices could be indirect and non-linear. However, the literature until recently models crude oil volatility using statistical and econometric models which may not provide accurate forecasts due to the complexity of the market. In this research, to forecast crude oil volatility, the data of West Texas Intermediate (WTI) was collected over the period 2000 to 2023 from the Energy Information Administration (EIA) database, and an ensemble machine learning GJR-GARCH-SVR-LSTM model that is capable of recognizing patterns and complicated relationships between the variables was used. The findings of this research indicates that the used ensemble model provides better prediction accuracy than the existing models. Also, unlike the existing literature, another contribution of this study is that the proposed machine learning models were evaluated based on their hedging effectiveness by using the optimal hedge ratio, providing new hedging strategies to investors, crude oil producers, and other market participants.},
  keywords={Technological innovation;Silver;Accuracy;Oils;Biological system modeling;Machine learning;Predictive models;Macroeconomics;Risk management;Forecasting;crude oil volatility;forecasting;machine learning;GARCH;SVR;LSTM;ensemble model;risk management},
  doi={10.1109/ITIKD63574.2025.11004959},
  ISSN={},
  month={April},}@INPROCEEDINGS{10883369,
  author={Yannam, Adilakshmi and Matta, Nikitha and Kumar Dunga, Pradeep and Peddireddi, Srinivas and Vamsi Tadisetti, Leela and Naga Lakshmi Pandraju, Hari},
  booktitle={2025 6th International Conference on Mobile Computing and Sustainable Informatics (ICMCSI)}, 
  title={Impact of COVID-19 on Crude Oil Price Prediction: A Comparative Performance Analysis of LSTM and ANN Models}, 
  year={2025},
  volume={},
  number={},
  pages={1214-1220},
  abstract={Crude oil is a key component in the industrial production, and its price fluctuations often leads to economic instability. This research compares the performance of Artificial Neural Network (ANN) and Long Short-Term Memory (LSTM) models in predicting crude oil prices across pre-pandemic period (2010–2019) and post-pandemic (2020–2024) period. Analysis reveals that models performed strongly before COVID-19, with LSTM achieving higher accuracy (R-squared: 0.933) compared to ANN (R-squared: 0.912). However, during the pandemic period, both models showed decreased performance, with LSTM maintaining superior results (R-squared: 0.901) compared to ANN (R-squared: 0.865). Despite challenges in capturing extreme market volatility, both models demonstrate resilience, with LSTM consistently outperforming ANN due to its superior capability in handling temporal dependencies.},
  keywords={COVID-19;Analytical models;Pandemics;Biological system modeling;Oils;Decision making;Predictive models;Forecasting;Long short term memory;Resilience;Crude oil price prediction;Machine learning;Time series forecasting;Financial forecasting;Artificial Neural Network (ANN);Long Short-Term Memory (LSTM);Covid-19},
  doi={10.1109/ICMCSI64620.2025.10883369},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11050153,
  author={Zhang, Zhouhe and Hua, Haochen and Chen, Xingying and Shao, Jia and Zheng, Jin and Wang, Bo and Gan, Lei and Yu, Kun},
  booktitle={2025 21st International Conference on the European Energy Market (EEM)}, 
  title={Spot Market Electricity Price Forecast via the Combination of Transformer and Ornstein-Uhlenbeck Process}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Spot market electricity price fluctuations can expose market participants to substantial financial risks if not accurately forecasted. Traditional statistical models (e.g., ARIMA) can capture linear trends but struggle with complex nonlinear relationships, while pure neural network models (e.g., Transformer) are insufficiently sensitive to random fluctuations. To address both persistent price trends and transient volatility, this paper combines Transformer with stochastic differential equations driven by Ornstein-Uhlenbeck process. Compared to ARIMA, the proposed model achieves an average MAE reduction of approximately 45 %, along with comparable improvements in RMSE and MAPE and a significant boost in $\mathbf{R}^{\mathbf{2}}$. Against a standalone Transformer, it also exhibits substantial performance gains across all key metrics.},
  keywords={Fluctuations;Electricity;Stochastic processes;Differential equations;Predictive models;Transformers;Market research;Mathematical models;Numerical models;Forecasting;Transformer;stochastic differential equations;electricity price forecast;spot market},
  doi={10.1109/EEM64765.2025.11050153},
  ISSN={2165-4093},
  month={May},}@INPROCEEDINGS{11359805,
  author={Gamel, Samah A. and Sultan, Yara A.},
  booktitle={2025 26th International Middle East Power Systems Conference (MEPCON)}, 
  title={Hybrid LSTM-CNN Model for Forecasting Electricity Prices: A Comparative Study with Standalone CNN and LSTM Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={The electricity price forecasting is important in energy markets because it allows the energy market stakeholder to optimize the consumption level, minimize the cost, and the stability of the grid. This paper discusses the use of deep learning, such as Convolutional Neural Networks (CNNs), Long Short-Term Memory (LSTM) networks, and a Hybrid CNN-LSTM model, in electricity price prediction. The data set include time-series electricity price data and extraneous variables like the load of the system, temperature and CO2 intensity. The models are evaluated based on Root Mean Squared Error (RMSE), Mean Absolute Error (MAE) and Mean Absolute Percentage error (MAPE). Reports on our findings have revealed that CNN shows the lowest error values, but the Hybrid CNN-LSTM model has a balanced trade-off since it uses both spatial and temporal information resulting into more stable and predictive forecasts over time. The paper notes the usefulness of the hybrid deep learning structures when it comes to financial time-series prediction and proposes future research recommendations.},
  keywords={Deep learning;Accuracy;Electricity;Predictive models;Power system stability;Convolutional neural networks;Forecasting;Long short term memory;Thermal stability;Load modeling;Electricity Price Forecasting;Deep Learning;Convolutional Neural Networks (CNN);Long Short-Term Memory (LSTM);Hybrid CNN-LSTM},
  doi={10.1109/MEPCON66918.2026.11359805},
  ISSN={2573-3044},
  month={Dec},}@ARTICLE{10965651,
  author={Nasir, Jawaria and Aamir, Muhammad and Iftikhar, Soofia and Albidah, A. B. and Alqasem, Ohud A. and Elwahab, Maysaa E. A. and Khan, Ilyas and Koh, Wei Sin},
  journal={IEEE Access}, 
  title={A Novel Hybrid Approach to Forecasting Crude Oil Prices Using Local Mean Decomposition, ARIMA, and XGBoost}, 
  year={2025},
  volume={13},
  number={},
  pages={89140-89156},
  abstract={Crude oil in its usage and process brings about several issues that affect the environment including soiling of the air and water and the release of greenhouse gases leading to changes in the climate. Further, historically use of oil has created political and economic stakes that primarily end up in war, nationalism to control resources, and political instability. As a new approach to this problem in this study, we present a novel hybrid of Local Mean Decomposition (LMD) for breaking down the data and contribution coefficients for rebuilding the component with less computational complexity. Using the XGBOOST approach, deep dynamic learning features, augmented with autoregressive moving average (ARIMA), it is possible to predict each reconstructed segment. Turbulences that occur in the oil markets are random, the market shares are sensitive to pressures from other markets, the movement in the market is disorderly, and there is high volatility in the market. Thus, the price of oil is very unfixed, unpredictable, sensitive, and uncertain. Several techniques have been adopted in cost estimation in the aspect of time variation; some of the traditional methods include EMD, EEMD couldn’t solve the computational complexity and save time and cost. Because of the unpredictability and fluctuation observed in oil prices non deep neural network models and data mining cannot be used in the prediction of costs and generalized forecasting. The analysis of the onset of deep non-linear modeling as a part of the machine learning process demonstrates how the discussed hybrid model successfully acquires relevant data and adapts a non-stationary function. The data is modeled using an LMD-SD-ARIMA-XGBOOST hybrid recurrent network when the nonlinearity is considered, and the residual values are forwarded to the XGBOOST model. Besides the volatility problem, the solution provided by the work also addresses the overfitting problem of neural networks. The hybrid LMD-SD-ARIMA-XGBOOST model overcomes overfitting by combining statistical and machine learning components, where the decomposition process isolates key features of the data, reducing noise and complexity. Unlike standalone neural networks, which require large amounts of data to generalize effectively, our hybrid approach leverages ARIMA and XGBOOST models that are inherently less prone to overfitting due to their simpler structures and feature-focused learning. To validate the proposed hybrid approach, data from the West Texas Intermediate (WTI) which is publicly available is employed.},
  keywords={Biological system modeling;Predictive models;Oils;Data models;Forecasting;Time series analysis;Autoregressive processes;Computational modeling;Adaptation models;Accuracy;Hybrid renewable energy system;safe working environment;energy efficiency;ARIMA;crude oil prices;LMD;stochastic and deterministic influences;XGBOOST},
  doi={10.1109/ACCESS.2025.3561193},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11251848,
  author={Pal, Raman Kumar and Padhan, Chinmaya Ranjan and Panigrahi, Sibarama},
  booktitle={2025 IEEE 6th India Council International Subsections Conference (INDISCON)}, 
  title={Enhanced Crude Oil Price Forecasting with CEEMDAN-ARIMA Hybrid Model}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Fluctuations in crude oil prices (COP) have a very significant impact on global economies, energy policies, and financial markets. It is critical for stakeholders (policymakers, investors, and industries) to accurately predict COP to reduce risk and improve decision making. In order to identify important patterns and trends, this study breaks down daily, weekly, and monthly COP data into intrinsic mode functions (IMFs) using the Complete Ensemble Empirical Mode Decomposition with Adaptive Noise (CEEMDAN) approach. The decomposed components are examined using a variety of deep learning, machine learning, and statistical techniques, including linear regression, ridge regression, ElasticNet, Huber regression, and random forest, as well as neural networks such as long short-term memory (LSTM), gated recurrent unit (GRU), and statistical models such as auto-regressive integrated moving average (ARIMA), generalized autoregressive conditional heteroskedasticity (GARCH). Model performance is evaluated using different deterministic accuracy metrics. Among the models tested, the CEEMDANARIMA demonstrates superior accuracy and robustness across all evaluation criteria. The findings underscore the effectiveness of CEEMDAN-based decomposition combined with ARIMA for precise prediction of COP, providing valuable insights for strategic decision making in energy markets.},
  keywords={Measurement;Accuracy;Biological system modeling;Oils;Decision making;Noise;Linear regression;Predictive models;Forecasting;Long short term memory;Auto Regressive Integrated Moving Average;Complete Ensemble Empirical Mode Decomposition with Adaptive Noise;Crude oil price forecasting;Decomposition},
  doi={10.1109/INDISCON66021.2025.11251848},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{9418313,
  author={Reddy Beeram, Satyanarayana and Kuchibhotla, Swarna},
  booktitle={2021 5th International Conference on Computing Methodologies and Communication (ICCMC)}, 
  title={A Survey on state-of-the-art Financial Time Series Prediction Models}, 
  year={2021},
  volume={},
  number={},
  pages={596-604},
  abstract={Designing of a sophisticated financial time series prediction model helps in resolving many real world problems like stock market predictions, exchange value forecasting and oil price prediction etc. In general, the time series data values are non-linear and chaotic in nature. Time series data values cannot record the steady growth and their frequent rises and falls makes it more inconsistent. Forecasting the next value of the dataset criterion variable is more dependent on several aspects like predictor attributes, correlations, trends, seasonal variance etc. Many farmer researches concentrated on time series predictions and proposed several ways to predict the future values based on their historical data. This paper describes the prominent time series prediction models like random walks, ARIMA, ANN and SVR with detailed information. Description of these prediction models and the detailed comparison of them helps to choose the appropriate model for real-time applications.},
  keywords={Correlation;Computational modeling;Oils;Time series analysis;Predictive models;Market research;Real-time systems;Time series prediction models;random walks;ARIMA;ANNs;SVR},
  doi={10.1109/ICCMC51019.2021.9418313},
  ISSN={},
  month={April},}@INPROCEEDINGS{11577032,
  author={Kaur, Harinder and Kaur, Sarabjit and Sharma, Atipriya and Shelke, Nilesh},
  booktitle={2026 International Conference on Connected Intelligence for Industrial Applications (CI2A)}, 
  title={Quantum-Inspired Support Vector Regression with Deep Learning for Gold Price Forecasting}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Gold price prediction plays important role for making financial decisions for investors, policymakers and economists. However a manual prediction of the gold prices is difficult due to its dependency on various economic factors. The traditional machine learning models are not able to find the complex relationships among data. To address this problem, this paper has proposed Quantum-Inspired Support Vector Regression (QI-SVR). This technique combines the SVT model quantum based optimization process. This quantum model is able to handle nonlinear patterns. The experiments are performed on dataset which includes factors like gold prices, the USD index, crude oil prices, silver prices, and the S&P index. The performance of proposed technique is compared with existing techniques such as ARIMS, LSTM and other hybrid models. The experimental results shows that the proposed QI-SVR is effective with R2 score of 0.971, RMSE of 22.34, and MAPE of 2.11%. Further, this study shows that quantum-inspired learning can be an effective and efficient way to forecast financial time series.},
  keywords={Modeling;Pricing;Gold;Long short term memory;Forecasting;Kernel;Vectors;Printing;Support vector machines;Machine learning;Gold Price Prediction;Quantum-Inspired Machine Learning;Support Vector Regression (SVR);Financial Forecasting;Time Series Analysis;Hybrid Optimization},
  doi={10.1109/CI2A69097.2026.11577032},
  ISSN={},
  month={April},}@INPROCEEDINGS{11447134,
  author={Li, Kunjian and Chen, Qichun},
  booktitle={2025 2nd International Seminar on Artificial Intelligence, Computer Technology and Control Engineering (ACTCE)}, 
  title={Ensemble Deep Learning for Small-Sample Time Series Forecasting}, 
  year={2025},
  volume={},
  number={},
  pages={388-394},
  abstract={This paper investigates the efficacy of ensemble deep learning architectures for time series forecasting in small-sample settings, with a focus on regional energy markets. Traditional forecasting methods often falter in scenarios with limited data availability and high volatility, underscoring the need for more robust and adaptive approaches. We propose and benchmark a series of hybrid models across multiple performance metrics. Our empirical analysis, using daily trading records from two regional emissions exchanges as a proxy for energy market behavior, demonstrates that attention-enhanced and residual-learning-based ensembles significantly outperform baseline models in both accuracy and directional reliability. These findings highlight the potential of ensemble architectures to improve prediction robustness in low-data, high-uncertainty forecasting environments.},
  keywords={Deep learning;Adaptation models;Accuracy;Attention mechanisms;Uncertainty;Biological system modeling;Time series analysis;Robustness;Ensemble learning;Forecasting;ensemble learning;time series forecasting;small-sample analysis;deep learning},
  doi={10.1109/ACTCE66599.2025.00079},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11380074,
  author={Nandeshwar, Tushar Babulal and Sharma, Akanksha and Gupta, Abhinav and Verma, Chandan Kumar},
  booktitle={2025 International Conference on Electronics and Computing, Communication Networking Automation Technologies (ICEC2NT)}, 
  title={Wavelet-Enhanced Blending Ensemble of CNN, LSTM, and GRU for Crude Oil Futures Price Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Crude oil futures price prediction is an essential tool for risk management, energy planning, and financial market analysis. The volatile, non-linear nature of crude oil prices poses significant challenges for traditional models, which often fail to capture the complex temporal dependencies and noise inherent in commodity markets. This research proposes a robust ensemble framework to improve the precision and stability of crude oil price prediction. This approach integrates three distinct architectures-CNN, LSTM, and GRU-using a blending strategy with a linear regression-based meta-learner. To improve signal quality and model efficiency, the discrete wavelet transform (DWT) is employed for denoising, and Pearson correlation coefficient is used to select the most informative technical indicators. Model performance is evaluated using RMSE, MAE, $R^{2}$ score, Max Error, and Directional Accuracy Ratio (DAR). Experimental results show the ensemble consistently outperforms individual models across all metrics. Statistical validation using the DieboldMariano test confirms the ensemble's superiority. The framework improves predictive accuracy while enhancing robustness and generalization, offering a scalable solution for real-world financial forecasting.},
  keywords={Accuracy;Oils;Noise reduction;Transforms;Power system stability;Stability analysis;Robustness;Discrete wavelet transforms;Risk management;Long short term memory;Crude Oil Futures;Wavelet Denoising;Deep learning;Blending Ensemble Technique;Grid Search;Feature Selection},
  doi={10.1109/ICEC2NT65402.2025.11380074},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10762084,
  author={Liao, Rongzhou and Ye, Siqi},
  booktitle={2024 International Conference on Intelligent Computing and Data Mining (ICDM)}, 
  title={Research on Electricity Price Prediction Technology Based on Mode Decomposition and Deep Learning}, 
  year={2024},
  volume={},
  number={},
  pages={21-26},
  abstract={Electricity price forecasting is crucial in energy markets and grid management, where accurate electricity price forecasting can optimize energy production and allocation, guide market transactions, and reduce operating costs. However, the volatility and complexity of electricity prices make it difficult for traditional statistical methods and some machine learning methods to achieve high-precision prediction. To address this challenge, this paper proposes an innovative electricity price forecasting model called the VMD-Transformer model. This model combines variational mode decomposition (VMD) and a Transformer-based deep learning architecture, which decomposes complex electricity price time series data into multiple intrinsic mode functions (IMFs) through VMD, thereby extracting multi-scale features. Subsequently, using a Transformer-based deep learning model, long-distance dependencies across modes and complex temporal patterns are effectively captured through the multi-head self-attention mechanism. Experimental results show that the VMD-Transformer model outperforms existing models on multiple electricity price datasets. Further analysis and case studies demonstrate that the model exhibits higher prediction accuracy and stability during periods of severe electricity price fluctuations. The VMD-Transformer model provides an effective new method for electricity price forecasting, significantly improving prediction performance and offering strong support for energy market participants and grid operators.},
  keywords={Accuracy;Electricity;Time series analysis;Predictive models;Power system stability;Transformers;Data models;Stability analysis;Resource management;Forecasting;Deep Learning;Transformer;Electricity Price;Variational Mode Decomposition},
  doi={10.1109/ICDM63232.2024.10762084},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{8551811,
