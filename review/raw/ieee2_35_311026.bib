  booktitle={2023 IEEE 11th Joint International Information Technology and Artificial Intelligence Conference (ITAIC)}, 
  title={Multi-Step Rubber Price Prediction Using Deep Learning Models with External Factors}, 
  year={2023},
  volume={11},
  number={},
  pages={1125-1129},
  abstract={The Thai rubber market plays a vital role in the nation's economy, holding a prominent position as one of the world's leading producers and exporters of natural rubber. It frequently faces challenges, including price volatility, driven by complex global supply and demand dynamics and numerous influencing factors. This study aimed to enhance multi-step price prediction models for ribbed smoked rubber sheets (RSS) through the application of advanced deep learning techniques. Various recurrent neural network architectures were examined, and the impact of incorporating external factors into the analysis was thoroughly assessed. The results demonstrated that multistep gated recurrent units coupled with top principal components of external features based on principal component analysis delivered superior performance, achieving an average RMSE of 3.54 and an average MAPE of 4.46% across 7-step predictions. A precise price estimation for key rubber products, including RSS, could enable informed decision-making for all stakeholders throughout the entire supply chain.},
  keywords={Deep learning;Biological system modeling;Time series analysis;Supply chains;Predictive models;Rubber;Stakeholders;Rubber price prediction;multivariate time series forecasting;recurrent neural networks;multi-step prediction;LSTM;GRU},
  doi={10.1109/ITAIC58329.2023.10408839},
  ISSN={2693-2865},
  month={Dec},}@INPROCEEDINGS{11171150,
  author={Reddy, P. Venkateswarlu and Ganesh, D. and Reddy Gaddam, Sasidhar and Swarna Lalitha, Chukka and Muqthadar Ali, Syed and Sakibaev, Kyialbek},
  booktitle={2025 5th International Conference on Soft Computing for Security Applications (ICSCSA)}, 
  title={Empirical Assessment of Profit Predicting Deep Learning Methods}, 
  year={2025},
  volume={},
  number={},
  pages={1674-1679},
  abstract={The major problem with the establishment of income in these days’ jobholders is that there is no single formula that can be used for all of them. In calculating the pay of every employee, varying elements include duties, experience level, and special abilities. A further issue is that it may be very expensive to live in the country, thus making it difficult to pay people from different backgrounds appropriately. The third problems are the different types of benefits and incentives provided by different firms, which may not be easy to have exact salaries comparison between all categories. Lastly, often there are external factors that are able to influence the payments to the employees, like the costs of health insurance or the condition of the local economy, where employees live. To ensure that workers are paid fairly for their labor and that all exchange is at par with the market, it is important to know how much to pay the employees in terms of their income. To ensure the company can plan for payment of salaries, advantages, and other amounts related to recruiting and retaining workers, it is also prudent to know the employees’ income. We have developed a design based on the other LSTM models to cope with the problems. In this paper, the voting procedure is used for comparing a variety of methods of deep learning designed for predicting revenue. ConvLSTM, B LSTM, and Stacked LSTM architectures are used to predict income using Long Short-Term Memory. The Socio-Economic data set, which describes the monthly income over 26 years, is used for simulation processing. It is revealed in this study that deep learning methods have applications in income prediction.},
  keywords={Deep learning;Costs;Biological system modeling;Insurance;Computer architecture;Companies;Remuneration;Security;Socioeconomics;Long short term memory;Employee compensation;ConvLSTM;Fair pay;Stacked LSTM},
  doi={10.1109/ICSCSA66339.2025.11171150},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{9006195,
  author={Tang, Yuanyuan and Wang, Qingmei and Xu, Wei and Wang, Mingming and Wang, Zhaowei},
  booktitle={2019 IEEE International Conference on Big Data (Big Data)}, 
  title={Natural Gas Price Prediction with Big Data}, 
  year={2019},
  volume={},
  number={},
  pages={5326-5330},
  abstract={In recent decades, commodities have attracted the attention of a large number of investors and financial professionals, and their prices have become very important for investors and policy makers. Although natural gas is widely used as a clean energy, there is less literature on price research and most of them use historical prices and fundamental factors to analyze natural gas price. Based on historical prices, this paper analyzes whether internet search data and news sentiment can improve forecasting ability, and compare which can achieve better prediction results. The experimental results show that both internet search and news sentiment contain additional information to improve the prediction effect, and internet search data can achieve better prediction results.},
  keywords={Natural gas;Predictive models;Oils;Biological system modeling;Google;Forecasting;Market research;natural gas;price prediction;internet search;news sentiment;deep learning},
  doi={10.1109/BigData47090.2019.9006195},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8554642,
  author={Chaitanya Lahari, M and Ravi, Dhakate Hardik and Bharathi, R},
  booktitle={2018 International Conference on Advances in Computing, Communications and Informatics (ICACCI)}, 
  title={Fuel Price Prediction Using RNN}, 
  year={2018},
  volume={},
  number={},
  pages={1510-1514},
  abstract={The fuel market has its impact directly or indirectly on the income distribution of nations affecting stock market, cost of living, education, essential commodities and many more. Likewise, in reciprocation the fuel prices are affected by numerous factors that in-turn find way into the common mans' routine. Thus, there is a clear necessity to forecast the fuel price trends not just for the motorists good, but for the economists of any nation to predict the economic trends due to these price fluctuations and to be in a state of preparedness. However, forecasting the fuel prices involves stochastic model involving regressive analysis of several variables with many hidden relationships between them. Recurrent Neural Networks determines the underlying rationale for non-linearity by analyzing the hidden relationships between the contributing factors. Hence this project employs a Recurrent Neural network model to forecast the non-linearly varying fuel prices in major metropolitan cities of India.},
  keywords={Fuels;Support vector machines;Recurrent neural networks;Market research;Urban areas;Predictive models;Atmospheric modeling;Petrol;Diesel;Price forecast;Recurrent Neural Networks;Fuel Price India},
  doi={10.1109/ICACCI.2018.8554642},
  ISSN={},
  month={Sep.},}@ARTICLE{11122531,
  author={Wang, Xiang and Wang, Hao and Wang, Zirong and Wu, Di and Xue, Yuan and Ye, Lingxiao and Zhang, Yucong},
  journal={IEEE Access}, 
  title={A Hybrid PLO-Transformer-CEEMDAN Model for Natural Gas Price Forecasting}, 
  year={2025},
  volume={13},
  number={},
  pages={143489-143508},
  abstract={To address the nonlinear and non-stationary characteristics of natural gas prices, this study proposes a hybrid PLO-Transformer-CEEMDAN forecasting framework. The model integrates weight optimization, multi-scale trend extraction, and residual correction, effectively utilizing 27 heterogeneous features—including Google Trends indicators—to improve predictive accuracy. Empirical evaluations on Henry Hub monthly data (2004–2024) show that the model achieves exceptional forecasting performance (RMSE: 0.0257, R2: 0.9998), representing a 92.87% RMSE reduction compared to the baseline Transformer. Notably, incorporating Google Trends alone leads to a 30.91% improvement in accuracy, underscoring its value in capturing market sentiment prior to price changes. Overall, the proposed method significantly outperforms conventional benchmarks in both predictive precision and generalization ability, offering a robust tool for energy price forecasting and market risk assessment.},
  keywords={Predictive models;Forecasting;Transformers;Natural gas;Adaptation models;Accuracy;Market research;Optimization;Transformer cores;Data models;Energy market;natural gas price forecasting;PLO;residual series modeling;transformer},
  doi={10.1109/ACCESS.2025.3597657},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11203773,
  author={Khan, Inam Ullah and Jamil, Mohsin},
  booktitle={2025 IEEE 13th International Conference on Smart Energy Grid Engineering (SEGE)}, 
  title={Hybrid Long Short-Term Memory (LSTM) and Exponentially Weighted Moving Average (EWMA) Model for Accurate and Scalable Electricity Price Forecasting}, 
  year={2025},
  volume={},
  number={},
  pages={107-111},
  abstract={Accurate electricity price forecasting is critical for market participants seeking to optimize bids and manage risk in increasingly volatile energy markets. This paper proposes a hybrid machine learning framework that integrates Long ShortTerm Memory (LSTM) networks with Exponentially Weighted Moving Average (EWMA) volatility smoothing. The framework optimizes bid strategy formulation for Battery Energy Storage System (BESS) operators in electricity markets, thereby enhancing market participation efficiency. The model was trained and validated on historical Austrian market data including wholesale electricity price, frequency containment reserve price, electrical load, gas price, radiation, temperature, and wind speed. This approach directly supports more informed decision-making for local traders and operators. Model training was accomplished through 64,500 iterations over 6.1 hours, utilizing a variable learning rate and MATLAB’s Deep Learning Toolbox to accelerate convergence. The computational process was executed on a dedicated Intel Core i9-14900HX/NVIDIA RTX 4060 platform, demonstrating that the approach is both scalable and suitable for real-time deployment scenarios with intra-day retraining requirements. The hybrid model achieves a root mean square error (RMSE) of 1.2207 €/MWhe, outperforming several established benchmarks while providing year-forward price forecasts with hourly resolution.},
  keywords={Training;Accuracy;Battery energy storage system;Electricity;Computational modeling;Predictive models;Mathematical models;Forecasting;Long short term memory;Load modeling;Electricity;Energy;Commodity Pricing;Forecasting;Finance;Battery Energy Storage System (BESS);Optimization;Operations Research;Smart Grid;Artificial Intelligence;Volatility},
  doi={10.1109/SEGE65970.2025.11203773},
  ISSN={2575-2693},
  month={Aug},}@INPROCEEDINGS{11404855,
  author={Behera, Sudersan and Hemasri, Sukhavasi and Shravani, Yerraginnela and Madupu, Sreenivas and N, Sasikumar A and Ramesh, M.},
  booktitle={2025 13th International Conference on Intelligent Systems and Embedded Design (ISED)}, 
  title={Training PSNN using Improved GA for Enhanced Closing Price Prediction of Natural Gas and Crude Oil}, 
  year={2025},
  volume={},
  number={},
  pages={962-967},
  abstract={The intrinsic dynamic nonlinearity of the data makes financial time series forecasting problematic. To solve this problem, the current study suggests a PSNN-IGA hybrid framework, which integrates an Improved Genetic Algorithm (IGA) with a HONN known as PSNN. The goal of testing the model’s predictive capability is to anticipate one-day-ahead values of two major financial commodities, crude oil and natural gas. We use MAPE and MSE, two measures of accuracy, to evaluate the success of our forecasts. Under the same experimental settings, the PSNN-IGA is compared to multiple baseline models, such as PSNN-GA, PSNN-DE, PSNN-FFA, and PSNN-GD. In all commodities, PSNN-IGA consistently scored the lowest MAPE and MSE values, proving that it is effective at controlling uncertainty and capturing the complex patterns found in financial time series. Further validation of these findings was done using the Diebold-Mariano (DM) test, which statistically showed that PSNN-IGA’s predictive accuracy is significantly superior to the baseline models, in addition to standard error-based measures. This two-pronged validation, which employs performance measures in addition to statistical testing, strongly supports the model’s capacity to produce trustworthy and precise predictions in unpredictable energy markets.},
  keywords={Accuracy;Statistical analysis;Oils;Time series analysis;Neural networks;Predictive models;Forecasting;Natural gas;Standards;Genetic algorithms;Improved GA;PSNN;Crude oil;Natural gas;FTS},
  doi={10.1109/ISED67359.2025.11404855},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10895930,
  author={Dash, Anupa Sekhar and Mishra, Ujjwal},
  booktitle={2024 IEEE Pune Section International Conference (PuneCon)}, 
  title={Application of NLU based Sentiment Analysis in the Hybrid Stock Price Forecasting Model using Deep Learning Model}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={For any developing market, like the Indian stock market, creating a stock market forecasting model is difficult. The reason being investor behavior on economic factors like changes in the western stock market, variations in the price of commodities on the international market, war-related escalations, and central bank actions influence the stock prices in emerging stock markets and less work on prior studies to consider investor behaviors based on several economic elements that affect price movement. To address this issue, a hybrid forecasting model is developed that uses Deep Learning algorithms through a multivariate Long Short-Term Memory (LSTM) model to predict future open and close prices by combining sentiment analysis data of economic information along with historical prices. The findings indicate that sentiment analysis data on economic information has an impact on stock price movement. The proposed model achieved better results in terms of coefficient for the determinant (R2) and a Mean Absolute Percentage Error (MAPE) for the predicted result. The study findings can be used in future studies of other markets and asset classes where investor opinion toward certain events may have an impact on price fluctuations.},
  keywords={Economics;Analytical models;Sentiment analysis;Predictive models;Market research;Data models;Indexes;Stock markets;Forecasting;Long short term memory;Stock Market;Deep Learning;LSTM;Sentiment Analysis;NLU},
  doi={10.1109/PuneCon63413.2024.10895930},
  ISSN={2831-5022},
  month={Dec},}@INPROCEEDINGS{9271504,
  author={Tikhonov, E.E. and Chebanov, K.A. and Burlyaeva, V.A.},
  booktitle={2020 International Multi-Conference on Industrial Engineering and Modern Technologies (FarEastCon)}, 
  title={Development of Forecasting Theory and Methods for Developing Forecasts in Electroenergetics}, 
  year={2020},
  volume={},
  number={},
  pages={1-5},
  abstract={The article discusses several fundamental problems in forecasting problems that form the scientific novelty of the research. One of the problems is formulated as the need to determine the key parameters that form the basis of the forecasting model and allow determining the state of the subject area. The next key problem in the literature is formulated as the “curse of dimensionality”. Occurs when the researcher tries to take into account the maximum number of indicators and criteria for evaluating the subject area in the model, and this leads to the fact that the computer model required for its solution approaches the “Turing limit”. The third problem is described in the literature as the problem of “supersystem”. All elements of the predicted system or process can form higher-level systems that have their own unique properties. This makes it fundamentally impossible to describe a super-system mapping of target functions from the point of view of the systems and processes that make up the super-system. To develop the theory of forecasting and overcome these problems, we propose the use of such sections of modern mathematics as neuromathematics and deep machine learning, chaos theory, catastrophe theory, and the theory of self-organizing systems. It is believed that these methods will increase the depth of the forecast by identifying hidden patterns and relationships among poorly formalized conventional methods of predictive indicators.},
  keywords={Forecasting;Predictive models;Analytical models;Computational modeling;Neural networks;Econometrics;Time series analysis;forecasts;neural networks;machine learning;catastrophe theory},
  doi={10.1109/FarEastCon50210.2020.9271504},
  ISSN={},
  month={Oct},}@ARTICLE{10026315,
  author={Ke, Huang and Zuominyang, Zhang and Qiumei, Li and Yin, Luo},
  journal={IEEE Access}, 
  title={Predicting Chinese Commodity Futures Price: An EEMD-Hurst-LSTM Hybrid Approach}, 
  year={2023},
  volume={11},
  number={},
  pages={14841-14858},
  abstract={This paper proposes an EEMD-Hurst-LSTM prediction method based on the ensemble learning framework, which is applied to the prediction of typical commodities in China’s commodity futures market. This method performs ensemble empirical mode decomposition (EEMD) on commodity futures prices, and incorporates the components obtained by EEMD decomposition and the adaptive fractal Hurst index calculated by using intraday high-frequency data as new features into the LSTM model to decompose its correlation with the external market to detect changes in market conditions. The results show that the EEMD-Hurst-LSTM method has better predictive performance compared to other horizontal single models and longitudinal deep learning combined models. Meanwhile, the trading strategy designed according to this ensemble model can obtain more returns than other trading strategies and have the best risk control level. The research of this paper provides important implications for the trend following of commodity markets and the investment risk management of statistical arbitrage strategies.},
  keywords={Predictive models;Deep learning;Time-frequency analysis;Neural networks;Ensemble learning;Data mining;Adaptation models;Commodity futures price;ensemble learning;ensemble empirical mode decomposition;combination forecasting;deep learning;machine learning},
  doi={10.1109/ACCESS.2023.3239924},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10609104,
  author={Kock, Robin and Kaheh, Zohreh and Shafie-Khah, Miadreza},
  booktitle={2024 International Symposium on Power Electronics, Electrical Drives, Automation and Motion (SPEEDAM)}, 
  title={Developing Two RNN-Based Algorithms for Electricity Price Forecasting in Markets with High Penetration of Renewable Energy Resources}, 
  year={2024},
  volume={},
  number={},
  pages={1266-1270},
  abstract={Precisely predicting electricity prices can greatly benefit various participants in the energy market. This is a challenging endeavor due to the inherent volatility of electricity prices. Studies have shown that as renewable energy generation increases, electricity markets and prices tend to become more unpredictable. To tackle this problem effectively, different ML-based algorithms have been presented. This paper proposes two novel electricity price forecasting algorithms based on Recurrent Neural Networks-Long Short-Term Memory (RNN-LSTM) and Recurrent Neural Networks-Gated Recurrent Unit (RNN-GRU). Two algorithms perform well in terms of MAE and RMSE scores, indicating their suitability for electricity price forecasting tasks. These results align with similar research findings and highlight their effectiveness.},
  keywords={Renewable energy sources;Recurrent neural networks;Automation;Electricity;Prediction algorithms;Electricity supply industry;Power electronics;Electricity Price Forecasting;Machine Learning;Long Short-Term Memory;Gated Recurrent Unit},
  doi={10.1109/SPEEDAM61530.2024.10609104},
  ISSN={2835-8457},
  month={June},}@ARTICLE{9738619,
  author={Akşehir, Zinnet Duygu and Kiliç, Erdal},
  journal={IEEE Access}, 
  title={How to Handle Data Imbalance and Feature Selection Problems in CNN-Based Stock Price Forecasting}, 
  year={2022},
  volume={10},
  number={},
  pages={31297-31305},
  abstract={Stock market forecasting is a time series problem that aims to predict possible future prices or directions of an index/stock. The stock data contains high uncertainty and is influenced by too many factors; hence it isn’t easy to achieve the goal by traditional time series methods. In literature, the convolutional neural networks (CNN) models were used for stock market forecasting and gave successful results. But, data imbalance due to labeling and feature selection problems were seen when considering these models. Hence, this study proposed a new rule-based labeling algorithm and a new feature selection approach to solve the issues. In addition, a CNN-based model, which was presented to predict the next day’s trade action of stocks in the Dow30 index, was constructed to check the effectiveness of the data labeling and the feature selection approach. Different image-based input variable sets were created using technical indicators, gold, and oil price data to feed the CNN model. The prediction performance of CNN models was compared with other studies in the literature. The experimental results showed that the CNN prediction model, which uses the proposed feature selection and labeling approaches in this study, performs 3-22% higher accuracy than the CNN-based models taking part in other studies. Also, the labeling approach proposed is more successful than Chen and Huang’s data weighting approach to solve the stock data imbalance problem. This algorithm reduced the ratio between labeled data from 15 times to 1.8 times.},
  keywords={Predictive models;Labeling;Data models;Convolutional neural networks;Biological system modeling;Stock markets;Forecasting;CNN model;feature selection;labeling;stock prediction},
  doi={10.1109/ACCESS.2022.3160797},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11385720,
  author={Kumar, Suresh and Kumar, Pardeep and Sidhu, Renu and Kumari, Neha and Kaur, Swapandeep and Singh, Kawal Nain},
  booktitle={2025 International Conference on Innovations and Emerging Technologies In AI & Communication Systems (IETACS)}, 
  title={Empirical Analysis of AI Methods of Forecasting financial Times Series: A Research on LSTM and ML models in Indian Stock, Commodity and Energy Prices}, 
  year={2025},
  volume={},
  number={},
  pages={800-805},
  abstract={The present paper provides an empirical analysis of the methods of Artificial Intelligence (AI) predicting the financial time series data in the Indian context, namely the use of Long Short-Term Memory (LSTM) neural network, Random Forest Regression, and Support Vector Machines (SVM). There are four main variables of the study that are the NIFTY 50 stock index, the historical gold price, the price of crude oil and the price of natural gas which represent important sectors of the Indian economy. The paper demonstrates that the AI models outperform the conventional econometric models (such as ARIMA and Ordinary Least Squares (OLS) regression), significantly in terms of accuracy of predictions, sensitivity to volatility, and the ability to fit non-linearity in the actions of variables. LSTM reduced the Root Mean Square Error (RMSE) by more than 50 percent in stock market forecasts when compared to ARIMA and the machine learning model improved the prediction performance of credit default by 17 percent compared to the logistic regression model. This research uses a mixed methods design, an Integrative survey, blending model-based performance evaluation with the qualitative contributions of 100 stakeholders in the Indian financial institutions, fintech affiliates, and regulatory authority. These findings reveal a wide optimism in terms of AI to enhance risk management and make the operations more efficient and also highlight the consistent concerns about data protection, clean governance and institutional readiness. The paper concludes by calling on the urgency of explainable AI systems (XAI), effective regulatory strategies, and industry synergies so that ethically and sustainably AI should be applied in the financial sector of forecasting, particularly in the emerging economies, such as India.},
  keywords={Support vector machines;Surveys;Explainable AI;Biological system modeling;Time series analysis;Neural networks;Predictive models;Forecasting;Stock markets;Long short term memory;Artificial Intelligence;Financial forecasting;Machine Learning;Time Series;LSTM Neural Networks},
  doi={10.1109/IETACS68750.2025.11385720},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11467951,
  author={Reynafarje, Santiago Pomar and Parra, Wilber Encarnacion and Alarcon, Jymmy Stuwart Dextre},
  booktitle={2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)}, 
  title={Predictive Model for the Price of Gold Using Machine Learning}, 
  year={2026},
  volume={},
  number={},
  pages={01-08},
  abstract={The prediction of gold prices represents a significant challenge for sectors such as mining and finance, especially in emerging economies like Peru. Traditional models show limitations in the face of high market volatility and the presence of multiple influential variables, as they fail to capture nonlinear relationships and respond effectively to abrupt changes in the economic environment. In response to this issue, this study proposes a predictive model based on the XGBoost algorithm, using macroeconomic variables such as the dollar index, interest rates, oil prices, the Standard & Poor's 500 (S&P 500) index, and others related to international markets. The methodology was structured in four phases: dataset selection, algorithm training, evaluation using regression metrics, and temporal validation. The model was trained with historical data and validated with recent records to simulate real-world conditions. The results obtained in Experiment 2 indicate high predictive capacity, with a Mean Absolute Error (MAE) of 18.90 USD, Root Mean Squared Error (RMSE) of 23.45 USD, and a Coefficient of Determination ($\mathbf{R}^{\mathbf{2}}$) of 0.92. Compared to the manual approach evaluated in Experiment 1, the model achieved a 29.6 % improvement in predictive accuracy, a 93% reduction in response time, and a 29% increase in user satisfaction, establishing itself as an effective tool to support strategic decision-making in environments sensitive to gold price fluctuations.},
  keywords={Feedback;Circuits;Protocols;HTTP;Amplitude shift keying;Amplitude modulation;Artificial intelligence;Artificial neural networks;Machine learning;Predictive models;Gold Price;Machine Learning;Predictive Model;Price Prediction},
  doi={10.1109/ACDSA67686.2026.11467951},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11691680,
  author={Fitriana, Pingkan Mayosi and Halim, Zairihan Abdul and Salih, Safia and Ernawan, Ferda},
  booktitle={2026 IEEE 1st International Conference on Artificial Intelligence Implementation & Applications (ICAIIA)}, 
  title={The Causal Impact of COVID-19 on G20 Stock Markets Using LSTM Counterfactual Forecasting}, 
  year={2026},
  volume={},
  number={},
  pages={202-207},
  abstract={The COVID-19 pandemic has significant implications to the financial stability and stock market value. Researchers have examined the pandemic effects using econometric models, this approach struggles to capture the nonlinear dynamics, structural breaks, and extreme volatility associated with pandemic periods. This paper utilized deep learning techniques to model complex time-series under unprecedented shocks. This paper proposed a Long Short-Term Memory (LSTM) neural network for time-series prediction to predict and calculate causal inference for G20 countries from 1 January 2018 to 30 December 2020. The analytical framework incorporates pandemic-related variables: daily confirmed cases (DCC), daily death cases (DDC), and the stringency index (SINDEX), macroeconomic indicators such as exchange rate (ER), interest rate (BOND), volatility index (VIX), gold price (GOLD), and oil price (OIL). The experiments also evaluate the important features for each model by using SHapley Additive exPlanations (SHAP). The results show that the LSTM model achieved a high predictive accuracy for all G20 countries. The causal analyses reveal heterogeneous pandemic effects across G20 markets, with significant negative impacts observed in France, the United Kingdom, and Indonesia, while most developed markets demonstrated stronger resilience. The proposed LSTM model achieved consistently strong performance across most countries, with MAPE values ranging from 2.07% to 5.84%.},
  keywords={Modeling;Long short term memory;Stock markets;COVID-19;Pandemics;Forecasting;Printing;Indexes;Indexing;Equations;COVID-19;deep learning;stock market prediction;LSTM},
  doi={10.1109/ICAIIA70172.2026.11691680},
  ISSN={},
  month={Sep.},}@ARTICLE{11568424,
  author={Almeman, Khalid},
  journal={IEEE Access}, 
  title={Sector-Level Benchmarking of Deep Learning Architectures for Predicting Saudi Stock Market}, 
  year={2026},
  volume={14},
  number={},
  pages={90963-90978},
  abstract={Accurate prediction of stock market behavior is one of the most common intractable problems in financial data science. In this study, we performed a large-scale comparison of three learning architectures, namely, Long Short-Term Memory (LSTM) Networks, gated recurrent units (GRUs), and a hybrid convolutional neural network with GRU (CNN-GRU). They were applied to the full historical data of the Saudi stock market (Tadawul), which covers the period from December 31, 2001, to August 3, 2025. The dataset contains over 910,000 rows for 279 listed companies and models were trained to predict the daily closing prices using a 30-day sliding window of key trading features such as opening price, high, low, traded volume, total traded value, and closing price. Model performances on the training and test data were analyzed using the root mean square error (RMSE) and the mean absolute error (MAE) and the results were aggregated by company and economic sector. Among the three architectures, GRU achieved the highest firm-level win rate (143 of 258 companies), while CNN–GRU recorded the lowest aggregate RMSE (2.465 vs. 2.575 for GRU), reflecting its stronger performance on high-volatility firms; LSTM trailed both with 38 firm-level wins. The sector-level analysis also revealed differences in model dominance, indicating that sectoral volatility and feature patterns may affect which model is the most appropriate. Altogether, this study provides an empirical basis for AI-driven decision support systems in Gulf financial markets and methodological guidance for the benchmarking of large-scale models.},
  keywords={Modeling;Pricing;Long short term memory;Forecasting;Testing;International trade;Stock markets;Timing;Companies;Machine learning;Deep learning;machine learning;sector analysis;stock price prediction;Tadawul;time-series forecasting},
  doi={10.1109/ACCESS.2026.3704368},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9492201,
  author={Lai, Shanyan and Jiang, Hongyu and Ye, Chunyang and Zhou, Hui},
  booktitle={2021 International Conference on Service Science (ICSS)}, 
  title={Chinese stock market prediction based on multifeature fusion and TextCNN}, 
  year={2021},
  volume={},
  number={},
  pages={59-64},
  abstract={Stock trend forecasting plays a great role in maximizing the profit of stock investment. However, due to the high volatility and non-stationarity of the stock market, accurate trend prediction is very difficult. With the development of the Internet and deep learning technology, people can use deep learning methods to reveal market trends and volatility from the explosive information on the Internet. Unfortunately, there is a large amount of content related to the stock market, and a large part of it is useless information. As a result, how to extract the effective information and combine this information as different characteristics to effectively predict stock trends has become the biggest challenge. In order to cope with these challenges, we use TextCNN as the news text feature extractor for feature extraction of news information, and propose a prediction method based on multi-feature fusion: Bi-LSTNAA, to predict the Chinese stock market. Extensive experiments on actual stock market data show that the our method has a greater improvement in the accuracy of stock trend prediction.},
  keywords={Deep learning;Predictive models;Feature extraction;Market research;Explosives;Internet;Data mining;Stock trend forecast;feature fusion;News feature extraction},
  doi={10.1109/ICSS53362.2021.00017},
  ISSN={},
  month={May},}@INPROCEEDINGS{11198108,
  author={Peng, Hao and Zhou, Jingfeng and Li, Zhihong and Ksibi, Albaraa and Xu, Xiaoying and Zhang, Qinxue},
  booktitle={2025 21st International Conference on Natural Computation, Fuzzy Systems and Knowledge Discovery (ICNC-FSKD)}, 
  title={Aviation Refueling Strategies Based on Neural Networks and Optimization Algorithms}, 
  year={2025},
  volume={},
  number={},
  pages={160-170},
  abstract={Aviation fuel costs account for 30% ~ 40% of total airline operating expenses. Therefore, optimizing refueling strategies to reduce fuel consumption and costs is crucial. Traditional fuel consumption optimization methods often struggle with complex flight networks and poor adaptability to dynamic environments. This study proposes an intelligent aviation fuel optimization system based on neural networks and optimization algorithms, combining deep neural networks, polynomial regression, and gradient optimization algorithms to improve the accuracy of fuel consumption prediction and optimize refueling strategies. The system builds a fuel consumption prediction model using historical data and meteorological information, and applies polynomial regression to reduce computational complexity. The optimization process, based on gradient descent methods, refines refueling plans while meeting safety constraints. The optimization objective can be configured to minimize either fuel costs or consumption. The system supports dynamic fuel price input and adjusts strategies based on real-time fuel prices and supply conditions. It enhances prediction accuracy and flexibility, automatically adjusts to price fluctuations, and improves operational efficiency and economic benefits for airlines.},
  keywords={Costs;Accuracy;Heuristic algorithms;Prediction algorithms;Polynomials;Systems support;Safety;Fuels;Optimization;Airline industry;aviation fuel consumption;neural networks;deep reinforcement learning;optimal refueling strategy},
  doi={10.1109/ICNC-FSKD67701.2025.11198108},
  ISSN={},
  month={July},}@INPROCEEDINGS{11048313,
  author={Rafi, Md Samuru and N, Siddharth and K, Hrushikesh Raju and Sidhwa, H. H.},
  booktitle={2025 International Conference on Recent Advances in Electrical, Electronics, Ubiquitous Communication, and Computational Intelligence (RAEEUCCI)}, 
  title={AI-Driven Currency Arbitrage Optimization System and Correlation Risk Using Statistical Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The increasing complexity of global financial markets and their need for advanced techniques for currency arbitrage and risk assessment. This research delivers an AI-based currency arbitrage optimizer which implements XGBoost and LSTM models for USD/INR and USD/JPY and JPY/INR currency markets prediction. The system utilizes Bellman-Ford, which is a Garch(1,1) model to find profitable currency arbitrage opportunities from forecasted values while the Bellman-Ford algorithm creates trade routes using linear programming and risk evaluation relies on Sharpe Ratio and Monte Carlo Simulation. The evaluation of volatility spillover effects between two oil-based economies relies on statistical techniques which include GARCH modeling for performing correlation risk analysis. The evaluation of our experimental approach performed using historical forex data from twenty years revealed enhanced accuracy in forecasts while generating better risk-adjusted returns.},
  keywords={Analytical models;Exchange rates;Correlation;Accuracy;Biological system modeling;Predictive models;Linear programming;Risk management;Currencies;Long short term memory;Arbitrage;Exchange rate;LSTM;XGBoost;Linear programming;Bellman-ford;Correlation risk;GARCH;Volatility;Risk Assessment;statistics;Market anomalies},
  doi={10.1109/RAEEUCCI63961.2025.11048313},
  ISSN={},
  month={April},}@INPROCEEDINGS{11180640,
  author={Sanchez, Fabien and Mohamed, Ahmed and Rigo-Mariani, Rémy and Debusschere, Vincent},
  booktitle={2025 IEEE Kiel PowerTech}, 
  title={Supervised Learning for the Bidding of Grid-Connected Batteries in the Day-Ahead Market}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper discusses the implementation of supervised learning (SL) as a straightforward data-driven technique to compute the day-ahead bids of grid-connected battery energy systems (BESS) participating in energy markets. The objective is to implicitly account for price uncertainty in the BESS schedule before assessing the economic performance. The case study is a 10 MW BESS battery participating in the day-ahead market. Physic-Informed and more traditional loss functions and a large set of tuning parameters are compared based on the generated daily revenues. Either the power injected by the BESS or its state of charge is controlled, illustrating a compromise to find between the accuracy and the resilience of the results, once confronted with the high volatility of energy prices. The performance of AI-based controllers is assessed in terms of precision with a theoretical optimum obtained with a "perfect forecast". A reference bidding strategy using "backcasting" as a forecast is also considered. Simulation over the year 2021 with an hourly training data set of the energy prices of 2020 shows that SL models do not necessarily perform better than reference results (with a minimal error of 58 %). However, discussions about their tuning and design choices shed light on the complex implementation process of the selected case study.},
  keywords={Training;Schedules;Uncertainty;Battery energy storage system;Supervised learning;Training data;Batteries;State of charge;Tuning;Resilience;Machine Learning;Supervised Training;Battery storage system;Day-Ahead market;data analysis},
  doi={10.1109/PowerTech59965.2025.11180640},
  ISSN={},
  month={June},}
