main = "alpha(u) + beta(u)", xlab = x_lab, ylab = "Persistencia total")
abline(h = 1, lty = 2, col = "gray40")
dev.off()
plot(x_axis, res_train$c_t, type = "l", lwd = 1.6, col = "black",
main = "c(u) - Intercepto", xlab = x_lab, ylab = "c(u)")
plot(x_axis, res_train$alpha_t, type = "l", lwd = 1.6, col = "black",
main = "alpha(u) - Reacción ARCH", xlab = x_lab, ylab = "alpha(u)")
plot(x_axis, res_train$beta_t, type = "l", lwd = 1.6, col = "black",
main = "beta(u) - Persistencia GARCH", xlab = x_lab, ylab = "beta(u)")
plot(x_axis, res_train$alpha_t + res_train$beta_t, type = "l", lwd = 1.6, col = "black",
main = "alpha(u) + beta(u)", xlab = x_lab, ylab = "Persistencia total")
dev.off()
par(mfrow = c(2, 2), mar = c(4, 4, 2.5, 1), family = "sans", bty = "o")
u_grid <- df_tv_params$u
x_axis <- if ("date" %in% names(df_train)) df_train$date else u_grid
x_lab  <- if ("date" %in% names(df_train)) "Date" else "u = t / T"
plot(x_axis, res_train$c_t, type = "l", lwd = 1.6, col = "black",
main = "c(u) - Intercepto", xlab = x_lab, ylab = "c(u)")
