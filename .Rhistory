# SECTION 1: Paths and Data Loading ------------------
data_dir <- file.path(getwd(), "data", "processed")
out_dir  <- file.path(getwd(), "results", "TVGARCH")
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
df_train <- arrow::read_parquet(file.path(data_dir, "brent_train.parquet"))
df_test  <- arrow::read_parquet(file.path(data_dir, "brent_test.parquet"))
if ("date" %in% names(df_train)) {
df_train$date <- as.POSIXct(df_train$date, tz = "UTC")
df_train <- df_train[order(df_train$date), ]
}
if ("date" %in% names(df_test)) {
df_test$date <- as.POSIXct(df_test$date, tz = "UTC")
df_test <- df_test[order(df_test$date), ]
}
y_train  <- as.numeric(df_train$log_returns)
rs_train <- as.numeric(df_train$rs_daily)
y_test   <- as.numeric(df_test$log_returns)
rs_test  <- as.numeric(df_test$rs_daily)
stopifnot(
length(y_train) > 0, length(y_test) > 0,
!anyNA(y_train), !anyNA(rs_train),
!anyNA(y_test), !anyNA(rs_test)
)
cat(sprintf("Train: %d obs | Test: %d obs\n", length(y_train), length(y_test)))
# SECTION 2: Helper Functions for TV-GARCH(1,1) KF ------------------
# Scale returns by 100 for numerical stability; divide variance by 10000 (100^2)
SCALE_RET <- 100.0
SCALE_VAR <- 10000.0
eval_poly_tv <- function(coef_vec, u) {
out <- rep(0.0, length(u))
for (k in seq_along(coef_vec)) {
out <- out + coef_vec[k] * (u^(k - 1L))
}
out
}
fit_tvgarch_kf_1step <- function(y_ret, c_init, alpha_init, beta_init, type_spec) {
y_sc <- y_ret * SCALE_RET
n_obs <- length(y_sc)
fit_obj <- tvGarchKalmanFit(
data      = y_sc,
c         = c_init,
alpha     = alpha_init,
beta      = beta_init,
type      = type_spec,
predict   = 1L,
trace.log = FALSE
)
# Extract estimated coefficients and conditional variance (length n_obs + 1)
cf <- as.numeric(if (isS4(fit_obj)) fit_obj@coef else fit_obj$coef)
sigma2_sc <- as.numeric(if (isS4(fit_obj)) fit_obj@sigma2 else fit_obj$sigma2)
# Optional call to tvGarchKalmanPrint if available with matching arguments
if (exists("tvGarchKalmanPrint", where = "package:tvGarchKF", mode = "function")) {
print_args <- names(formals(tvGarchKalmanPrint))
if ("data" %in% print_args && "fit" %in% print_args) {
prt_obj <- tryCatch(
tvGarchKalmanPrint(
fit     = fit_obj,
data    = y_sc,
c       = c_init,
alpha   = alpha_init,
beta    = beta_init,
type    = type_spec,
predict = 1L
),
error = function(e) NULL
)
if (!is.null(prt_obj) && !is.null(prt_obj$sigma)) {
sigma2_sc <- as.numeric(prt_obj$sigma)
}
}
}
nc <- length(c_init)
na <- length(alpha_init)
nb <- length(beta_init)
stopifnot(length(cf) >= nc + na + nb, length(sigma2_sc) >= n_obs + 1L)
u <- seq_len(n_obs) / n_obs
c_t     <- eval_poly_tv(cf[seq_len(nc)], u)
alpha_t <- eval_poly_tv(cf[nc + seq_len(na)], u)
beta_t  <- eval_poly_tv(cf[nc + na + seq_len(nb)], u)
sigma2_orig <- sigma2_sc / SCALE_VAR
list(
fit          = fit_obj,
coef         = cf,
c_t          = c_t,
alpha_t      = alpha_t,
beta_t       = beta_t,
var_insample = sigma2_orig[seq_len(n_obs)],
var_next_1   = sigma2_orig[n_obs + 1L]
)
}
# SECTION 3: In-Sample Fit and Time-Varying Parameters ------------------
c_init     <- c(0.05, 0.01)
alpha_init <- c(0.10, 0.02)
beta_init  <- c(0.85, -0.02)
type_spec  <- c("polynomial", "polynomial", "polynomial")
res_train <- fit_tvgarch_kf_1step(
y_ret      = y_train,
c_init     = c_init,
alpha_init = alpha_init,
beta_init  = beta_init,
type_spec  = type_spec
)
print(res_train$fit)
cat(sprintf("Initial 1-step-ahead variance forecast: %.8f\n", res_train$var_next_1))
cat("Summary of alpha(u) + beta(u):\n")
print(summary(res_train$alpha_t + res_train$beta_t))
df_tv_params <- data.frame(
idx          = seq_along(y_train),
u            = seq_along(y_train) / length(y_train),
c_hat        = res_train$c_t,
alpha_hat    = res_train$alpha_t,
beta_hat     = res_train$beta_t,
persist_sum  = res_train$alpha_t + res_train$beta_t,
var_insample = res_train$var_insample,
rs_daily     = rs_train
)
# SECTION 4: Expanding Walk-Forward Out-of-Sample Forecast ------------------
n_tr <- length(y_train)
n_te <- length(y_test)
var_fcst <- numeric(n_te)
for (h in seq_len(n_te)) {
y_window <- c(y_train, if (h > 1L) y_test[seq_len(h - 1L)] else numeric(0))
step_res <- tryCatch(
fit_tvgarch_kf_1step(
y_ret      = y_window,
c_init     = c_init,
alpha_init = alpha_init,
beta_init  = beta_init,
type_spec  = type_spec
),
error = function(e) {
warning(sprintf("Step %d failed (%s); falling back to previous forecast.", h, conditionMessage(e)))
NULL
}
)
if (!is.null(step_res) && is.finite(step_res$var_next_1) && step_res$var_next_1 > 0) {
var_fcst[h] <- step_res$var_next_1
} else {
var_fcst[h] <- if (h == 1L) res_train$var_next_1 else var_fcst[h - 1L]
}
}
# SECTION 3B: Print Explicit Equations and Plot c(u), alpha(u), beta(u) ------------------
