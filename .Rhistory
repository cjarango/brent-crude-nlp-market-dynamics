# SECTION: Grid Search over Functional Forms in tvGarchKF ------------------
eval_curve_tv <- function(coef_vec, u, ftype, trig_fn = "cos", freq_mult = 1) {
if (ftype == "polynomial") {
out <- rep(0.0, length(u))
for (k in seq_along(coef_vec)) {
out <- out + coef_vec[k] * (u^(k - 1L))
}
return(out)
}
if (ftype == "trigonometric") {
# coef_vec[1] + coef_vec[2]*cos(2*pi*u) + coef_vec[3]*sin(2*pi*u) ...
out <- rep(coef_vec[1], length(u))
if (length(coef_vec) >= 2L) {
fn <- if (trig_fn == "sin") sin else cos
out <- out + coef_vec[2] * fn(2 * pi * freq_mult * u)
}
if (length(coef_vec) >= 3L) {
out <- out + coef_vec[3] * sin(2 * pi * freq_mult * u)
}
return(out)
}
stop("Unsupported ftype: ", ftype)
}
# Grilla de especificaciones candidatas
specs <- list(
poly_deg1 = list(
c = c(0.05, 0.01), alpha = c(0.10, 0.02), beta = c(0.85, -0.02),
type = c("polynomial", "polynomial", "polynomial"), trig = NULL, arg = NULL
),
poly_deg2 = list(
c = c(0.05, 0.01, 0.00), alpha = c(0.10, 0.02, 0.00), beta = c(0.85, -0.02, 0.00),
type = c("polynomial", "polynomial", "polynomial"), trig = NULL, arg = NULL
),
poly_deg3 = list(
c = c(0.05, 0.01, 0.00, 0.00), alpha = c(0.10, 0.02, 0.00, 0.00), beta = c(0.85, -0.02, 0.00, 0.00),
type = c("polynomial", "polynomial", "polynomial"), trig = NULL, arg = NULL
),
trig_cos1 = list(
c = c(0.05, 0.01), alpha = c(0.10, 0.02), beta = c(0.85, -0.02),
type = c("trigonometric", "trigonometric", "trigonometric"), trig = "cos", arg = "2*pi*u"
),
# Mixta: c(u) y alpha(u) cuadráticos, beta(u) lineal
poly_mixed_221 = list(
c = c(0.05, 0.01, 0.00), alpha = c(0.10, 0.02, 0.00), beta = c(0.85, -0.02),
type = c("polynomial", "polynomial", "polynomial"), trig = NULL, arg = NULL
)
)
# División interna de validación (80% sub-train / 20% val)
n_total <- length(y_train)
n_sub   <- floor(0.80 * n_total)
y_sub   <- y_train[1:n_sub] * 100.0
rs_val  <- rs_train[(n_sub + 1):n_total]
y_val   <- y_train[(n_sub + 1):n_total] * 100.0
results_grid <- lapply(names(specs), function(sp_name) {
sp <- specs[[sp_name]]
fit <- tryCatch(
tvGarchKalmanFit(
data      = y_sub,
c         = sp$c,
alpha     = sp$alpha,
beta      = sp$beta,
type      = sp$type,
trig      = sp$trig,
arg       = sp$arg,
predict   = 1L,
trace.log = FALSE
),
error = function(e) NULL
)
if (is.null(fit)) {
return(data.frame(spec = sp_name, valid = FALSE, loglik = NA, aic = NA, max_ab = NA, val_mse = NA))
}
cf <- as.numeric(if (isS4(fit)) fit@coef else fit$coef)
ll <- as.numeric(if (isS4(fit)) fit@loglik else fit$loglik)
k_params <- length(cf)
aic_val  <- -2 * ll + 2 * k_params
# Evaluar trayectorias en u in (0, 1]
u <- seq_len(n_sub) / n_sub
nc <- length(sp$c); na <- length(sp$alpha); nb <- length(sp$beta)
c_t <- eval_curve_tv(cf[1:nc], u, sp$type[1])
a_t <- eval_curve_tv(cf[(nc + 1):(nc + na)], u, sp$type[2])
b_t <- eval_curve_tv(cf[(nc + na + 1):(nc + na + nb)], u, sp$type[3])
is_valid <- all(is.finite(c_t), is.finite(a_t), is.finite(b_t)) &&
all(c_t > 0) && all(a_t >= 0) && all(b_t >= 0) &&
all((a_t + b_t) < 0.999)
# Evaluar error en validación pasando toda la serie con los parámetros fijados
# o usando el pronóstico filtrado sobre el bloque de validación
sig_all <- as.numeric(if (isS4(fit)) fit@sigma2 else fit$sigma2) / 10000.0
# Proxy rápido de error en última ventana de ajuste vs rs_train
in_mse <- mean((rs_train[1:n_sub] - sig_all[1:n_sub])^2, na.rm = TRUE)
data.frame(
spec     = sp_name,
k_params = k_params,
valid    = is_valid,
loglik   = ll,
aic      = aic_val,
max_ab   = max(a_t + b_t),
in_mse   = in_mse
)
})
df_tuning <- df_tuning[order(-df_tuning$valid, df_tuning$aic), ]
df_tuning <- do.call(rbind, results_grid)
df_tuning <- df_tuning[order(-df_tuning$valid, df_tuning$aic), ]
print(df_tuning)
results_grid
