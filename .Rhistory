plot(x_axis, res_train$c_t, type = "l", lwd = 1.6, col = "black",
main = "c(u) - Intercepto", xlab = x_lab, ylab = "c(u)")
plot(x_axis, res_train$alpha_t, type = "l", lwd = 1.6, col = "black",
main = "alpha(u) - Reacción ARCH", xlab = x_lab, ylab = "alpha(u)")
