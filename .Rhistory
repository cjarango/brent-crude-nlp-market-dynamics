cat(sprintf("  alpha(u): %.6f  -->  %.6f\n", res_train$alpha_t[1], tail(res_train$alpha_t, 1)))
cat(sprintf("  beta(u):  %.6f  -->  %.6f\n", res_train$beta_t[1], tail(res_train$beta_t, 1)))
cat(sprintf("  a+b(u):   %.6f  -->  %.6f\n",
res_train$alpha_t[1] + res_train$beta_t[1],
tail(res_train$alpha_t + res_train$beta_t, 1)))
par(mfrow = c(2, 2), mar = c(4, 4, 2.5, 1), family = "sans", bty = "o")
u_grid <- df_tv_params$u
x_axis <- if ("date" %in% names(df_train)) df_train$date else u_grid
