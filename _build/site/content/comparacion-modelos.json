hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03785em;\">δ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">+</span><span class=\"mord\">0.02</span></span></span></span>","key":"Go3exRnWB5"},{"type":"text","value":", lo que indica una ligera tendencia a mayor pérdida relativa respecto a TCN con tamaños de efecto reducidos en términos de magnitud del delta de Cliff. Entre Causal Transformer y Band Causal TCN aparece un punto negro (DM no significativo, intervalo al 95 % que incluye el cero), por lo que no se encuentra evidencia de una diferencia estadísticamente significativa entre ambos.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Kb3bqoXiKI"}],"key":"qUS7NJZ06y"}],"key":"LiXQ2zMILt"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"dm_results = ts.diebold_mariano_test(\n    y_true=y_true_test,\n    preds_matrix=preds_matrix,\n    model_names=models_loaded,\n    metric=\"qlike\",\n    alpha=0.05,\n    n_bootstrap=2000,\n    seed=SEED,\n)\n\ncliff_results = ts.cliffs_delta(\n    y_true=y_true_test,\n    preds_matrix=preds_matrix,\n    model_names=models_loaded,\n    metric=\"qlike\",\n)\n\nts.plot_cliffs_dm_heatmap(\n    cliff_results=cliff_results,\n    dm_results=dm_results,\n    model_order=models_loaded,\n    title=\"Delta de Cliff por Pares (Referencia DM — QLIKE)\",\n    fmt=\"svg\",\n)","visibility":"hide","key":"TRcXXCi64A"},{"type":"outputs","id":"FGtbqAiFyaIiSQDYfk6pL","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content_type":"text/html","hash